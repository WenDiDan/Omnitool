page {
    background-color: #f8f8f8;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  }
  
  .container {
    padding: 20rpx;
    min-height: 100vh;
  }
  
  .btn-primary {
    background-color: #007aff;
    color: white;
    border-radius: 12rpx;
    padding: 24rpx;
    text-align: center;
    font-size: 32rpx;
    font-weight: 500;
  }
  
  .btn-primary:active {
    background-color: #0056b3;
  }
  
  .card {
    background-color: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }
  
  .text-primary {
    color: #007aff;
  }
  
  .text-secondary {
    color: #666666;
  }
  
  .text-muted {
    color: #999999;
    font-size: 24rpx;
  }
  
  .divider {
    height: 1rpx;
    background-color: #e5e5e5;
    margin: 20rpx 0;
  }
  
  .flex-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  
  .flex-column {
    display: flex;
    flex-direction: column;
  }
  
  .flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .flex-center {
    display: flex;
    justify-content: center;
    align-items: center;
  }