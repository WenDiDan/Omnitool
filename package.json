{
  "name": "xuexi-barcode-scanner",
  "version": "1.0.0",
  "description": "工具箱 - 多合一小程序的单元测试",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose",
    "check": "node scripts/final-check.js",
    "verify": "node scripts/verify-refs.js",
    "sync:cloud": "node scripts/sync-cloud-shared.js",
    "build:admin": "npm --prefix admin-web run build"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/miniprogram_npm/"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "!utils/image-decoder.js",
      "!utils/canvas-decoder.js",
      "!utils/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.17.0"
  }
}
