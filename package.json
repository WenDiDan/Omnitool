{
  "name": "xuexi-barcode-scanner",
  "version": "1.0.0",
  "description": "工具箱 - 多合一小程序的单元测试",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "!utils/image-decoder.js",
      "!utils/canvas-decoder.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.17.0"
  }
}
