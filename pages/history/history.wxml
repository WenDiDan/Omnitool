<view class="container">
  <!-- 头部 -->
  <view class="history-header">
    <view class="header-left">
      <text class="title">扫描历史</text>
      <text class="title-count" wx:if="{{historyList.length > 0}}">{{historyList.length}} 条记录</text>
    </view>
    <view class="header-right" wx:if="{{historyList.length > 0}}">
      <view class="clear-btn" bindtap="clearHistory">
        <text>清空</text>
      </view>
    </view>
  </view>
  
  <!-- 空状态 -->
  <view wx:if="{{historyList.length === 0}}" class="empty-state">
    <view class="empty-icon-wrap">
      <image class="empty-icon" src="/images/icon_empty.png" mode="aspectFit"/>
    </view>
    <text class="empty-text">暂无扫描记录</text>
    <text class="empty-hint">开始扫码，记录将自动保存</text>
    <view class="empty-btn" bindtap="goToScan">
      <text>去扫码</text>
    </view>
  </view>
  
  <!-- 历史列表 -->
  <view wx:else class="history-list">
    <view class="history-item" wx:for="{{historyList}}" wx:key="index" bindtap="viewDetail" data-code="{{item.code}}">
      <view class="item-left">
        <view class="item-type-tag type-{{item.type}}">
          <text>{{item.type}}</text>
        </view>
      </view>
      <view class="item-center">
        <text class="item-code">{{item.code}}</text>
        <text class="item-time">{{item.time}}</text>
      </view>
      <view class="item-right">
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>
</view>
