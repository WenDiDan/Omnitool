<view class="container">
  <view class="history-header flex-between">
    <text class="title">扫描历史</text>
    <button class="clear-btn" bindtap="clearHistory" wx:if="{{historyList.length > 0}}">清空</button>
  </view>
  
  <view wx:if="{{historyList.length === 0}}" class="empty-state">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无扫描记录</text>
    <button class="btn-primary" bindtap="goToScan">去扫码</button>
  </view>
  
  <view wx:else>
    <view class="history-item" wx:for="{{historyList}}" wx:key="index" bindtap="viewDetail" data-code="{{item.code}}">
      <view class="item-info">
        <text class="item-code">{{item.code}}</text>
        <view class="item-meta">
          <text class="item-type">{{item.type}}</text>
          <text class="item-time">{{item.time}}</text>
        </view>
      </view>
      <text class="item-arrow">›</text>
    </view>
  </view>
</view>