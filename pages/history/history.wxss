.history-header {
    margin-bottom: 30rpx;
  }
  
  .title {
    font-size: 36rpx;
    font-weight: bold;
    color: #0D1B2A;
  }
  
  .clear-btn {
    background: none;
    color: #E07A5F;
    font-size: 28rpx;
    padding: 0;
    margin: 0;
    line-height: normal;
  }
  
  .clear-btn::after {
    border: none;
  }
  
  .empty-state {
    text-align: center;
    padding: 120rpx 0;
  }
  
  .empty-icon {
    width: 120rpx;
    height: 120rpx;
    display: block;
    margin: 0 auto 30rpx;
  }
  
  .empty-text {
    font-size: 28rpx;
    color: #999;
    display: block;
    margin-bottom: 60rpx;
  }
  
  .history-item {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2rpx 16rpx rgba(13,27,42,0.05);
  }
  
  .item-info {
    flex: 1;
  }
  
  .item-code {
    display: block;
    font-size: 28rpx;
    color: #0D1B2A;
    margin-bottom: 12rpx;
    word-break: break-all;
  }
  
  .item-meta {
    display: flex;
    align-items: center;
  }
  
  .item-type {
    font-size: 22rpx;
    color: #3D8B7A;
    background: #EFF5F3;
    padding: 4rpx 12rpx;
    border-radius: 20rpx;
    margin-right: 16rpx;
  }
  
  .item-time {
    font-size: 22rpx;
    color: #999;
  }
  
  .item-arrow {
    font-size: 40rpx;
    color: #C8C4B8;
    margin-left: 20rpx;
  }
