<view class="regcode-page">
  <!-- 权限检查中 -->
  <view class="permission-block" wx:if="{{permissionChecking}}">
    <view class="permission-loading"></view>
    <text class="permission-loading-text">验证权限中...</text>
  </view>

  <!-- 无权限 -->
  <view class="permission-block" wx:if="{{!permissionChecking && !hasPermission}}">
    <view class="permission-icon-wrap">
      <text class="permission-lock-text">VIP</text>
    </view>
    <text class="permission-title">VIP 专属功能</text>
    <text class="permission-desc">注册码功能仅限 VIP 用户和管理员使用</text>
    <view class="permission-btn" bindtap="goBack">返回</view>
  </view>

  <!-- 有权限 -->
  <view wx:if="{{!permissionChecking && hasPermission}}">
  <!-- 模式切换 -->
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'generate' ? 'tab-active' : ''}}" bindtap="switchMode" data-mode="generate">
      <text>生成注册码</text>
    </view>
    <view class="mode-tab {{mode === 'parse' ? 'tab-active' : ''}}" bindtap="switchMode" data-mode="parse">
      <text>解析注册码</text>
    </view>
  </view>

  <!-- ========== 生成模式 ========== -->
  <view wx:if="{{mode === 'generate'}}">
    <view class="input-section">
      <!-- 设备编码 -->
      <view class="input-group">
        <text class="input-label">设备编码</text>
        <view class="input-row">
          <input class="input-field" type="number" placeholder="请输入至少4位数字" value="{{deviceCode}}" bindinput="onDeviceCodeInput" maxlength="20"/>
          <view class="input-clear" wx:if="{{deviceCode}}" bindtap="clearDeviceCode">
            <image class="clear-icon" src="/images/ui_close.png" mode="aspectFit"/>
          </view>
        </view>
        <text class="input-hint" wx:if="{{deviceCodeError}}">{{deviceCodeError}}</text>
      </view>

      <!-- 日期选择 -->
      <view class="input-group">
        <text class="input-label">日期</text>
        <view class="date-row">
          <picker mode="date" value="{{dateStr}}" bindchange="onDateChange">
            <view class="date-picker">
              <text class="date-text">{{dateStr || '请选择日期'}}</text>
              <image class="date-icon" src="/images/ui_info.png" mode="aspectFit"/>
            </view>
          </picker>
          <view class="date-today" bindtap="setToday">今天</view>
        </view>
      </view>

      <!-- 生成按钮 -->
      <view class="generate-btn" bindtap="generate">
        <image class="gen-icon" src="/images/nav_scan.png" mode="aspectFit"/>
        <text class="gen-text">生成注册码</text>
      </view>
    </view>

    <!-- 生成结果 -->
    <view class="result-section" wx:if="{{codes.length > 0}}">
      <view class="result-header">
        <text class="result-title">注册码</text>
        <text class="result-copy-all" bindtap="copyAll">全部复制</text>
      </view>
      <view class="codes-grid">
        <view class="code-card" wx:for="{{codes}}" wx:key="index">
          <text class="code-index">注册码{{index + 1}}</text>
          <text class="code-value">{{item}}</text>
          <view class="code-copy" bindtap="copyCode" data-code="{{item}}" data-index="{{index}}">
            <image class="code-copy-icon" src="/images/ui_album_white.png" mode="aspectFit"/>
          </view>
        </view>
      </view>

      <!-- 生成参数 -->
      <view class="params-card" wx:if="{{showParams}}">
        <view class="params-header" bindtap="toggleParams">
          <text class="params-title">生成参数</text>
          <text class="params-toggle">{{showParamsDetail ? '收起' : '展开'}}</text>
        </view>
        <view class="params-body" wx:if="{{showParamsDetail}}">
          <view class="param-row">
            <text class="param-label">设备编码</text>
            <text class="param-value">{{deviceCode}}</text>
          </view>
          <view class="param-row">
            <text class="param-label">日期</text>
            <text class="param-value">{{dateStr}}</text>
          </view>
          <view class="param-row">
            <text class="param-label">随机数</text>
            <text class="param-value">{{randomNumsText}}</text>
          </view>
          <view class="param-row">
            <text class="param-label">十六进制</text>
            <text class="param-value">{{hexNumsText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 解析模式 ========== -->
  <view wx:if="{{mode === 'parse'}}">
    <view class="input-section">
      <view class="input-group">
        <text class="input-label">输入注册码</text>
        <text class="input-hint" style="color: #999; margin-top: 4rpx;">支持粘贴，7个数字用空格、换行或逗号分隔</text>
        <view class="parse-box">
          <textarea
            class="parse-textarea"
            placeholder="例如：12345 67890 11111 22222 33333 44444 55555"
            value="{{parseBatchInput}}"
            bindinput="onParseBatchInput"
            maxlength="-1"
            auto-height
          />
          <view class="parse-box-actions">
            <text class="parse-action" bindtap="pasteParseInput">粘贴</text>
            <text class="parse-action" wx:if="{{parseBatchInput}}" bindtap="clearParseInput">清空</text>
          </view>
        </view>
      </view>

      <!-- 可选：日期（用于完整验证） -->
      <view class="input-group" style="margin-top: 16rpx;">
        <text class="input-label">日期（可选，用于完整验证）</text>
        <view class="date-row">
          <picker mode="date" value="{{parseDateStr}}" bindchange="onParseDateChange">
            <view class="date-picker">
              <text class="date-text">{{parseDateStr || '选择日期'}}</text>
              <image class="date-icon" src="/images/ui_info.png" mode="aspectFit"/>
            </view>
          </picker>
        </view>
      </view>

      <!-- 解析按钮 -->
      <view class="generate-btn" bindtap="parseCodes" style="margin-top: 24rpx;">
        <image class="gen-icon" src="/images/nav_scan_white.png" mode="aspectFit"/>
        <text class="gen-text">解析注册码</text>
      </view>
    </view>

    <!-- 解析结果 -->
    <view class="result-section" wx:if="{{parseResult}}">
      <!-- 识别到的注册码 -->
      <view class="detail-card">
        <text class="detail-card-title">识别到的注册码</text>
        <view class="detail-row" wx:for="{{parseResult.rawCodes}}" wx:key="index">
          <text class="detail-label">注册码{{index + 1}}</text>
          <text class="detail-value" style="font-family: 'Menlo', 'Consolas', monospace;">{{item}}</text>
        </view>
      </view>

      <!-- 验证状态 -->
      <view class="verify-card {{parseResult.valid ? 'verify-valid' : 'verify-invalid'}}">
        <text class="verify-status">{{parseResult.valid ? '结构校验通过' : '结构校验不通过'}}</text>
        <text class="verify-desc">{{parseResult.valid ? '日期与月份范围合法' : '日期或月份超出合法范围'}}</text>
      </view>

      <!-- 解析详情 -->
      <view class="detail-card">
        <text class="detail-card-title">解析结果</text>

        <view class="detail-row">
          <text class="detail-label">设备编码后4位</text>
          <text class="detail-value highlight">{{parseResult.deviceLast4}}</text>
        </view>

        <view class="detail-row" wx:if="{{parseResult.extractedDate}}">
          <text class="detail-label">提取日期</text>
          <text class="detail-value">{{parseResult.extractedDate}}</text>
        </view>

        <view class="detail-row">
          <text class="detail-label">提取日</text>
          <text class="detail-value">{{parseResult.day}}</text>
        </view>

        <view class="detail-row">
          <text class="detail-label">提取月</text>
          <text class="detail-value">{{parseResult.month}}</text>
        </view>

        <view class="detail-row">
          <text class="detail-label">提取年(后2位)</text>
          <text class="detail-value">{{parseResult.yearPartial}}</text>
        </view>

        <view class="detail-row" wx:if="{{parseResult.dateMatch !== null}}">
          <text class="detail-label">日期验证</text>
          <text class="detail-value {{parseResult.dateMatch ? 'text-valid' : 'text-invalid'}}">{{parseResult.dateMatch ? '匹配' : '不匹配'}}</text>
        </view>
      </view>

      <!-- 随机数 -->
      <view class="detail-card">
        <text class="detail-card-title">提取的随机数</text>
        <view class="detail-row" wx:for="{{parseResult.randomNums}}" wx:key="index">
          <text class="detail-label">随机数{{index + 1}}</text>
          <text class="detail-value">{{item.dec}} ({{item.hex}})</text>
        </view>
      </view>

      <!-- 复制解析结果 -->
      <view class="parse-copy-area">
        <view class="generate-btn" style="background: #E8A44C;" bindtap="copyParseResult">
          <text class="gen-text">复制解析结果</text>
        </view>
      </view>
    </view>
  </view>
  </view>
</view>
