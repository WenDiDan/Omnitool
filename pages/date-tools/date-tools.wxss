.tool-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--sp-4) var(--sp-5) calc(var(--sp-6) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 模式切换 ===== */
.mode-bar {
  white-space: nowrap;
  margin-bottom: var(--sp-4);
}

.mode-tab {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: var(--sp-3);
  background: var(--surface);
  border: 2rpx solid var(--brand-line);
  border-radius: var(--r-full);
  font-size: var(--fs-body);
  color: var(--text-3);
}

.tab-active {
  background: linear-gradient(135deg, #CB5F47, var(--brand-primary));
  border-color: transparent;
  color: var(--text-invert);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(192, 85, 61, 0.22);
}

/* ===== 卡片（.card / .card-head / .card-title / .card-action 由 app.wxss 提供） ===== */
/* ===== 输入 ===== */
.field-label {
  display: block;
  font-size: var(--fs-note);
  color: var(--text-3);
  margin-bottom: var(--sp-2);
}

.field-label.mt {
  margin-top: 28rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--brand-line);
  border-radius: var(--r-sm);
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size: var(--fs-h3);
  color: var(--text-1);
}

.field-hint {
  display: block;
  font-size: var(--fs-tiny);
  color: #C8952C;
  margin-top: var(--sp-3);
}

.date-row {
  display: flex;
  gap: var(--sp-3);
}

.date-col {
  flex: 1;
  min-width: 0;
}

.date-picker {
  height: 84rpx;
  line-height: 80rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--brand-line);
  border-radius: var(--r-sm);
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--text-1);
  font-family: var(--font-mono);
}

/* ===== 间隔统计 ===== */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat-cell {
  width: calc((100% - 20rpx) / 2);
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: var(--sp-4) 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-family: var(--font-mono);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-primary);
  line-height: 1.2;
  word-break: break-all;
}

.stat-name {
  font-size: var(--fs-tiny);
  color: var(--text-3);
  margin-top: var(--sp-1);
}

.muted-note {
  display: block;
  font-size: var(--fs-tiny);
  color: var(--text-4);
  margin-top: 20rpx;
  line-height: 1.5;
}

/* ===== 开关 ===== */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.switch-label {
  font-size: var(--fs-body);
  color: var(--text-1);
}

.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: var(--r-full);
  background: var(--brand-line);
  position: relative;
  transition: background 0.2s;
}

.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  transition: left 0.2s;
}

.switch-on {
  background: var(--brand-primary);
}

.switch-on .switch-dot {
  left: 44rpx;
}

/* ===== 结果卡 ===== */
.result-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.result-num {
  font-family: var(--font-mono);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-primary);
}

.result-sub {
  font-size: var(--fs-note);
  color: var(--text-3);
  margin-top: var(--sp-1);
}

.result-copy {
  padding: 12rpx 30rpx;
  background: linear-gradient(135deg, #EFAF5A, var(--brand-strong));
  color: var(--text-invert);
  border-radius: var(--r-full);
  font-size: var(--fs-body);
  font-weight: 700;
  flex-shrink: 0;
  margin-left: var(--sp-3);
  box-shadow: 0 4rpx 12rpx rgba(232, 164, 76, 0.26);
}

/* ===== 时间戳 ===== */
.ts-now {
  display: block;
  font-size: var(--fs-body);
  color: var(--text-3);
  margin-bottom: 10rpx;
}

.ts-now-num {
  display: block;
  font-family: var(--font-mono);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-primary);
  word-break: break-all;
}

.convert-result {
  display: block;
  margin-top: 20rpx;
  font-family: var(--font-mono);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  background: var(--surface-2);
  border-radius: var(--r-sm);
  padding: 20rpx 22rpx;
  word-break: break-all;
}

.ts-out-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  background: var(--surface-2);
  border-radius: var(--r-sm);
  padding: 20rpx 22rpx;
}

.ts-out {
  font-family: var(--font-mono);
  font-size: var(--fs-h3);
  font-weight: 700;
  color: var(--text-1);
  word-break: break-all;
  flex: 1;
  margin-right: var(--sp-3);
}

/* ===== 倒计时 ===== */
.primary-btn {
  margin-top: var(--sp-5);
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, #CB5F47, var(--brand-primary));
  color: var(--text-invert);
  border-radius: var(--r-md);
  font-size: var(--fs-h3);
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-brand);
}

.cd-grid {
  display: flex;
  gap: var(--sp-3);
}

.cd-cell {
  flex: 1;
  background: linear-gradient(160deg, #3A2A20, #2B1D18);
  border-radius: var(--r-md);
  padding: 28rpx var(--sp-1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cd-num {
  font-family: var(--font-mono);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand-accent);
  line-height: 1.2;
}

.cd-name {
  font-size: var(--fs-micro);
  color: rgba(255, 255, 255, 0.55);
  margin-top: var(--sp-1);
}
