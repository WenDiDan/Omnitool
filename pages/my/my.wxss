/* ===== 页面容器 ===== */
.page-wrap {
  min-height: 100vh;
  background: #F4F1DE;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 头部区域 ===== */
.header-section {
  position: relative;
  overflow: hidden;
}

.header-bg {
  height: 280rpx;
  background: linear-gradient(160deg, #0D1B2A 0%, #1B3A4B 45%, #2D5A52 75%, #3D8B7A 100%);
  position: relative;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 20rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(224,122,95,0.2) 0%, transparent 70%);
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(61,139,122,0.25) 0%, transparent 70%);
}

/* 顶部装饰圆点 */
.header-dots {
  position: absolute;
  top: 60rpx;
  left: 40rpx;
  display: flex;
  gap: 16rpx;
}

.header-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.3);
}

.header-dot:nth-child(2) {
  width: 24rpx;
}

/* 斜切过渡 */
.header-slant {
  height: 36rpx;
  background: #F4F1DE;
  border-radius: 36rpx 36rpx 0 0;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 -8rpx 32rpx rgba(13, 27, 42, 0.06);
}

/* 用户信息 */
.profile-content {
  display: flex;
  align-items: center;
  margin: -160rpx 48rpx 0;
  position: relative;
  z-index: 3;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(13, 27, 42, 0.12), 0 4rpx 12rpx rgba(13, 27, 42, 0.06);
}

/* ===== 头像 ===== */
.avatar-wrap {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 头像光环 */
.avatar-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  border: 3rpx solid transparent;
  background: linear-gradient(135deg, #E07A5F, #3D8B7A) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: destination-out;
  mask-composite: exclude;
}

.avatar-ring::before {
  content: '';
  position: absolute;
  top: -3rpx;
  left: -3rpx;
  right: -3rpx;
  bottom: -3rpx;
  border-radius: 58rpx;
  background: linear-gradient(135deg, #E07A5F, #3D8B7A);
  z-index: -1;
  opacity: 0.5;
  filter: blur(6rpx);
}

/* 相机徽标 */
.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #E07A5F, #c9624a);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  box-shadow: 0 3rpx 8rpx rgba(224, 122, 95, 0.4);
}

.avatar-badge-icon {
  width: 18rpx;
  height: 18rpx;
}

/* ===== 昵称区域 ===== */
.user-info {
  flex: 1;
  min-width: 0;
}

.nick-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.nick-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #0D1B2A;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-desc-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.user-desc {
  font-size: 24rpx;
  color: #8D8D8D;
  letter-spacing: 1rpx;
}

/* ===== 登录按钮 ===== */
.login-btn {
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, #3D8B7A, #4a9e8e);
  border-radius: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(61, 139, 122, 0.35);
}

.login-btn-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 默认头像 */
.avatar-default {
  background: linear-gradient(135deg, #2D5A52, #3D8B7A);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-icon {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.8;
}

/* ===== 统计区域 ===== */
.stats-section {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 32rpx;
  border-radius: 20rpx;
  padding: 14rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(13, 27, 42, 0.08);
  position: relative;
  z-index: 4;
}

.stats-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #E8E4D8, transparent);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-item::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: linear-gradient(180deg, transparent, #E8E4D8, transparent);
}

.stat-item:last-child::after {
  display: none;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #0D1B2A;
  line-height: 1.2;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.stat-num.accent {
  color: #E07A5F;
  background: linear-gradient(135deg, #E07A5F, #d46a4a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-lbl {
  display: block;
  font-size: 20rpx;
  color: #8D8D8D;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ===== 菜单区域 ===== */
.menu-section {
  padding: 0 32rpx;
}

.menu-group-title {
  font-size: 22rpx;
  color: #8D8D8D;
  font-weight: 500;
  letter-spacing: 2rpx;
  padding: 16rpx 0 8rpx;
  display: flex;
  align-items: center;
}

.menu-group-title::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #3D8B7A;
  margin-right: 12rpx;
}

.menu-group {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 3rpx 16rpx rgba(13, 27, 42, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  position: relative;
  transition: background 0.2s ease;
}

.menu-item:active {
  background: #FAFAF5;
}

.menu-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 84rpx;
  right: 24rpx;
  height: 1rpx;
  background: #F5F2E8;
}

.menu-item:last-child::after {
  display: none;
}

.menu-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.1);
}

.menu-icon-box.menu-icon-green { background: linear-gradient(135deg, #3D8B7A, #4a9e8e); }
.menu-icon-box.menu-icon-orange { background: linear-gradient(135deg, #E07A5F, #d46a4a); }
.menu-icon-box.menu-icon-teal { background: linear-gradient(135deg, #2D8B7A, #3a9e8e); }
.menu-icon-box.menu-icon-brown { background: linear-gradient(135deg, #8B7355, #9d8567); }
.menu-icon-box.menu-icon-red { background: linear-gradient(135deg, #E63946, #c62828); }
.menu-icon-box.menu-icon-admin { background: linear-gradient(135deg, #0D1B2A, #1B3A4B); }

.menu-icon {
  width: 28rpx;
  height: 28rpx;
}

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-name {
  display: block;
  font-size: 28rpx;
  color: #0D1B2A;
  font-weight: 500;
}

.menu-hint {
  display: block;
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 4rpx;
}

.menu-arrow-box {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C8C4B8;
  font-weight: 300;
}

/* 危险操作菜单项 */
.menu-item-danger .menu-icon-box {
  background: linear-gradient(135deg, #fff1f0, #ffe0df);
}

.menu-item-danger .menu-name {
  color: #E63946;
}

/* ===== 底部 ===== */
.footer {
  text-align: center;
  padding: 32rpx 0 24rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #C8C4B8;
  letter-spacing: 2rpx;
}

/* ===== 个人信息弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(13,27,42,0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 24rpx 64rpx rgba(13,27,42,0.25);
}

.modal-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.modal-accent-bar {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #E07A5F;
  margin: 0 auto 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0D1B2A;
}

/* 弹窗内编辑行 */
.profile-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

/* 提示信息 */
.profile-edit-tip {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.profile-tip-text {
  font-size: 24rpx;
  color: #2E7D32;
  line-height: 1.5;
}

.profile-edit-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

/* 弹窗内头像按钮 */
.profile-avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
  flex: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 16rpx;
  background: #F0EDE0;
}

.profile-avatar-hint {
  font-size: 26rpx;
  color: #E07A5F;
}

/* 弹窗内昵称输入 */
.profile-nick-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #E8E4D8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #0D1B2A;
  background: #FAFAF5;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-cancel {
  background: #F0EDE0;
  color: #6B6B6B;
}

.modal-confirm {
  background: #0D1B2A;
  color: #fff;
}

/* ===== 角色标签 ===== */
.role-badge {
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.role-badge-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
}

.role-admin { background: linear-gradient(135deg, #0D1B2A, #2D3B4B); }
.role-vip { background: linear-gradient(135deg, #E07A5F, #d46a4a); }
.role-user { background: linear-gradient(135deg, #3D8B7A, #4a9e8e); }
.role-blocked { background: #999; }

/* ===== 封禁警告 ===== */
.blocked-warn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E63946, #C62828);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(230, 57, 70, 0.35);
  animation: warnPulse 2s ease-in-out infinite;
}

@keyframes warnPulse {
  0%, 100% { box-shadow: 0 8rpx 24rpx rgba(230, 57, 70, 0.35); }
  50% { box-shadow: 0 8rpx 32rpx rgba(230, 57, 70, 0.5); }
}

.warn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.warn-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
  line-height: 1.3;
}

.blocked-text {
  color: #E63946 !important;
}

.dot-blocked {
  background: #E63946 !important;
  box-shadow: 0 0 12rpx rgba(230, 57, 70, 0.6) !important;
}

/* ===== 身份状态卡 ===== */
.identity-card {
  background: #fff;
  margin: 16rpx 32rpx;
  border-radius: 20rpx;
  padding: 6rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(13, 27, 42, 0.08);
  position: relative;
  overflow: hidden;
}

.identity-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #E07A5F, #3D8B7A);
}

/* 权限星星 */
.level-stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
}

.star {
  font-size: 26rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.star-active {
  color: #FFD700;
  text-shadow: 0 0 12rpx rgba(255, 215, 0, 0.6);
  animation: starPop 0.4s ease;
}

.star-empty {
  color: #E0E0E0;
}

.star-blocked {
  color: #E0E0E0 !important;
}

@keyframes starPop {
  0% { transform: scale(0.5); opacity: 0; }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); opacity: 1; }
}

.identity-row {
  display: flex;
  align-items: center;
}

.identity-icon-box {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #0D1B2A, #1B3A4B);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 3rpx 10rpx rgba(13, 27, 42, 0.2);
}

.identity-icon {
  width: 26rpx;
  height: 26rpx;
}

.identity-info {
  flex: 1;
}

.identity-label {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-bottom: 2rpx;
}

.identity-value {
  display: block;
  font-size: 26rpx;
  color: #0D1B2A;
  font-weight: 600;
}

.identity-status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: linear-gradient(135deg, #3D8B7A, #4a9e8e);
  flex-shrink: 0;
  box-shadow: 0 0 10rpx rgba(61, 139, 122, 0.5);
  animation: dotPulse 2s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.8; }
}

.identity-status-dot.dot-admin {
  background: linear-gradient(135deg, #E07A5F, #d46a4a);
  box-shadow: 0 0 16rpx rgba(224, 122, 95, 0.6);
}

/* ===== 登录时间显示 ===== */
.login-time-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
  display: block;
}

.identity-time-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E8E4D8;
}

.identity-time-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.identity-time-value {
  font-size: 26rpx;
  color: #3D8B7A;
  font-weight: 500;
}

/* ===== 管理员面板 ===== */
.admin-panel {
  margin: 0 32rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(13,27,42,0.06);
}

.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0EDE0;
}

.admin-header-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.admin-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D1B2A;
}

.admin-count {
  font-size: 24rpx;
  color: #999;
}

.admin-refresh {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #F4F1DE;
}

.admin-refresh-text {
  font-size: 24rpx;
  color: #3D8B7A;
  font-weight: 500;
}

/* 角色统计 */
.admin-stats {
  display: flex;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F0EDE0;
}

.admin-stat-item {
  flex: 1;
  text-align: center;
}

.admin-stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.2;
}

.admin-stat-lbl {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.admin-stat-admin { color: #0D1B2A; }
.admin-stat-vip { color: #E07A5F; }
.admin-stat-user { color: #3D8B7A; }
.admin-stat-blocked { color: #999; }

/* 加载中 */
.admin-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}

.admin-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #E8E4D8;
  border-top-color: #3D8B7A;
  border-radius: 50%;
  animation: admin-spin 0.8s linear infinite;
}

@keyframes admin-spin {
  to { transform: rotate(360deg); }
}

.admin-loading-text {
  font-size: 24rpx;
  color: #C8C4B8;
  margin-top: 16rpx;
}

/* 用户列表 */
.user-list {
  padding: 8rpx 0;
}

.user-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
}

.user-row:active {
  background: #FAFAF5;
}

.user-id-row {
  display: flex;
  align-items: center;
  margin: 4rpx 0;
}

.user-id-label {
  font-size: 22rpx;
  color: #999;
  margin-right: 6rpx;
}

.user-id-value {
  font-size: 22rpx;
  color: #666;
  font-family: Monaco, Menlo, monospace;
  letter-spacing: 1rpx;
}

.user-id-hint {
  font-size: 18rpx;
  color: #CCC;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  background: #F5F5F0;
  border-radius: 4rpx;
}

.user-avatar-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #F0EDE0;
  position: relative;
}

.user-avatar-img {
  width: 72rpx;
  height: 72rpx;
}

.user-online-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #fff;
}

.role-dot-admin { background: #0D1B2A; }
.role-dot-vip { background: #E07A5F; }
.role-dot-user { background: #3D8B7A; }

.user-info-sm {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
}

.user-name-sm {
  font-size: 28rpx;
  color: #0D1B2A;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-meta-sm {
  display: block;
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 4rpx;
  font-family: 'Menlo', 'Consolas', monospace;
}

.user-role-tag {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: center;
}

.user-role-tag:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.user-role-text {
  font-size: 22rpx;
  color: #fff;
}

/* 空状态 */
.admin-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}

.admin-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.admin-empty-text {
  font-size: 28rpx;
  color: #C8C4B8;
  font-weight: 500;
}

.admin-empty-hint {
  font-size: 22rpx;
  color: #D8D4C8;
  margin-top: 8rpx;
}
