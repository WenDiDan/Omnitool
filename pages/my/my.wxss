/* ===== 页面容器 ===== */
.page-wrap {
  min-height: 100vh;
  background: #F4F1DE;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 头部区域 ===== */
.header-section {
  position: relative;
  overflow: hidden;
}

.header-bg {
  height: 340rpx;
  background: linear-gradient(160deg, #0D1B2A 0%, #1B3A4B 60%, #3D8B7A 100%);
  position: relative;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 40rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(224,122,95,0.15);
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: 20rpx;
  left: -20rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(61,139,122,0.12);
}

/* 斜切过渡 */
.header-slant {
  height: 60rpx;
  background: #F4F1DE;
  border-radius: 50rpx 50rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

/* 用户信息 - 使用 margin-top 负值上浮到 header-bg 内 */
.profile-content {
  display: flex;
  align-items: center;
  margin: -180rpx 48rpx 0;
  position: relative;
  z-index: 3;
}

/* ===== 头像 ===== */
.avatar-wrap {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  margin-right: 32rpx;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  position: absolute;
  top: 8rpx;
  left: 8rpx;
}

/* 头像光环 */
.avatar-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 136rpx;
  height: 136rpx;
  border-radius: 68rpx;
  border: 3rpx solid rgba(224,122,95,0.7);
  box-sizing: border-box;
}

/* 相机徽标 */
.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #E07A5F;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #1B3A4B;
}

.avatar-badge-icon {
  width: 20rpx;
  height: 20rpx;
}

/* ===== 昵称区域 ===== */
.user-info {
  flex: 1;
  min-width: 0;
}

.nick-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nick-text {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
  letter-spacing: 2rpx;
}

/* ===== 登录按钮 ===== */
.login-btn {
  padding: 12rpx 32rpx;
  background: #3D8B7A;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.login-btn-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* 默认头像 */
.avatar-default {
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ===== 统计区域 ===== */
.stats-section {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 24rpx 32rpx;
  border-radius: 20rpx;
  padding: 32rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(13,27,42,0.08);
  position: relative;
  z-index: 4;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #0D1B2A;
  line-height: 1.2;
}

.stat-num.accent {
  color: #E07A5F;
}

.stat-lbl {
  display: block;
  font-size: 22rpx;
  color: #8D8D8D;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #E8E4D8;
}

/* ===== 菜单区域 ===== */
.menu-section {
  padding: 0 32rpx;
}

.menu-group {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(13,27,42,0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.menu-icon-circle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-icon {
  width: 32rpx;
  height: 32rpx;
}

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-name {
  display: block;
  font-size: 30rpx;
  color: #0D1B2A;
  font-weight: 500;
}

.menu-hint {
  display: block;
  font-size: 24rpx;
  color: #A0A0A0;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C8C4B8;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.menu-sep {
  height: 1rpx;
  background: #F0EDE0;
  margin: 0 32rpx 0 124rpx;
}

/* ===== 底部 ===== */
.footer {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #B8B4A8;
  letter-spacing: 2rpx;
}

/* ===== 个人信息弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(13,27,42,0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 24rpx 64rpx rgba(13,27,42,0.25);
}

.modal-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.modal-accent-bar {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #E07A5F;
  margin: 0 auto 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0D1B2A;
}

/* 弹窗内编辑行 */
.profile-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

/* 提示信息 */
.profile-edit-tip {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.profile-tip-text {
  font-size: 24rpx;
  color: #2E7D32;
  line-height: 1.5;
}

.profile-edit-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

/* 弹窗内头像按钮 */
.profile-avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
  flex: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 16rpx;
  background: #F0EDE0;
}

.profile-avatar-hint {
  font-size: 26rpx;
  color: #E07A5F;
}

/* 弹窗内昵称输入 */
.profile-nick-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #E8E4D8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #0D1B2A;
  background: #FAFAF5;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-cancel {
  background: #F0EDE0;
  color: #6B6B6B;
}

.modal-confirm {
  background: #0D1B2A;
  color: #fff;
}

/* ===== 角色标签 ===== */
.role-badge {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.role-badge-text {
  font-size: 20rpx;
  color: #fff;
}

.role-admin { background: #0D1B2A; }
.role-vip { background: #E07A5F; }
.role-user { background: #3D8B7A; }
.role-blocked { background: #999; }

/* ===== 封禁警告 ===== */
.blocked-warn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E63946 0%, #C62828 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(230, 57, 70, 0.3);
}

.warn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.warn-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
  line-height: 1.4;
}

.blocked-text {
  color: #E63946 !important;
}

.dot-blocked {
  background: #E63946 !important;
  box-shadow: 0 0 8rpx rgba(230, 57, 70, 0.5) !important;
}

/* ===== 身份状态卡 ===== */
.identity-card {
  background: #fff;
  margin: 24rpx 32rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(13,27,42,0.06);
}

/* 权限星星 */
.level-stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
}

.star {
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.star-active {
  color: #FFD700;
  text-shadow: 0 0 8rpx rgba(255, 215, 0, 0.5);
  animation: starPop 0.3s ease;
}

.star-empty {
  color: #E0E0E0;
}

.star-blocked {
  color: #E0E0E0 !important;
}

@keyframes starPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.identity-row {
  display: flex;
  align-items: center;
}

.identity-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #0D1B2A;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.identity-icon {
  width: 32rpx;
  height: 32rpx;
}

.identity-info {
  flex: 1;
}

.identity-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.identity-value {
  display: block;
  font-size: 28rpx;
  color: #0D1B2A;
  font-weight: 500;
}

.identity-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #3D8B7A;
  flex-shrink: 0;
}

.identity-status-dot.dot-admin {
  background: #E07A5F;
  box-shadow: 0 0 12rpx rgba(224,122,95,0.5);
}

/* ===== 登录时间显示 ===== */
.login-time-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 6rpx;
  display: block;
}

.identity-time-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0EDE0;
}

.identity-time-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.identity-time-value {
  font-size: 24rpx;
  color: #3D8B7A;
  font-weight: 500;
}

/* ===== 管理员面板 ===== */
.admin-panel {
  margin: 0 32rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(13,27,42,0.06);
}

.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0EDE0;
}

.admin-header-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.admin-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D1B2A;
}

.admin-count {
  font-size: 24rpx;
  color: #999;
}

.admin-refresh {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #F4F1DE;
}

.admin-refresh-text {
  font-size: 24rpx;
  color: #3D8B7A;
  font-weight: 500;
}

/* 角色统计 */
.admin-stats {
  display: flex;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F0EDE0;
}

.admin-stat-item {
  flex: 1;
  text-align: center;
}

.admin-stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.2;
}

.admin-stat-lbl {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.admin-stat-admin { color: #0D1B2A; }
.admin-stat-vip { color: #E07A5F; }
.admin-stat-user { color: #3D8B7A; }
.admin-stat-blocked { color: #999; }

/* 加载中 */
.admin-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}

.admin-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #E8E4D8;
  border-top-color: #3D8B7A;
  border-radius: 50%;
  animation: admin-spin 0.8s linear infinite;
}

@keyframes admin-spin {
  to { transform: rotate(360deg); }
}

.admin-loading-text {
  font-size: 24rpx;
  color: #C8C4B8;
  margin-top: 16rpx;
}

/* 用户列表 */
.user-list {
  padding: 8rpx 0;
}

.user-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
}

.user-row:active {
  background: #FAFAF5;
}

.user-id-row {
  display: flex;
  align-items: center;
  margin: 4rpx 0;
}

.user-id-label {
  font-size: 22rpx;
  color: #999;
  margin-right: 6rpx;
}

.user-id-value {
  font-size: 22rpx;
  color: #666;
  font-family: Monaco, Menlo, monospace;
  letter-spacing: 1rpx;
}

.user-id-hint {
  font-size: 18rpx;
  color: #CCC;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  background: #F5F5F0;
  border-radius: 4rpx;
}

.user-avatar-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #F0EDE0;
  position: relative;
}

.user-avatar-img {
  width: 72rpx;
  height: 72rpx;
}

.user-online-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #fff;
}

.role-dot-admin { background: #0D1B2A; }
.role-dot-vip { background: #E07A5F; }
.role-dot-user { background: #3D8B7A; }

.user-info-sm {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
}

.user-name-sm {
  font-size: 28rpx;
  color: #0D1B2A;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-meta-sm {
  display: block;
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 4rpx;
  font-family: 'Menlo', 'Consolas', monospace;
}

.user-role-tag {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: center;
}

.user-role-tag:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.user-role-text {
  font-size: 22rpx;
  color: #fff;
}

/* 空状态 */
.admin-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}

.admin-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.admin-empty-text {
  font-size: 28rpx;
  color: #C8C4B8;
  font-weight: 500;
}

.admin-empty-hint {
  font-size: 22rpx;
  color: #D8D4C8;
  margin-top: 8rpx;
}
