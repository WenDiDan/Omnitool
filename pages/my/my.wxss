/* ===== 页面容器 ===== */
.page-wrap {
  min-height: 100vh;
  background: #F2F3F7;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 用户卡片 ===== */
.user-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 封禁提示 */
.block-banner {
  display: flex;
  align-items: center;
  background: #FF4D4F;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.block-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.block-text {
  font-size: 24rpx;
  color: #fff;
  flex: 1;
  line-height: 1.4;
}

/* 用户头部 */
.user-header {
  display: flex;
  align-items: center;
}

.avatar-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #E8ECF4;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.name-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nick-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-right: 16rpx;
}

.role-tag {
  padding: 4rpx 16rpx;
  background: #EBF0FF;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #5B7FFF;
  flex-shrink: 0;
}

.profile-tip {
  font-size: 24rpx;
  color: #999;
}

.login-btn-small {
  padding: 10rpx 28rpx;
  background: #5B7FFF;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
  flex-shrink: 0;
}

/* 会员信息 */
.member-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.member-item {
  flex: 1;
  text-align: center;
}

.member-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F0F0F0;
}

.member-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.member-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.member-inactive {
  color: #999;
}

.member-permanent {
  color: #52C41A;
}

/* ID 行 */
.id-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.id-text {
  font-size: 24rpx;
  color: #999;
}

.upgrade-btn {
  padding: 10rpx 24rpx;
  background: #5B7FFF;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
  flex-shrink: 0;
}

/* ===== 区域 ===== */
.section {
  margin: 0 24rpx 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

/* ===== 菜单卡片 ===== */
.menu-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 菜单行 */
.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  position: relative;
}

.menu-row::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 104rpx;
  right: 24rpx;
  height: 1rpx;
  background: #F5F5F5;
}

.menu-row-last::after {
  display: none;
}

.menu-row:active {
  background: #FAFAFA;
}

/* 含透明 overlay button 的菜单行 */
.menu-row-btn {
  position: relative;
}

.menu-btn-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  z-index: 2;
}

.menu-btn-overlay::after {
  border: none;
}

.menu-btn-overlay:active {
  background: rgba(0, 0, 0, 0.05);
}

/* 菜单图标 */
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.icon-blue { background: linear-gradient(135deg, #5B7FFF, #7B9AFF); }
.icon-green { background: linear-gradient(135deg, #52C41A, #73D13D); }
.icon-orange { background: linear-gradient(135deg, #FF7A45, #FF9C6E); }
.icon-purple { background: linear-gradient(135deg, #9254DE, #B37FEB); }
.icon-teal { background: linear-gradient(135deg, #13C2C2, #36CFC9); }
.icon-pink { background: linear-gradient(135deg, #EB2F96, #F759AB); }
.icon-red { background: linear-gradient(135deg, #FF4D4F, #FF7875); }
.icon-dark { background: linear-gradient(135deg, #1a1a2e, #3a3a5e); }

/* 菜单文字 */
.menu-text {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.menu-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 菜单右侧 */
.menu-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.version-text {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #CCC;
  font-weight: 300;
  flex-shrink: 0;
}

/* 退出登录 */
.menu-row-logout .menu-title {
  color: #FF4D4F;
}

/* 底部留白 */
.footer-gap {
  height: 40rpx;
}

/* ===== 个人信息弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(13,27,42,0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 24rpx 64rpx rgba(13,27,42,0.25);
}

.modal-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.modal-accent-bar {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #5B7FFF;
  margin: 0 auto 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a2e;
}

/* 弹窗内编辑行 */
.profile-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

/* 提示信息 */
.profile-edit-tip {
  background: linear-gradient(135deg, #EBF0FF 0%, #F0F4FF 100%);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.profile-tip-text {
  font-size: 24rpx;
  color: #5B7FFF;
  line-height: 1.5;
}

.profile-edit-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

/* 弹窗内头像按钮 */
.profile-avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
  flex: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 16rpx;
  background: #F0F0F0;
}

.profile-avatar-hint {
  font-size: 26rpx;
  color: #5B7FFF;
}

/* 弹窗内昵称输入 */
.profile-nick-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  background: #FAFAFA;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-cancel {
  background: #F0F0F0;
  color: #6B6B6B;
}

.modal-confirm {
  background: #5B7FFF;
  color: #fff;
}
