<view class="container">
  <view class="user-card card flex-row">
    <view class="avatar">👤</view>
    <view class="user-info">
      <text class="user-name">条码扫描器用户</text>
      <text class="user-stats">已扫描 {{totalCount}} 次</text>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-item flex-between" bindtap="goToHistory">
      <view class="menu-left">
        <text class="menu-icon">📜</text>
        <text class="menu-title">扫描历史</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item flex-between" bindtap="goToSettings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-title">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item flex-between" bindtap="clearCache">
      <view class="menu-left">
        <text class="menu-icon">🗑️</text>
        <text class="menu-title">清除缓存</text>
      </view>
      <text class="menu-value">{{cacheSize}}</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item flex-between" bindtap="showAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-title">关于</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version-info">
    <text>版本 1.0.0</text>
  </view>
</view>