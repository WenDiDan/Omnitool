<view class="page-wrap">
  <!-- 头部区域 -->
  <view class="header-section">
    <view class="header-bg"></view>
    <view class="header-slant"></view>

    <!-- 未登录状态 -->
    <view class="profile-content" wx:if="{{!isLoggedIn}}" bindtap="showLogin">
      <view class="avatar-wrap">
        <view class="avatar-img avatar-default">
          <image class="avatar-placeholder-icon" src="/images/icon_user_white.png" mode="aspectFit"/>
        </view>
        <view class="avatar-ring"></view>
      </view>
      <view class="user-info">
        <text class="nick-text">未登录</text>
        <text class="user-desc">点击登录享受更多功能</text>
      </view>
      <view class="login-btn">
        <text class="login-btn-text">微信登录</text>
      </view>
    </view>

    <!-- 已登录状态 -->
    <view class="profile-content" wx:if="{{isLoggedIn}}" bindtap="onEditProfile">
      <view class="avatar-wrap">
        <image class="avatar-img" src="{{avatarUrl || '/images/icon_user_white.png'}}" mode="aspectFill"/>
        <view class="avatar-ring"></view>
        <view class="avatar-badge">
          <image class="avatar-badge-icon" src="/images/icon_camera_white.png" mode="aspectFit"/>
        </view>
      </view>
      <view class="user-info">
        <view class="nick-row">
          <text class="nick-text">{{nickName || '点击设置昵称'}}</text>
          <view class="role-badge role-{{userInfo.role || 'user'}}">
            <text class="role-badge-text">{{roleLabel}}</text>
          </view>
        </view>
        <text class="user-desc">ID: {{openidShort || '---'}}</text>
        <text class="login-time-text" wx:if="{{loginTime}}">登录: {{loginTime}}</text>
      </view>
    </view>
  </view>

  <!-- 身份状态卡（已登录才显示） -->
  <view class="identity-card" wx:if="{{isLoggedIn && userInfo}}">
    <view class="identity-row">
      <view class="identity-icon-box">
        <image class="identity-icon" src="/images/icon_device.png" mode="aspectFit"/>
      </view>
      <view class="identity-info">
        <text class="identity-label">身份状态</text>
        <text class="identity-value">{{roleLabel}} · 权限等级 {{userInfo.level || 1}}</text>
      </view>
      <view class="identity-status-dot {{isAdmin ? 'dot-admin' : ''}}"></view>
    </view>
    <view class="identity-time-row" wx:if="{{lastActiveTime}}">
      <text class="identity-time-label">最近活跃:</text>
      <text class="identity-time-value">{{lastActiveTime}}</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stat-item stat-main">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-lbl">累计扫描</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num accent">{{todayCount}}</text>
      <text class="stat-lbl">今日</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{typeCount}}</text>
      <text class="stat-lbl">条码类型</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goToUserManage">
        <view class="menu-icon-circle" style="background: #0D1B2A;">
          <image class="menu-icon" src="/images/icon_settings_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-body">
          <text class="menu-name">用户管理</text>
          <text class="menu-hint">管理员专用</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-icon-circle" style="background: #3D8B7A;">
          <image class="menu-icon" src="/images/icon_history_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-body">
          <text class="menu-name">扫描历史</text>
          <text class="menu-hint">{{totalCount}} 条记录</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-sep"></view>
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-icon-circle" style="background: #E07A5F;">
          <image class="menu-icon" src="/images/icon_settings_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-body">
          <text class="menu-name">设置</text>
          <text class="menu-hint">声音、显示等偏好</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" wx:if="{{isLoggedIn}}" bindtap="logout">
        <view class="menu-icon-circle" style="background: #C0392B;">
          <image class="menu-icon" src="/images/icon_delete_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-body">
          <text class="menu-name" style="color: #C0392B;">退出登录</text>
          <text class="menu-hint">切换账号或重新登录</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-sep" wx:if="{{isLoggedIn}}"></view>
      <view class="menu-item" bindtap="clearCache">
        <view class="menu-icon-circle" style="background: #5B8E7D;">
          <image class="menu-icon" src="/images/icon_delete_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-body">
          <text class="menu-name">清除缓存</text>
          <text class="menu-hint">{{cacheSize}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-sep"></view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-icon-circle" style="background: #8D6E63;">
          <image class="menu-icon" src="/images/icon_info_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-body">
          <text class="menu-name">关于</text>
          <text class="menu-hint">版本 4.0.0</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">条码扫描器 v4.0.0</text>
  </view>

  <view class="modal-mask" wx:if="{{showProfileModal}}" bindtap="closeProfileModal">
    <view class="modal-box" catchtap="stopTap">
      <view class="modal-header">
        <view class="modal-accent-bar"></view>
        <text class="modal-title">{{isFirstLogin ? '设置头像昵称' : '编辑资料'}}</text>
      </view>
      <view class="profile-edit-tip" wx:if="{{isFirstLogin}}">
        <text class="profile-tip-text">获取微信头像和昵称，提升个性化体验</text>
      </view>
      <view class="profile-edit-row">
        <text class="profile-edit-label">头像</text>
        <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onEditChooseAvatar">
          <image class="profile-avatar-preview" src="{{editAvatarUrl || '/images/icon_user_white.png'}}" mode="aspectFill"/>
          <text class="profile-avatar-hint">{{editAvatarUrl ? '更换' : '选择头像'}}</text>
        </button>
      </view>
      <view class="profile-edit-row">
        <text class="profile-edit-label">昵称</text>
        <input class="profile-nick-input" type="nickname" value="{{editNickName}}" placeholder="点击此处获取微信昵称" bindinput="onEditNickInput"/>
      </view>
      <view class="modal-btns">
        <view class="modal-btn modal-cancel" bindtap="closeProfileModal">{{isFirstLogin ? '跳过' : '取消'}}</view>
        <view class="modal-btn modal-confirm" bindtap="confirmProfile">保存</view>
      </view>
    </view>
  </view>
</view>
