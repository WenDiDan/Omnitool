<view class="container">
  <!-- 头部 -->
  <view class="recycle-header">
    <view class="header-left">
      <text class="header-icon-back" bindtap="goBack">←</text>
      <text class="header-title" bindlongpress="debugExpire">回收站</text>
    </view>
    <view class="header-right">
      <text class="header-count" wx:if="{{recycledList.length > 0}}">{{recycledList.length}} 条记录</text>
      <text class="test-data-btn-inline" wx:if="{{isAdmin}}" bindtap="insertTestData">生成测试数据</text>
    </view>
  </view>

  <!-- 描述条 -->
  <view class="recycle-desc" wx:if="{{!isEmpty}}">
    <view class="desc-dot"></view>
    <text class="desc-text">清空历史时存于此，{{retentionDaysText}}内可随时恢复，超期自动清除</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isEmpty}}" class="empty-state">
    <view class="empty-icon">
      <view class="empty-box">
        <view class="empty-box-lid"></view>
        <view class="empty-box-body">
          <view class="empty-box-line"></view>
          <view class="empty-box-line short"></view>
        </view>
      </view>
    </view>
    <text class="empty-title">回收站为空</text>
    <text class="empty-hint">清空历史数据后会自动存入此处</text>
    <view class="empty-btn" bindtap="goBack">
      <text class="empty-btn-text">返回历史</text>
    </view>
  </view>

  <!-- 回收站列表 - 时间轴布局 -->
  <view wx:else class="recycle-list">
    <view class="list-head-actions" wx:if="{{recycledList.length > 0}}">
      <view class="head-restore-btn" bindtap="restoreAll">
        <text class="head-restore-text">全部恢复</text>
      </view>
      <view class="head-clear-btn" bindtap="clearAll">
        <text class="head-clear-text">清空回收站</text>
      </view>
    </view>

    <view class="timeline-item" wx:for="{{recycledList}}" wx:key="code">
      <!-- 时间轴节点 -->
      <view class="timeline-track">
        <view class="timeline-dot"></view>
        <view class="timeline-line" wx:if="{{index < recycledList.length - 1}}"></view>
      </view>

      <!-- 卡片内容 -->
      <view class="timeline-card">
        <view class="card-top">
          <view class="card-type-tag type-{{item.type}}">
            <text class="card-type-text">{{item.typeLabel || item.type}}</text>
          </view>
          <text class="card-recycled-time">{{item.recycledAtDisplay}}</text>
        </view>

        <text class="card-code">{{item.code}}</text>
        <text class="card-original-time">原扫码时间: {{item.time}}</text>

        <view class="card-actions">
          <view class="card-action-restore" bindtap="restoreRecord" data-code="{{item.code}}">
            <text class="card-action-text restore-text">恢复</text>
          </view>
          <view class="card-action-delete" bindtap="deleteRecord" data-code="{{item.code}}">
            <text class="card-action-text delete-text">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
