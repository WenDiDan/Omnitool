/* pages/recycleBin/recycleBin.wxss */

/* 容器 */
.container {
  min-height: 100vh;
  background: #1B1B2F;
  padding-bottom: 120rpx;
}

/* ===== 头部 ===== */
.recycle-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx 24rpx;
  border-bottom: 1rpx solid rgba(232, 213, 183, 0.08);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-icon-back {
  font-size: 36rpx;
  color: #C4956A;
  font-weight: 300;
  padding: 4rpx 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #E8D5B7;
  letter-spacing: 2rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-count {
  font-size: 24rpx;
  color: #6B7B8D;
  letter-spacing: 1rpx;
}

/* 头部内联测试按钮（仅管理员可见） */
.test-data-btn-inline {
  font-size: 22rpx;
  color: #6B7B8D;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(107, 123, 141, 0.35);
  border-radius: 20rpx;
}

/* ===== 描述条 ===== */
.recycle-desc {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 36rpx 16rpx;
}

.desc-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C4956A;
  flex-shrink: 0;
}

.desc-text {
  font-size: 22rpx;
  color: #6B7B8D;
  letter-spacing: 0.5rpx;
}

/* ===== 加载态 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid rgba(196, 149, 106, 0.18);
  border-top-color: #C4956A;
  border-radius: 50%;
  animation: recycle-spin 0.8s linear infinite;
}

@keyframes recycle-spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #6B7B8D;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}

.empty-icon {
  margin-bottom: 36rpx;
}

.empty-box {
  position: relative;
  width: 120rpx;
}

.empty-box-lid {
  width: 100rpx;
  height: 16rpx;
  background: rgba(196, 149, 106, 0.35);
  border-radius: 2rpx 2rpx 0 0;
  margin-left: 10rpx;
}

.empty-box-body {
  width: 120rpx;
  height: 80rpx;
  background: rgba(45, 58, 74, 0.7);
  border: 2rpx solid rgba(196, 149, 106, 0.25);
  border-radius: 0 0 6rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.empty-box-line {
  width: 48rpx;
  height: 4rpx;
  background: rgba(196, 149, 106, 0.2);
  border-radius: 2rpx;
}

.empty-box-line.short {
  width: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #E8D5B7;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #6B7B8D;
  letter-spacing: 0.5rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 52rpx;
  border: 1rpx solid rgba(196, 149, 106, 0.4);
  border-radius: 32rpx;
}

.empty-btn-text {
  font-size: 26rpx;
  color: #C4956A;
  letter-spacing: 1rpx;
}

/* ===== 列表头部操作 ===== */
.list-head-actions {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 36rpx 16rpx;
}

.head-clear-btn {
  padding: 10rpx 28rpx;
  background: rgba(196, 149, 106, 0.1);
  border: 1rpx solid rgba(196, 149, 106, 0.3);
  border-radius: 24rpx;
}

.head-clear-text {
  font-size: 22rpx;
  color: #C4956A;
}

.head-restore-btn {
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, rgba(196, 149, 106, 0.2), rgba(196, 149, 106, 0.08));
  border: 1rpx solid rgba(196, 149, 106, 0.4);
  border-radius: 24rpx;
}

.head-restore-text {
  font-size: 22rpx;
  color: #C4956A;
}

/* ===== 时间轴列表 ===== */
.recycle-list {
  padding: 0 36rpx 40rpx;
}

/* 时间轴项 */
.timeline-item {
  display: flex;
  padding-bottom: 4rpx;
}

.timeline-track {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 28rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C4956A;
  border: 3rpx solid #1B1B2F;
  box-shadow: 0 0 0 2rpx rgba(196, 149, 106, 0.35);
  flex-shrink: 0;
  z-index: 2;
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  background: linear-gradient(
    to bottom,
    rgba(196, 149, 106, 0.5),
    rgba(196, 149, 106, 0.08)
  );
  margin-top: 8rpx;
  min-height: 40rpx;
}

/* 卡片 */
.timeline-card {
  flex: 1;
  margin-left: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  background: rgba(45, 58, 74, 0.55);
  border-left: 3rpx solid rgba(196, 149, 106, 0.5);
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  backdrop-filter: blur(10rpx);
}

/* 卡片顶部行 */
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

/* 类型标签 */
.card-type-tag {
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background: rgba(107, 123, 141, 0.25);
}

.card-type-tag.type-ean { background: rgba(196, 149, 106, 0.2); }
.card-type-tag.type-qr { background: rgba(107, 123, 141, 0.25); }
.card-type-tag.type-url { background: rgba(45, 58, 74, 0.5); border: 1rpx solid rgba(196, 149, 106, 0.3); }
.card-type-tag.type-wifi { background: rgba(107, 123, 141, 0.18); }
.card-type-tag.type-card { background: rgba(196, 149, 106, 0.15); }
.card-type-tag.type-tel { background: rgba(107, 123, 141, 0.2); }

.card-type-text {
  font-size: 20rpx;
  color: #E8D5B7;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.card-recycled-time {
  font-size: 20rpx;
  color: #6B7B8D;
}

/* 条码 */
.card-code {
  display: block;
  font-size: 28rpx;
  color: #E8D5B7;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
  word-break: break-all;
}

/* 原始时间 */
.card-original-time {
  display: block;
  font-size: 20rpx;
  color: #6B7B8D;
  margin-bottom: 20rpx;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(232, 213, 183, 0.06);
}

.card-action-restore,
.card-action-delete {
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
}

.card-action-restore {
  background: rgba(196, 149, 106, 0.15);
  border: 1rpx solid rgba(196, 149, 106, 0.35);
}

.card-action-delete {
  background: rgba(107, 123, 141, 0.12);
  border: 1rpx solid rgba(107, 123, 141, 0.3);
}

.card-action-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.restore-text {
  color: #C4956A;
}

.delete-text {
  color: #6B7B8D;
}

/* ===== 最后项特殊处理 ===== */
.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-item:last-child .timeline-card {
  margin-bottom: 0;
}
