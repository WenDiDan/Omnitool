<view class="page-wrap">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">总记录</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{todayCount}}</text>
      <text class="stat-label">今日</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{loginCount}}</text>
      <text class="stat-label">登录</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{scanCount}}</text>
      <text class="stat-label">扫码</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === 'all' ? 'active' : ''}}" bindtap="setFilter" data-type="all">全部</view>
    <view class="filter-item {{filterType === 'login' ? 'active' : ''}}" bindtap="setFilter" data-type="login">登录</view>
    <view class="filter-item {{filterType === 'scan' ? 'active' : ''}}" bindtap="setFilter" data-type="scan">扫码</view>
    <view class="filter-item {{filterType === 'admin' ? 'active' : ''}}" bindtap="setFilter" data-type="admin">管理</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 日志列表 -->
  <view class="log-list" wx:if="{{!loading && logList.length > 0}}">
    <view class="log-item {{item.type}}" wx:for="{{logList}}" wx:key="id">
      <view class="log-left">
        <view class="log-icon icon-{{item.type}}">
          <image class="log-icon-img" src="{{item.icon}}" mode="aspectFit"/>
        </view>
        <view class="log-line"></view>
      </view>
      <view class="log-right">
        <view class="log-header">
          <text class="log-title">{{item.title}}</text>
          <text class="log-time">{{item.timeStr}}</text>
        </view>
        <text class="log-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        <view class="log-detail" wx:if="{{item.detail}}">
          <text class="log-detail-text">{{item.detail}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!loading && logList.length === 0}}">
    <image class="empty-icon-img" src="/images/icon_info_white.png" mode="aspectFit"/>
    <view class="empty-circle"></view>
    <text class="empty-title">暂无日志</text>
    <text class="empty-desc">操作记录将自动显示在这里</text>
  </view>

  <!-- 底部留白 -->
  <view class="footer-gap"></view>
</view>
