.page-wrap {
  min-height: 100vh;
  background: #F2F3F7;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 统计卡片 ===== */
.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #eee;
}

/* ===== 筛选栏 ===== */
.filter-bar {
  display: flex;
  padding: 0 24rpx 16rpx;
  gap: 16rpx;
}

.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  transition: all 0.2s;
}

.filter-item.active {
  background: #0D1B2A;
  color: #fff;
  font-weight: 500;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #eee;
  border-top-color: #0D1B2A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ===== 日志列表 ===== */
.log-list {
  padding: 0 24rpx;
}

.log-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.log-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  width: 56rpx;
  flex-shrink: 0;
}

.log-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.log-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.icon-login { background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%); }
.icon-scan { background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%); }
.icon-admin { background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%); }

.log-line {
  flex: 1;
  width: 2rpx;
  background: #f0f0f0;
  margin-top: 12rpx;
}

.log-item:last-child .log-line {
  display: none;
}

.log-right {
  flex: 1;
  min-width: 0;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.log-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.log-time {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.log-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
}

.log-detail {
  margin-top: 12rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
  word-break: break-all;
}

.log-detail-text {
  font-size: 24rpx;
  color: #888;
  font-family: Monaco, Menlo, Consolas, monospace;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon-img {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.empty-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #E8ECF4;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.footer-gap {
  height: 40rpx;
}
