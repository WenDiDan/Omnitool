<view class="container">
  <view class="welcome-card card">
    <text class="welcome-title">欢迎使用条码扫描器</text>
    <text class="welcome-desc">快速扫描条码、二维码，获取详细信息</text>
    <button class="btn-primary" bindtap="goToScan">开始扫码</button>
  </view>

  <view class="stats-card card">
    <text class="stats-title">今日统计</text>
    <view class="stats-content">
      <view class="stat-item">
        <text class="stat-number">{{todayCount}}</text>
        <text class="stat-label">今日扫描</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{totalCount}}</text>
        <text class="stat-label">累计扫描</text>
      </view>
    </view>
  </view>

  <view class="features-card card">
    <text class="features-title">功能特点</text>
    <view class="feature-item">
      <image class="feature-icon" src="/images/icon_scan.png" mode="aspectFit"/>
      <view class="feature-info">
        <text class="feature-name">快速识别</text>
        <text class="feature-desc">支持多种条码和二维码类型</text>
      </view>
    </view>
    <view class="feature-item">
      <image class="feature-icon" src="/images/icon_search.png" mode="aspectFit"/>
      <view class="feature-info">
        <text class="feature-name">智能解码</text>
        <text class="feature-desc">自动识别并解码条码信息</text>
      </view>
    </view>
    <view class="feature-item">
      <image class="feature-icon" src="/images/icon_history.png" mode="aspectFit"/>
      <view class="feature-info">
        <text class="feature-name">历史记录</text>
        <text class="feature-desc">保存所有扫描记录，方便查看</text>
      </view>
    </view>
  </view>
</view>