<view class="container">

  <!-- Hero Banner -->
  <view class="hero-card">
    <view class="hero-inner">
      <view class="hero-top">
        <view class="hero-icon-wrap">
          <image class="hero-icon" src="/images/icon_scan_white.png" mode="aspectFit"/>
        </view>
        <view class="hero-text">
          <text class="hero-title">条码扫描器</text>
          <text class="hero-sub">快速识别 · 智能解码</text>
        </view>
      </view>
      <button class="btn-scan" bindtap="goToScan">
        <image class="btn-scan-icon" src="/images/icon_scan_white.png" mode="aspectFit"/>
        <text class="btn-scan-text">开始扫码</text>
      </button>
    </view>
  </view>

  <!-- 统计区 -->
  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-icon-wrap stat-icon-blue">
        <image class="stat-icon" src="/images/icon_scan.png" mode="aspectFit"/>
      </view>
      <text class="stat-number">{{todayCount}}</text>
      <text class="stat-label">今日扫描</text>
    </view>
    <view class="stat-card">
      <view class="stat-icon-wrap stat-icon-teal">
        <image class="stat-icon" src="/images/icon_history.png" mode="aspectFit"/>
      </view>
      <text class="stat-number">{{totalCount}}</text>
      <text class="stat-label">累计扫描</text>
    </view>
  </view>

  <!-- 快速入口 -->
  <view class="section-title">快速入口</view>
  <view class="shortcut-grid">
    <view class="shortcut-item" bindtap="goToScan">
      <view class="shortcut-icon-wrap sc-scan">
        <image class="shortcut-icon" src="/images/icon_scan_white.png" mode="aspectFit"/>
      </view>
      <text class="shortcut-name">扫码识别</text>
    </view>
    <view class="shortcut-item" bindtap="goToDecode">
      <view class="shortcut-icon-wrap sc-decode">
        <image class="shortcut-icon" src="/images/icon_search.png" mode="aspectFit"/>
      </view>
      <text class="shortcut-name">解密分析</text>
    </view>
    <view class="shortcut-item" bindtap="goToHistory">
      <view class="shortcut-icon-wrap sc-history">
        <image class="shortcut-icon" src="/images/icon_history.png" mode="aspectFit"/>
      </view>
      <text class="shortcut-name">历史记录</text>
    </view>
  </view>

</view>
