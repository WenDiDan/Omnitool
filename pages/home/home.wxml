<view class="container">

  <!-- 品牌刊头：浅色票据条，深色只留给主推工具块 -->
  <view class="hero-card reveal">
    <view class="hero-topline"></view>
    <view class="hero-inner">
      <view class="hero-icon-wrap">
        <image class="hero-icon" src="/images/nav_scan_white.png" mode="aspectFit"/>
      </view>
      <view class="hero-text">
        <text class="hero-title">工具箱</text>
        <text class="hero-sub">多工具集合 · 持续上新</text>
      </view>
      <view class="hero-badge">
        <text class="hero-badge-num">{{toolCount}}</text>
        <text class="hero-badge-label">TOOLS</text>
      </view>
    </view>
  </view>

  <!-- 加载中 / 错误状态条 -->
  <view class="sync-bar" wx:if="{{loadState === 'loading'}}">
    <view class="sync-dot"></view>
    <text class="sync-text">正在同步云端工具…</text>
  </view>
  <view class="sync-bar sync-bar-error" wx:if="{{loadState === 'error'}}">
    <text class="sync-text">{{syncHint}}</text>
    <text class="sync-retry" bindtap="onRetry">重试</text>
  </view>

  <!-- 工具台 -->
  <view class="tools-head reveal" style="animation-delay: 60ms">
    <text class="tools-title">工具台</text>
    <view class="tools-rule"></view>
    <text class="tools-count">{{toolCount}} 个工具</text>
  </view>

  <!-- 空态：云端无上线工具（全部下线 / 集合为空） -->
  <view class="tools-empty reveal" wx:if="{{loadState === 'empty'}}" style="animation-delay: 80ms">
    <image class="tools-empty-icon" src="/images/icon_empty.png" mode="aspectFit"/>
    <text class="tools-empty-title">工具维护中</text>
    <text class="tools-empty-desc">所有工具暂时下线，请稍后再来看看</text>
    <t-button theme="primary" size="small" bindtap="onRetry">重新加载</t-button>
  </view>

  <view class="tools-layout" wx:if="{{loadState !== 'empty'}}">
    <!-- 主推工具：跟随云端配置（scan 在线时为扫码卡，其他在线工具为主推时跳其自身地址） -->
    <view class="tool-primary reveal"
          wx:if="{{featuredTool}}"
          style="animation-delay: 100ms"
          bindtap="onToolTap"
          data-url="{{featuredTool.navUrl}}"
          data-navtype="{{featuredTool.navType}}"
          data-toolkey="{{featuredTool.tool_key}}"
          hover-class="tool-primary-hover">
      <view class="tool-primary-left">
        <text class="tool-index">01</text>
        <text class="tool-primary-name">{{featuredTool.name}}</text>
        <text class="tool-primary-desc">{{featuredTool.desc}}</text>
      </view>
      <view class="tool-primary-right">
        <view class="tool-icon-wrap icon-scan" style="background: {{featuredTool.iconBg}}">
          <image class="tool-icon" wx:if="{{featuredTool.icon}}" src="{{featuredTool.icon}}" mode="aspectFit"/>
          <text class="tool-mark tool-mark-lg" wx:else>{{featuredTool.mark}}</text>
        </view>
      </view>
      <view class="tool-primary-deco"></view>
    </view>

    <!-- 其余工具：自动换行网格，云端新增工具自动排入 -->
    <view class="tools-grid">
      <view class="tool-mini tone-{{index % 3}} reveal"
            wx:for="{{tools}}"
            wx:key="tool_key"
            style="animation-delay: {{140 + index * 45}}ms"
            bindtap="onToolTap"
            data-url="{{item.url}}"
            data-navtype="{{item.navType}}"
            data-toolkey="{{item.tool_key}}"
            hover-class="tool-mini-hover">
        <view class="tool-mini-top">
          <view class="tool-icon-wrap" style="background: {{item.iconBg}}">
            <text class="tool-badge" wx:if="{{item.badge}}" style="color: {{item.badgeColor}}">{{item.badge}}</text>
            <image class="tool-icon-sm" wx:elif="{{item.icon}}" src="{{item.icon}}" mode="aspectFit"/>
            <text class="tool-mark" wx:else>{{item.mark}}</text>
          </view>
          <text class="vip-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
        </view>
        <view class="tool-mini-title-row">
          <text class="tool-mini-name">{{item.name}}</text>
          <text class="tool-mini-arrow">›</text>
        </view>
        <text class="tool-mini-desc">{{item.desc}}</text>
        <text class="tool-mini-idx">{{item.no}}</text>
      </view>
    </view>
  </view>

  <!-- 底部收尾 -->
  <view class="home-footer" wx:if="{{loadState === 'ready' && tools.length}}">
    <view class="home-footer-line"></view>
    <text class="home-footer-text">更多工具 · 持续上新</text>
    <view class="home-footer-line"></view>
  </view>

</view>
