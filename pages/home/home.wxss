/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F7E9D6 0%, #F9F4EB 420rpx);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 品牌条 ===== */
.hero-card {
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(120deg, #1E4636 0%, #2B1D18 70%);
  position: relative;
}

.hero-card::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(242, 176, 78, 0.12);
}

.hero-inner {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
}

.hero-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.hero-icon {
  width: 36rpx;
  height: 36rpx;
}

.hero-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
  margin-bottom: 6rpx;
}

.hero-sub {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.55);
}

.hero-badge {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 24rpx;
  margin-left: 12rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.14);
}

.hero-badge-num {
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 36rpx;
  font-weight: 700;
  color: #F2B04E;
  line-height: 1;
}

.hero-badge-label {
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 16rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 6rpx;
}

/* ===== 同步状态条 ===== */
.sync-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #E6F7F5;
  border-radius: 14rpx;
}

.sync-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E8A44C;
  margin-right: 14rpx;
  animation: sync-pulse 1s ease-in-out infinite;
}

@keyframes sync-pulse {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

.sync-text {
  flex: 1;
  font-size: 22rpx;
  color: #2F6C60;
}

.sync-bar-error {
  background: #FFF3E0;
}

.sync-bar-error .sync-text {
  color: #A8751C;
}

.sync-retry {
  font-size: 22rpx;
  font-weight: 700;
  color: #C8952C;
  padding: 4rpx 12rpx;
}

/* ===== 空态 ===== */
.tools-empty {
  margin: 0 24rpx;
  padding: 80rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tools-empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.55;
}

.tools-empty-title {
  font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #2B1D18;
  margin-bottom: 12rpx;
}

.tools-empty-desc {
  font-size: 22rpx;
  color: #94817A;
  margin-bottom: 32rpx;
}

.tools-empty-retry {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: #E8A44C;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
}

/* ===== 工具台标题 ===== */
.tools-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 40rpx 32rpx 20rpx;
}

.tools-title {
  font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #2B1D18;
}

.tools-count {
  font-size: 22rpx;
  color: #94817A;
}

.tools-layout {
  margin: 0 24rpx;
}

/* ===== 主推工具：全宽横向卡 ===== */
.tool-primary {
  position: relative;
  width: 100%;
  min-height: 300rpx;
  background: linear-gradient(135deg, #A8452F 0%, #3A2A20 55%, #2E2018 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  box-shadow: 0 12rpx 32rpx rgba(43, 29, 24, 0.22);
}

.tool-primary-hover {
  opacity: 0.88;
}

.tool-primary-deco {
  position: absolute;
  right: -110rpx;
  bottom: -140rpx;
  width: 320rpx;
  height: 320rpx;
  background: #E8A44C;
  opacity: 0.30;
  transform: rotate(32deg);
  border-radius: 48rpx;
}

.tool-primary::before {
  content: '';
  position: absolute;
  right: 90rpx;
  top: -90rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(242, 176, 78, 0.10);
}

.tool-primary-left {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  max-width: 70%;
}

.tool-index {
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 14rpx;
}

.tool-primary-name {
  font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #fff;
  margin-bottom: 14rpx;
}

.tool-primary-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.7;
}

.tool-primary-right {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  z-index: 1;
}

.tool-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}

.icon-scan {
  width: 76rpx;
  height: 76rpx;
  background: #E8A44C;
}

.tool-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ===== 工具网格：自动换行，等高对齐 ===== */
.tools-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.tool-mini {
  width: calc((100% - 20rpx) / 2);
  height: 240rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 20rpx rgba(43, 29, 24, 0.05);
}

.tool-mini-hover {
  background: #FAF3E8;
  box-shadow: 0 8rpx 24rpx rgba(43, 29, 24, 0.10);
  transform: scale(0.985);
}

.tool-mini-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 62rpx;
}

.tool-icon-sm {
  width: 34rpx;
  height: 34rpx;
}

/* 文字徽标：新工具无需准备图片资源 */
.tool-badge {
  font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.tool-mini-title-row {
  margin-top: 20rpx;
}

.tool-mini-name {
  font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #2B1D18;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-mini-desc {
  font-size: 20rpx;
  color: #94817A;
  margin-top: 8rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.tool-mini-arrow {
  position: absolute;
  right: 22rpx;
  bottom: 20rpx;
  font-size: 32rpx;
  color: #B4BBC7;
  line-height: 1;
}

.vip-tag {
  background: #FFF3E0;
  color: #C8952C;
  font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 网格中普通工具卡的图标容器 */
.tools-grid .tool-icon-wrap {
  width: 62rpx;
  height: 62rpx;
}

/* ===== 底部收尾 ===== */
.home-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 56rpx;
  padding: 0 24rpx;
}

.home-footer-line {
  width: 64rpx;
  height: 2rpx;
  background: #D8C7B6;
}

.home-footer-text {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #B3A29A;
}
