.welcome-card {
    text-align: center;
  }
  
  .welcome-title {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    color: #0D1B2A;
    margin-bottom: 20rpx;
  }
  
  .welcome-desc {
    display: block;
    font-size: 28rpx;
    color: #666;
    margin-bottom: 40rpx;
  }
  
  .stats-content {
    display: flex;
    justify-content: space-around;
    margin-top: 30rpx;
  }
  
  .stat-item {
    text-align: center;
  }
  
  .stat-number {
    display: block;
    font-size: 60rpx;
    font-weight: bold;
    color: #3D8B7A;
    margin-bottom: 10rpx;
  }
  
  .stat-label {
    font-size: 26rpx;
    color: #666;
  }
  
  .features-title {
    display: block;
    font-size: 32rpx;
    font-weight: bold;
    color: #0D1B2A;
    margin-bottom: 30rpx;
  }
  
  .feature-item {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
  }
  
  .feature-icon {
    width: 60rpx;
    height: 60rpx;
    margin-right: 30rpx;
  }
  
  .feature-info {
    flex: 1;
  }
  
  .feature-name {
    display: block;
    font-size: 30rpx;
    font-weight: bold;
    color: #0D1B2A;
    margin-bottom: 10rpx;
  }
  
  .feature-desc {
    display: block;
    font-size: 24rpx;
    color: #999;
  }
