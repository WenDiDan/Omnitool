/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background: #F2F3F7;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== Hero Banner ===== */
.hero-card {
  margin: 24rpx 24rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #1a1a2e;
}

.hero-inner {
  padding: 40rpx 36rpx 36rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.hero-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.hero-icon {
  width: 44rpx;
  height: 44rpx;
}

.hero-text {
  flex: 1;
}

.hero-title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.btn-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #5B7FFF;
  border-radius: 20rpx;
  padding: 26rpx 0;
  width: 100%;
  border: none;
  box-sizing: border-box;
}

.btn-scan::after {
  border: none;
}

.btn-scan-icon {
  width: 36rpx;
  height: 36rpx;
}

.btn-scan-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* ===== 统计区 ===== */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.stat-icon-blue {
  background: #EBF0FF;
}

.stat-icon-teal {
  background: #E6F7F5;
}

.stat-icon {
  width: 30rpx;
  height: 30rpx;
}

.stat-number {
  font-size: 52rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* ===== 快速入口 ===== */
.section-title {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  padding: 28rpx 32rpx 16rpx;
}

.shortcut-grid {
  display: flex;
  gap: 20rpx;
  margin: 0 24rpx;
}

.shortcut-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.shortcut-item:active {
  background: #F5F7FF;
}

.shortcut-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.sc-scan {
  background: #5B7FFF;
}

.sc-decode {
  background: #13C2C2;
}

.sc-history {
  background: #52C41A;
}

.shortcut-icon {
  width: 40rpx;
  height: 40rpx;
}

.shortcut-name {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
}
