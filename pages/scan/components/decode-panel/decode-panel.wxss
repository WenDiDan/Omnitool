/* ===== 页面容器 ===== */
.decode-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F7E9D6 0%, #FBF6EC 420rpx);
  padding-bottom: 60rpx;
}

/* ===== 输入区域 ===== */
.input-section {
  padding: 24rpx 24rpx 0;
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2B1D18;
  letter-spacing: 1rpx;
}

.input-actions {
  display: flex;
  gap: 24rpx;
}

.input-action {
  font-size: 26rpx;
  color: #C0553D;
  transition: opacity 0.15s ease;
}

.input-action:active {
  opacity: 0.6;
}

.input-box {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 29, 24, 0.07);
  border: 2rpx solid rgba(192, 85, 61, 0.08);
}

.code-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #2B1D18;
  line-height: 1.6;
}

.type-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #CB5F47, #C0553D);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(192, 85, 61, 0.30);
}

.type-badge-text {
  font-size: 22rpx;
  color: #fff;
}

.decode-btn-area {
  margin-top: 20rpx;
}

.decode-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #CB5F47 0%, #C0553D 60%, #A8452F 100%);
  color: #fff;
  padding: 26rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 28rpx rgba(192, 85, 61, 0.32);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.decode-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.decode-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.decode-btn-text {
  color: #fff;
}

/* ===== 类型识别卡 ===== */
.result-section {
  margin-top: 20rpx;
}

.type-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 29, 24, 0.07);
}

.type-card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  overflow: hidden;
}

/* 根据类型动态背景色 */
.type-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #2B1D18;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.type-icon-box.type-ean,
.type-icon-box.type-barcode {
  background: #E07A5F;
}

.type-icon-box.type-qr {
  background: #C0553D;
}

.type-icon-box.type-url {
  background: #2F6C60;
}

.type-icon-box.type-wifi {
  background: #C8952C;
}

.type-icon-box.type-vcard {
  background: #8A5B2C;
}

.type-icon-box.type-tel {
  background: #B35A00;
}

.type-icon-box.type-email {
  background: #C0392B;
}

.type-icon-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 0;
}

.type-info {
  flex: 1;
  overflow: hidden;
}

.type-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2B1D18;
  display: block;
  margin-bottom: 6rpx;
}

.type-data {
  font-size: 24rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-valid {
  font-size: 24rpx;
  color: #fff;
  background: #2F6C60;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

.status-invalid {
  font-size: 24rpx;
  color: #fff;
  background: #C0392B;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

/* ===== 解码详情卡 ===== */
.detail-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(43, 29, 24, 0.04);
}

.detail-card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 16rpx;
  display: block;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--brand-line);
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  width: 150rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #2B1D18;
  flex: 1;
  word-break: break-all;
}

.detail-link {
  color: #C0553D;
  text-decoration: underline;
}

/* ===== 自定义规则结果（与扫码页/历史页保持同一视觉语言） ===== */
.custom-rule-row {
  background: rgba(242, 176, 78, 0.1);
  border-radius: 10rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.detail-label-wrap {
  width: 150rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
}

.detail-label-wrap .detail-label {
  width: auto;
}

.date-convert-tag {
  font-size: 18rpx;
  color: #B4741F;
  background: rgba(242, 176, 78, 0.2);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.highlight-value {
  color: #C0553D;
  font-weight: 600;
}

.raw-value {
  font-size: 22rpx;
  color: var(--text-4);
  padding: 4rpx 12rpx 12rpx;
}

.detail-copy-btn {
  font-size: 22rpx;
  color: #C0553D;
  padding: 4rpx 16rpx;
  background: #F3E7D8;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 编码转换卡 ===== */
.encode-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(43, 29, 24, 0.04);
  overflow: hidden;
}

.encode-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.encode-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B1D18;
}

.encode-toggle {
  font-size: 24rpx;
  color: #C0553D;
}

.encode-body {
  padding: 0 24rpx 24rpx;
}

.encode-row {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--brand-line);
}

.encode-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.encode-value {
  font-size: 24rpx;
  color: #2B1D18;
  word-break: break-all;
  line-height: 1.6;
  display: block;
}

.encode-copy {
  font-size: 22rpx;
  color: #C0553D;
  padding: 4rpx 16rpx;
  background: #F3E7D8;
  border-radius: 12rpx;
  display: inline-block;
  margin-top: 8rpx;
}

/* ===== 快捷操作 ===== */
.action-section {
  margin: 0 24rpx 16rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 16rpx;
  display: block;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(43, 29, 24, 0.04);
  min-width: 120rpx;
}

.action-btn:active {
  background: #F7EDE2;
}

.action-icon {
  /* 线稿图标比原实心图标视觉更轻，放大一档补回重量 */
  width: 42rpx;
  height: 42rpx;
}

/* 组件 WXSS 不允许标签选择器，文本用独立 class */
.action-label {
  font-size: 22rpx;
  color: #2B1D18;
}

/* ===== 更多工具 ===== */
.tools-section {
  margin: 0 24rpx 16rpx;
}

.tools-title {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
  padding-left: 4rpx;
}

.tools-grid {
  display: flex;
  gap: 16rpx;
}

.tool-card {
  width: 280rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(43, 29, 24, 0.04);
  position: relative;
  overflow: hidden;
}

.tool-vip-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 16rpx;
  background: #B35A00;
  color: #fff;
  font-size: 18rpx;
  font-weight: bold;
  border-radius: 0 20rpx 0 12rpx;
}

.tool-card:active {
  background: var(--surface-3);
}

.tool-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #2B1D18;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.tool-icon {
  width: 32rpx;
  height: 32rpx;
}

.tool-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B1D18;
  display: block;
  margin-bottom: 6rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #999;
}

/* ===== 二维码弹窗 ===== */
.qr-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 16, 12, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.qr-modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 30rpx;
}

.qr-modal-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--brand-line);
}

.qr-modal-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.qr-modal-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.qr-modal-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #C0553D;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.qr-modal-btn:active {
  opacity: 0.85;
}

.qr-modal-btn-outline {
  background: transparent;
  color: #2B1D18;
  border: 2rpx solid var(--brand-line);
}

/* ===== 弹窗通用 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 16, 12, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  background: #fff;
  border-radius: 28rpx;
  width: 600rpx;
  max-width: 90%;
  overflow: hidden;
  box-shadow: 0 24rpx 64rpx rgba(43, 29, 24, 0.2);
}

.login-modal {
  max-width: 560rpx;
}

.login-tip {
  padding: 40rpx 32rpx;
  text-align: center;
}

.login-tip-text {
  font-size: 30rpx;
  color: #2B1D18;
  line-height: 1.6;
}

.modal-header {
  padding: 36rpx 36rpx 0;
  display: flex;
  align-items: center;
}

.modal-accent-bar {
  width: 8rpx;
  height: 32rpx;
  background: #C0553D;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2B1D18;
}

/* ===== 资料设置弹窗 ===== */
.profile-edit-tip {
  padding: 20rpx 36rpx 0;
  background: linear-gradient(135deg, #F3E7D8 0%, #F7EDE2 100%);
  margin: 20rpx 36rpx 0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.profile-tip-text {
  font-size: 24rpx;
  color: #C0553D;
  line-height: 1.5;
}

.profile-edit-row {
  display: flex;
  align-items: center;
  padding: 24rpx 36rpx 0;
}

.profile-edit-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.profile-avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
  flex: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 16rpx;
  background: var(--surface-3);
}

.profile-avatar-hint {
  font-size: 26rpx;
  color: #C0553D;
}

.profile-nick-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2B1D18;
  background: var(--surface-2);
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin: 36rpx 36rpx 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-cancel {
  background: var(--surface-3);
  color: var(--text-2);
}

.modal-confirm {
  background: #C0553D;
  color: #fff;
}

/* ===== 统计看板 ===== */
.stats-section {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid rgba(239, 227, 213, 0.9);
  box-shadow: 0 6rpx 24rpx rgba(43, 29, 24, 0.06);
  overflow: hidden;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.stats-title-area {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stats-dot {
  width: 6rpx;
  height: 34rpx;
  background: #C0553D;
  border-radius: 3rpx;
}

.stats-heading {
  display: flex;
  flex-direction: column;
}

.stats-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2B1D18;
  letter-spacing: 1rpx;
}

.stats-sub {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.stats-toggle {
  font-size: 24rpx;
  color: #C0553D;
  padding-left: 16rpx;
}

.stats-body {
  padding: 0 24rpx 24rpx;
}

/* 主次指标：左侧大号今日，右侧辅助指标竖排 */
.stats-metrics {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 22rpx;
  background: linear-gradient(135deg, #FDF6EC 0%, #F7EADB 100%);
  border-radius: 18rpx;
}

.metric-primary {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.metric-label {
  font-size: 22rpx;
  color: #7D695F;
  letter-spacing: 1rpx;
}

.metric-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 6rpx;
}

.metric-value {
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 64rpx;
  font-weight: 700;
  color: #C0553D;
  line-height: 1;
}

.metric-unit {
  font-size: 22rpx;
  color: #A8452F;
}

.metric-secondary {
  width: 236rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-left: 2rpx solid rgba(192, 85, 61, 0.12);
  padding-left: 20rpx;
}

.metric-mini {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.metric-mini-label {
  font-size: 22rpx;
  color: #7D695F;
  flex-shrink: 0;
}

.metric-mini-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.metric-mini-value {
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 32rpx;
  font-weight: 700;
  color: #2B1D18;
}

.metric-mini-text {
  font-family: inherit;
  font-size: 24rpx;
  font-weight: 600;
  color: #2B1D18;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

.metric-mini-unit {
  font-size: 20rpx;
  color: var(--text-3);
}

.metric-mini-divider {
  height: 2rpx;
  background: rgba(192, 85, 61, 0.10);
  margin: 12rpx 0;
}

/* 区块标题行 */
.stats-block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 12rpx;
}

.stats-block-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #5C4A40;
  letter-spacing: 1rpx;
}

.stats-block-note {
  font-size: 20rpx;
  color: var(--text-4);
}

/* 类型分布：横向比例条 */
.type-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.type-row-name {
  width: 88rpx;
  font-size: 22rpx;
  color: #5C4A40;
  flex-shrink: 0;
}

.type-row-track {
  flex: 1;
  height: 14rpx;
  background: #F5EADC;
  border-radius: 999rpx;
  overflow: hidden;
}

.type-row-fill {
  height: 100%;
  min-width: 6rpx;
  background: linear-gradient(90deg, #E8A44C 0%, #C0553D 100%);
  border-radius: 999rpx;
}

.type-row-count {
  width: 60rpx;
  text-align: right;
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 22rpx;
  color: #2B1D18;
}

/* 趋势图 */
.stats-trend {
  position: relative;
  margin-top: 8rpx;
}

.stats-trend-canvas {
  width: 100%;
  height: 280rpx;
}

.stats-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 58%;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-4);
}
