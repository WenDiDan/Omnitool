/* ===== 历史记录页面 ===== */
page {
  background: var(--bg-page);
}

.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 20rpx 20rpx 30rpx;
}

/* ===== 头部 ===== */
.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2B1D18;
  letter-spacing: -1rpx;
}

.title-count-badge {
  background: #C0553D;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  display: flex;
  align-items: center;
}

.title-count {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.save-time {
  font-size: 22rpx;
  color: var(--text-4);
}

/* 保留天数提示条 */
.retention-bar {
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  background: rgba(192, 85, 61, 0.06);
  border-radius: 10rpx;
  border-left: 4rpx solid #C0553D;
}

.retention-text {
  font-size: 22rpx;
  color: #C0553D;
  font-weight: 500;
}

/* ===== 操作按钮行 ===== */
.header-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sort-label {
  font-size: 24rpx;
  color: var(--text-4);
  margin-right: 4rpx;
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #8A7970;
  background: #fff;
  transition: all 0.2s;
}

.sort-item.active {
  background: rgba(192, 85, 61, 0.12);
  color: #C0553D;
  font-weight: 600;
}

.sort-arrow {
  font-size: 22rpx;
}

/* 操作按钮容器 */
.action-btns {
  display: flex;
  gap: 16rpx;
}

.recycle-btn {
  padding: 12rpx 36rpx;
  background: rgba(196, 149, 106, 0.12);
  border-radius: var(--r-lg);
}

.recycle-btn-text {
  font-size: 26rpx;
  color: #C4956A;
  font-weight: 500;
}

.sync-btn {
  padding: 12rpx 36rpx;
  background: rgba(192, 85, 61, 0.1);
  border-radius: var(--r-lg);
}

.sync-btn-text {
  font-size: 26rpx;
  color: #C0553D;
  font-weight: 500;
}

.clear-btn {
  padding: 12rpx 36rpx;
  background: rgba(230, 57, 70, 0.1);
  border-radius: var(--r-lg);
}

.clear-btn-text {
  font-size: 26rpx;
  color: #C0392B;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 80rpx;
}

.empty-icon-wrap {
  margin-bottom: 36rpx;
}

.empty-circle-bg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(192, 85, 61, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed rgba(192, 85, 61, 0.25);
}

.empty-icon-inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 60rpx;
}

.empty-line {
  height: 8rpx;
  background: rgba(192, 85, 61, 0.35);
  border-radius: 4rpx;
  width: 100%;
}

.empty-line.short {
  width: 60%;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2B1D18;
  margin-bottom: 12rpx;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-4);
  margin-bottom: 48rpx;
  display: block;
}

.empty-btn {
  padding: 22rpx 72rpx;
  background: linear-gradient(135deg, #C0553D, #A8452F);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(192, 85, 61, 0.35);
}

.empty-btn-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 历史列表 ===== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 分页加载状态 */
.load-more {
  padding: 24rpx 0 12rpx;
  text-align: center;
}

.load-more-text {
  font-size: 22rpx;
  color: var(--text-4);
  letter-spacing: 1rpx;
}

.history-item {
  background: var(--surface);
  border: 2rpx solid var(--brand-line);
  border-radius: var(--r-md);
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.history-item:active {
  transform: translateY(-2rpx);
  border-color: #DFC7AB;
  box-shadow: var(--shadow-md);
}

/* 类型标签区 */
.item-type-wrap {
  margin-right: 14rpx;
  flex-shrink: 0;
}

.item-type-tag {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  min-width: 64rpx;
  text-align: center;
}

.item-type-text {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 类型颜色 */
.type-QR, .type-qr {
  background: rgba(192, 85, 61, 0.1);
}
.type-QR .item-type-text, .type-qr .item-type-text {
  color: #C0553D;
}

.type-EAN, .type-ean, .type-barcode, .type-UPC, .type-upc {
  background: rgba(232, 164, 76, 0.1);
}
.type-EAN .item-type-text, .type-ean .item-type-text,
.type-barcode .item-type-text, .type-UPC .item-type-text, .type-upc .item-type-text {
  color: #E8A44C;
}

.type-URL, .type-url {
  background: rgba(16, 185, 129, 0.1);
}
.type-URL .item-type-text, .type-url .item-type-text {
  color: #2F6C60;
}

.type-WiFi, .type-wifi {
  background: rgba(232, 164, 76, 0.14);
}
.type-WiFi .item-type-text, .type-wifi .item-type-text {
  color: #C8952C;
}

/* 默认 */
.item-type-tag {
  background: rgba(138, 121, 112, 0.10);
}
.item-type-text {
  color: var(--text-3);
}

/* 内容区 */
.item-center {
  flex: 1;
  overflow: hidden;
}

.item-code {
  display: block;
  font-family: var(--font-mono);
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: 0;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-time {
  font-size: 20rpx;
  color: var(--text-4);
  display: block;
}

/* 右侧箭头 */
.item-right {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.item-arrow-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-arrow {
  font-size: 28rpx;
  color: var(--text-4);
  line-height: 1;
}

/* ===== 详情覆盖层 ===== */
.result-inline {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 16, 12, 0.5);
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  box-sizing: border-box;
}

/* 详情内容卡片 - 统一宽度 */
.result-inline > .result-close-bar,
.result-inline > .result-code-section,
.result-inline > .result-detail,
.result-inline > .result-footer {
  width: 100%;
  max-width: 680rpx;
  box-sizing: border-box;
}

.result-inline > .result-close-bar {
  box-shadow: 0 -8rpx 32rpx rgba(43, 29, 24, 0.08);
}

/* 关闭按钮 - 融入卡片顶部 */
.result-close-bar {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 28rpx 0;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
}

.result-close-btn {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

/* 条码内容区域 */
.result-code-section {
  background: #fff;
  border-radius: 0;
  margin: 0;
  padding: 16rpx 32rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
  max-width: 680rpx;
}

.result-code-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.result-type-tag {
  font-size: 24rpx;
  color: white;
  background: #C0553D;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.result-scan-count {
  font-size: 20rpx;
  color: #C8952C;
  background: #FDF3E3;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.result-code-text {
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 30rpx;
  color: #2B1D18;
  font-weight: 600;
  word-break: break-all;
  line-height: 1.6;
  display: block;
  margin-bottom: 10rpx;
  padding: 18rpx 20rpx;
  background: #FAF6EE;
  border-left: 6rpx solid #C0553D;
  border-radius: 0 12rpx 12rpx 0;
  letter-spacing: 1rpx;
}

.result-code-time {
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
  display: block;
}

.result-code-source {
  font-size: 20rpx;
  color: var(--text-4);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  display: block;
}

/* 解码详情区域 */
.result-detail {
  background: #fff;
  border-radius: 0 0 20rpx 20rpx;
  margin: 0;
  padding: 4rpx 32rpx 24rpx;
  border-top: 2rpx solid var(--brand-line);
  width: 100%;
  box-sizing: border-box;
  max-width: 680rpx;
  max-height: 50vh;
  overflow-y: auto;
}

/* 底部按钮 */
.result-footer {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
  max-width: 680rpx;
  background: #fff;
  border-radius: 0 0 20rpx 20rpx;
}

.detail-section-title {
  font-size: 26rpx;
  color: #A8452F;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 8rpx 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #F3E7D8;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5ECE2;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 24rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
  width: 170rpx;
  flex-shrink: 0;
}

.detail-label-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.detail-label-wrap .detail-label {
  width: auto;
}

.detail-value {
  font-size: 26rpx;
  color: #2B1D18;
  font-weight: 500;
  line-height: 1.5;
  flex: 1;
  word-break: break-all;
}

.detail-value.valid {
  color: #C0553D;
  font-weight: 600;
}

.detail-value.invalid {
  color: #E07A5F;
  font-weight: 600;
}

.detail-link {
  color: #C0553D;
  text-decoration: underline;
}

.detail-copy {
  font-size: 24rpx;
  color: #C0553D;
  padding: 6rpx 20rpx;
  background: #F3E7D8;
  border-radius: 16rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.detail-structure {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FAF6EE;
  border-radius: 12rpx;
  border-left: 4rpx solid #C0553D;
}

.structure-label {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.structure-code {
  font-size: 26rpx;
  color: #2B1D18;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
}

.detail-copy:active {
  background: #F8E1D6;
}

.btn-copy, .btn-close {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  border-radius: 38rpx;
  text-align: center;
  padding: 0;
  margin: 0;
  font-weight: 500;
}

.btn-copy {
  background: #F5F5F0;
  color: #666;
}

.btn-close {
  background: linear-gradient(135deg, #C0553D, #A8452F);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(192, 85, 61, 0.3);
}

/* 自定义规则结果行 - 高亮样式 */
.custom-rule-row {
  background: linear-gradient(135deg, #FDF3E3 0%, #FDF3E3 100%);
  border-radius: 12rpx;
  padding: 16rpx 20rpx !important;
  margin: 12rpx 0;
  border: none !important;
  position: relative;
  overflow: hidden;
}

.custom-rule-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #E8A44C, #E8A44C);
}

.custom-rule-row .detail-label {
  color: #B35A00;
  font-weight: 600;
  font-size: 26rpx;
}

.custom-rule-row .detail-value {
  color: #C0392B;
  font-weight: 700;
  font-size: 30rpx;
}

.highlight-value {
  background: linear-gradient(135deg, #E8A44C 0%, #E8A44C 100%);
  color: white !important;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 700 !important;
  font-size: 32rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.3);
}

.date-convert-tag {
  display: inline-block;
  background: linear-gradient(135deg, #E8A44C, #E8A44C);
  color: white;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  vertical-align: middle;
  font-weight: 600;
}

.raw-value {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
