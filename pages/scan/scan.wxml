<view class="scan-container">
  <!-- 预览区域 -->
  <view class="preview-area" wx:if="{{showPreview}}">
    <camera id="camera" class="camera-preview" mode="scanCode" bindscancode="onScanCode" bindstop="onCameraStop" binderror="onCameraError" frame-size="medium" flash="{{flashOn ? 'torch' : 'off'}}"></camera>
    <view class="scan-area">
      <view class="scan-border">
        <view class="scan-corner top-left"></view>
        <view class="scan-corner top-right"></view>
        <view class="scan-corner bottom-left"></view>
        <view class="scan-corner bottom-right"></view>
        <view class="scan-line"></view>
      </view>
      <text class="scan-tip">将条码/二维码放入框内</text>
    </view>
    <view class="flash-control" bindtap="toggleFlash">
      <image class="flash-icon" src="/images/{{flashOn ? 'icon_flash_on_white' : 'icon_flash_off_white'}}.png" mode="aspectFit"/>
    </view>
    <view class="close-preview" bindtap="closePreview">
      <image class="close-icon" src="/images/icon_close_white.png" mode="aspectFit"/>
    </view>
  </view>

  <!-- 扫码按钮区域 -->
  <view class="scan-button-area" wx:if="{{!showPreview}}">
    <!-- 顶部标题 -->
    <view class="scan-header">
      <text class="scan-title">条码扫描</text>
      <text class="scan-subtitle">扫描二维码或条码</text>
    </view>
    
    <!-- 白色卡片面板 -->
    <view class="card-panel">
      <view class="card-grid">
        <view class="grid-card" bindtap="startScan">
          <image class="grid-icon" src="/images/icon_scan_white.png" mode="aspectFit"/>
          <text class="grid-title">单次扫码</text>
          <text class="grid-desc">拍照识别条码/二维码</text>
        </view>
        <view class="grid-card {{continuousMode ? 'grid-active' : ''}}" bindtap="toggleContinuous">
          <image class="grid-icon" src="/images/icon_camera_white.png" mode="aspectFit"/>
          <text class="grid-title">{{continuousMode ? '连续模式' : '连续扫码'}}</text>
          <text class="grid-desc">适合高频操作</text>
        </view>
        <view class="grid-card" bindtap="selectFromAlbum">
          <image class="grid-icon" src="/images/icon_album_white.png" mode="aspectFit"/>
          <text class="grid-title">图片解码</text>
          <text class="grid-desc">从相册识别条码</text>
        </view>
        <view class="grid-card" bindtap="goToHistory">
          <image class="grid-icon" src="/images/icon_history_white.png" mode="aspectFit"/>
          <text class="grid-title">扫码记录</text>
          <text class="grid-desc">{{recentScans.length > 0 ? '共' + recentScans.length + '条记录' : '暂无记录'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 增强版结果弹窗 -->
<view class="result-modal" wx:if="{{showResult}}" bindtap="closeResult">
  <view class="modal-content" catchtap="stopPropagation">
    <!-- 头部 -->
    <view class="modal-header">
      <view class="modal-type-tag">{{scanResult.type}}</view>
      <image class="modal-close" src="/images/icon_close.png" mode="aspectFit" bindtap="closeResult"/>
    </view>

    <!-- 条码内容 -->
    <view class="modal-code-section">
      <view class="modal-code-top">
        <text class="modal-code-text" selectable>{{scanResult.code}}</text>
        <text class="modal-scan-count" wx:if="{{scanResult.count > 1}}">第{{scanResult.count}}次扫描</text>
      </view>
      <text class="modal-code-time">{{scanResult.time}}</text>
      <text class="modal-code-source">来源: {{scanResult.wxScanType || scanResult.type}}</text>
    </view>

    <!-- 解码详情（始终显示） -->
    <view class="modal-detail">
      <!-- 标题：解码详情 -->
      <view class="detail-section-title">解码详情</view>
      
      <!-- EAN-13 / ISBN -->
      <block wx:if="{{decodedInfo.type == 'EAN-13' || decodedInfo.type == 'ISBN'}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">{{decodedInfo.type}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">国家/地区</text>
          <text class="detail-value">{{decodedInfo.country || '未知'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">厂商代码</text>
          <text class="detail-value">{{decodedInfo.manufacturerCode}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">产品代码</text>
          <text class="detail-value">{{decodedInfo.productCode}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">校验位</text>
          <text class="detail-value {{decodedInfo.valid ? 'valid' : 'invalid'}}">{{decodedInfo.checkDigit}} ({{decodedInfo.valid ? '有效' : '无效'}})</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">字符长度</text>
          <text class="detail-value">{{decodedInfo.length}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
        <view class="detail-structure">
          <text class="structure-label">条码结构：</text>
          <text class="structure-code">{{decodedInfo.countryCode || scanResult.code.substring(0,3)}} - {{decodedInfo.manufacturerCode}} - {{decodedInfo.productCode}} - {{decodedInfo.checkDigit}}</text>
        </view>
      </block>
      
      <!-- EAN-8 -->
      <block wx:if="{{decodedInfo.type == 'EAN-8'}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">EAN-8</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">国家代码</text>
          <text class="detail-value">{{decodedInfo.countryCode}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">产品代码</text>
          <text class="detail-value">{{decodedInfo.productCode}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">校验位</text>
          <text class="detail-value {{decodedInfo.valid ? 'valid' : 'invalid'}}">{{decodedInfo.checkDigit}} ({{decodedInfo.valid ? '有效' : '无效'}})</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">字符长度</text>
          <text class="detail-value">{{decodedInfo.length}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
        <view class="detail-structure">
          <text class="structure-label">条码结构：</text>
          <text class="structure-code">{{decodedInfo.countryCode}} - {{decodedInfo.productCode}} - {{decodedInfo.checkDigit}}</text>
        </view>
      </block>
      
      <!-- UPC-A -->
      <block wx:if="{{decodedInfo.type == 'UPC-A'}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">UPC-A</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">厂商代码</text>
          <text class="detail-value">{{decodedInfo.manufacturerCode}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">产品代码</text>
          <text class="detail-value">{{decodedInfo.productCode}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">校验位</text>
          <text class="detail-value {{decodedInfo.valid ? 'valid' : 'invalid'}}">{{decodedInfo.checkDigit}} ({{decodedInfo.valid ? '有效' : '无效'}})</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">字符长度</text>
          <text class="detail-value">{{decodedInfo.length}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>

      <!-- ISBN -->
      <block wx:if="{{decodedInfo.isbn && decodedInfo.type != 'EAN-13'}}">
        <view class="detail-row">
          <text class="detail-label">ISBN</text>
          <text class="detail-value">{{decodedInfo.isbn}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>

      <!-- URL -->
      <block wx:if="{{decodedInfo.domain}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">URL</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">域名</text>
          <text class="detail-value detail-link" bindtap="openUrl">{{decodedInfo.domain}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">完整链接</text>
          <text class="detail-value" selectable>{{decodedInfo.url}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>

      <!-- WiFi -->
      <block wx:if="{{decodedInfo.ssid}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">WiFi</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">网络名称</text>
          <text class="detail-value">{{decodedInfo.ssid}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">加密方式</text>
          <text class="detail-value">{{decodedInfo.encryption || '无'}}</text>
        </view>
        <view class="detail-row" wx:if="{{decodedInfo.password}}">
          <text class="detail-label">密码</text>
          <text class="detail-value">{{decodedInfo.password}}</text>
          <text class="detail-copy" bindtap="copyWifiPassword">复制</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>

      <!-- vCard -->
      <block wx:if="{{decodedInfo.vcardName}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">vCard名片</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">姓名</text>
          <text class="detail-value">{{decodedInfo.vcardName}}</text>
        </view>
        <view class="detail-row" wx:if="{{decodedInfo.vcardPhone}}">
          <text class="detail-label">电话</text>
          <text class="detail-value">{{decodedInfo.vcardPhone}}</text>
        </view>
        <view class="detail-row" wx:if="{{decodedInfo.vcardEmail}}">
          <text class="detail-label">邮箱</text>
          <text class="detail-value">{{decodedInfo.vcardEmail}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>

      <!-- 邮箱 -->
      <block wx:if="{{decodedInfo.email && !decodedInfo.vcardName}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">邮箱</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">邮箱地址</text>
          <text class="detail-value">{{decodedInfo.email}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>

      <!-- 电话 -->
      <block wx:if="{{decodedInfo.phone && !decodedInfo.vcardName}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">电话</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">电话号码</text>
          <text class="detail-value">{{decodedInfo.phone}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>

      <!-- 短信 -->
      <block wx:if="{{decodedInfo.smsPhone}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">短信</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">收件人</text>
          <text class="detail-value">{{decodedInfo.smsPhone}}</text>
        </view>
        <view class="detail-row" wx:if="{{decodedInfo.smsBody}}">
          <text class="detail-label">短信内容</text>
          <text class="detail-value">{{decodedInfo.smsBody}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>
      
      <!-- 数字条码 / 文本类型显示基础信息 -->
      <block wx:if="{{decodedInfo.type == '数字条码' || decodedInfo.type == '文本'}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">{{decodedInfo.type}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">字符长度</text>
          <text class="detail-value">{{decodedInfo.length}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>
      
      <!-- 通用：字符长度（兜底显示） -->
      <block wx:if="{{!decodedInfo.country && !decodedInfo.ssid && !decodedInfo.domain && decodedInfo.type != '数字条码' && decodedInfo.type != '文本' && decodedInfo.type != '电话' && decodedInfo.type != '邮箱' && decodedInfo.type != '短信' && !decodedInfo.vcardName}}">
        <view class="detail-row">
          <text class="detail-label">条码类型</text>
          <text class="detail-value">{{decodedInfo.type || scanResult.type}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">字符长度</text>
          <text class="detail-value">{{decodedInfo.length}}</text>
        </view>
        <!-- 自定义规则解析结果 - 高亮显示 -->
        <block wx:if="{{decodedInfo.customData}}">
          <view class="detail-row custom-rule-row">
            <view class="detail-label-wrap">
              <text class="detail-label">{{decodedInfo.customLabel || '自定义'}}</text>
              <text class="date-convert-tag" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].isDate}}">日期转换</text>
            </view>
            <text class="detail-value highlight-value">{{decodedInfo.customData}}</text>
          </view>
          <view class="raw-value" wx:if="{{decodedInfo.customRuleResults && decodedInfo.customRuleResults.length > 0 && decodedInfo.customRuleResults[0].rawValue && decodedInfo.customRuleResults[0].rawValue !== decodedInfo.customData}}">
            原始: {{decodedInfo.customRuleResults[0].rawValue}}
          </view>
        </block>
      </block>
    </view>

    <!-- 操作按钮 -->
    <view class="modal-footer">
      <button class="btn-copy" bindtap="copyResult">复制</button>
      <button class="btn-history" bindtap="goToHistory">历史记录</button>
      <button class="btn-continue" bindtap="continueScan">继续扫码</button>
    </view>
  </view>
</view>
