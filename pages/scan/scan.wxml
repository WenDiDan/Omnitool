<view class="hub-page">
  <view class="hub-body">
    <view class="hub-panel" hidden="{{activeTab !== 'scan'}}">
      <scan-panel id="scanPanel"></scan-panel>
    </view>
    <view class="hub-panel" hidden="{{activeTab !== 'decode'}}">
      <decode-panel id="decodePanel"></decode-panel>
    </view>
  </view>

  <!-- 页内底部导航：扫码 / 解码（样式对齐互助工具页） -->
  <view class="bottom-nav">
    <view class="nav-item {{activeTab === 'scan' ? 'nav-active' : ''}}" bindtap="onTabTap" data-tab="scan">扫码</view>
    <view class="nav-item {{activeTab === 'decode' ? 'nav-active' : ''}}" bindtap="onTabTap" data-tab="decode">解码</view>
  </view>
</view>
