<view class="hub-page">
  <view class="hub-body">
    <view class="hub-panel" hidden="{{activeTab !== 'scan'}}">
      <scan-panel id="scanPanel"></scan-panel>
    </view>
    <view class="hub-panel" hidden="{{activeTab !== 'decode'}}">
      <decode-panel id="decodePanel" active="{{activeTab === 'decode'}}"></decode-panel>
    </view>

    <!-- 设置页签：扫码设置 / 回收站统一入口 -->
    <view class="hub-panel" hidden="{{activeTab !== 'settings'}}">
      <view class="settings-page">
        <text class="settings-heading">设置</text>
        <view class="settings-card">
          <view class="settings-row" bindtap="goToSettings">
            <view class="settings-icon icon-settings-bg">
              <image class="settings-icon-img" src="/images/nav_settings_white.png" mode="aspectFit"/>
            </view>
            <view class="settings-text">
              <text class="settings-title">扫码设置</text>
              <text class="settings-desc">提示音、震动、自动复制与解码规则</text>
            </view>
            <text class="settings-arrow">›</text>
          </view>
          <view class="settings-row settings-row-last" bindtap="goToRecycleBin">
            <view class="settings-icon icon-recycle-bg">
              <image class="settings-icon-img" src="/images/ui_trash_white.png" mode="aspectFit"/>
            </view>
            <view class="settings-text">
              <text class="settings-title">回收站</text>
              <text class="settings-desc">已清空的扫码记录，可恢复或彻底删除</text>
            </view>
            <text class="settings-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 页内底部导航：扫码 / 解码 / 设置 -->
  <view class="bottom-nav">
    <view class="nav-item {{activeTab === 'scan' ? 'nav-active' : ''}}" bindtap="onTabTap" data-tab="scan">
      <image class="nav-icon" src="{{activeTab === 'scan' ? '/images/nav_scan_on.png' : '/images/nav_scan.png'}}" mode="aspectFit"/>
      <text class="nav-label">扫码</text>
    </view>
    <view class="nav-item {{activeTab === 'decode' ? 'nav-active' : ''}}" bindtap="onTabTap" data-tab="decode">
      <image class="nav-icon" src="{{activeTab === 'decode' ? '/images/nav_doc_on.png' : '/images/nav_doc.png'}}" mode="aspectFit"/>
      <text class="nav-label">解码</text>
    </view>
    <view class="nav-item {{activeTab === 'settings' ? 'nav-active' : ''}}" bindtap="onTabTap" data-tab="settings">
      <image class="nav-icon" src="{{activeTab === 'settings' ? '/images/nav_settings_on.png' : '/images/nav_settings.png'}}" mode="aspectFit"/>
      <text class="nav-label">设置</text>
    </view>
  </view>
</view>
