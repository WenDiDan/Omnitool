/* ===== 容器页（样式对齐互助工具页 pages/tool） ===== */
page {
  background: #FDF9F2;
}

.hub-page {
  min-height: 100vh;
  background: #FDF9F2;
}

/* 面板外层容器 */
.hub-panel {
  display: block;
}

/* 底部页内导航占位：面板内容不被固定导航遮挡 */
.hub-body {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 页内底部导航栏（同 tool 页 bottom-nav） ===== */
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  border-top: 2rpx solid #EFE3D5;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.nav-item {
  font-size: 26rpx;
  color: #8A766C;
  padding: 16rpx 64rpx;
  border-radius: 14rpx;
}

.nav-active {
  background: #F3DFCB;
  color: #C0553D;
  font-weight: 700;
}
