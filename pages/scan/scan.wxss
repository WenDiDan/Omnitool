/* 扫码按钮区域 */
.scan-button-area {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #0D1B2A 0%, #1B3A4B 40%, #3D8B7A 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  box-sizing: border-box;
  z-index: 50;
}

/* 顶部标题 */
.scan-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.scan-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.scan-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

/* 主扫码按钮 */
.scan-btn {
  width: 260rpx;
  height: 260rpx;
  border-radius: 130rpx;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 50rpx;
  animation: pulse 2.5s ease-in-out infinite;
}

.scan-btn:active {
  transform: scale(0.95);
}

.scan-btn-inner {
  width: 200rpx;
  height: 200rpx;
  background: #fff;
  border-radius: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(255,255,255,0.2);
  }
  50% {
    box-shadow: 0 0 0 20rpx rgba(255,255,255,0);
  }
}

.scan-icon {
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 10rpx;
}

.scan-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #0D1B2A;
}

/* 选项卡片 */
.scan-options {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.option-card {
  flex: 1;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(20px);
  border-radius: 20rpx;
  padding: 20rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.option-card:active {
  background: rgba(255,255,255,0.2);
}

.option-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.option-icon {
  width: 24rpx;
  height: 24rpx;
}

.option-text {
  font-size: 22rpx;
  color: #fff;
  text-align: center;
}

.option-active {
  background: rgba(61,139,122,0.4) !important;
  border: 1rpx solid rgba(61,139,122,0.6) !important;
}

.option-active .option-icon-wrap {
  background: rgba(61,139,122,0.5);
}
  
  /* 预览区域 */
  .preview-area {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100vh;
    background-color: #000;
    z-index: 100;
  }
  
  .camera-preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .scan-area {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 101;
  }
  
  .scan-border {
    position: relative;
    width: 500rpx;
    height: 500rpx;
  }
  
  .scan-border::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border: 4rpx solid rgba(255,255,255,0.3);
    border-radius: 16rpx;
  }
  
  .scan-corner {
    position: absolute;
    width: 80rpx;
    height: 80rpx;
    border-color: #fff;
    border-style: solid;
  }
  
  .top-left {
    top: 0;
    left: 0;
    border-top-width: 8rpx;
    border-left-width: 8rpx;
    border-top-left-radius: 16rpx;
  }
  
  .top-right {
    top: 0;
    right: 0;
    border-top-width: 8rpx;
    border-right-width: 8rpx;
    border-top-right-radius: 16rpx;
  }
  
  .bottom-left {
    bottom: 0;
    left: 0;
    border-bottom-width: 8rpx;
    border-left-width: 8rpx;
    border-bottom-left-radius: 16rpx;
  }
  
  .bottom-right {
    bottom: 0;
    right: 0;
    border-bottom-width: 8rpx;
    border-right-width: 8rpx;
    border-bottom-right-radius: 16rpx;
  }
  
  .scan-line {
    position: absolute;
    top: 0;
    left: 20rpx;
    right: 20rpx;
    height: 4rpx;
    background: linear-gradient(90deg, transparent, #fff, #3D8B7A, #fff, transparent);
    box-shadow: 0 0 20rpx rgba(61,139,122,0.5);
    animation: scan 2s ease-in-out infinite;
  }
  
  @keyframes scan {
    0%, 100% {
      top: 10rpx;
      opacity: 1;
    }
    50% {
      top: calc(100% - 14rpx);
      opacity: 0.8;
    }
  }
  
  .scan-tip {
    display: block;
    margin-top: 48rpx;
    color: rgba(255,255,255,0.9);
    font-size: 30rpx;
    text-align: center;
    text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  }
  
  .flash-control {
    position: absolute;
    bottom: 240rpx;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    padding: 24rpx 48rpx;
    border-radius: 60rpx;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    gap: 12rpx;
    z-index: 102;
    border: 1rpx solid rgba(255,255,255,0.2);
  }

  .flash-icon {
    width: 36rpx;
    height: 36rpx;
  }
  
  .close-preview {
    position: absolute;
    top: 100rpx;
    left: 32rpx;
    background: rgba(0, 0, 0, 0.6);
    padding: 20rpx 32rpx;
    border-radius: 60rpx;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    gap: 10rpx;
    z-index: 102;
    border: 1rpx solid rgba(255,255,255,0.2);
  }

  .close-icon {
    width: 32rpx;
    height: 32rpx;
  }
  
  /* 最近扫描记录 */
  .recent-scans {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 16rpx 24rpx;
    padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
    border-radius: 24rpx 24rpx 0 0;
    box-shadow: 0 -4rpx 20rpx rgba(13,27,42,0.08);
    z-index: 60;
    max-height: 35vh;
    display: flex;
    flex-direction: column;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    flex: 1;
    max-height: 28vh;
  }
  
  .recent-item {
    display: flex;
    align-items: center;
    padding: 12rpx 16rpx;
    background: linear-gradient(135deg, #FAFAF5, #F5F5EE);
    border-radius: 12rpx;
    border: 1rpx solid #F0EDE0;
    transition: all 0.2s ease;
  }
  
  .recent-item:active {
    background: linear-gradient(135deg, #F0EDE0, #E8E5D8);
    transform: scale(0.98);
    border-color: #D8D5C8;
  }
  
  .recent-icon-wrap {
    width: 44rpx;
    height: 44rpx;
    background: linear-gradient(135deg, #3D8B7A, #2D7A6A);
    border-radius: 22rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12rpx;
    box-shadow: 0 4rpx 12rpx rgba(61,139,122,0.25);
    flex-shrink: 0;
  }
  
  .recent-icon {
    width: 22rpx;
    height: 22rpx;
  }
  
  .recent-code {
    flex: 1;
    font-size: 24rpx;
    color: #0D1B2A;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .recent-type-tag {
    flex-shrink: 0;
    background: rgba(61,139,122,0.12);
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    margin-left: 12rpx;
  }
  
  .recent-type-tag text {
    font-size: 18rpx;
    color: #3D8B7A;
    font-weight: 500;
  }
  
  /* 结果弹窗 */
  .result-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(13,27,42,0.55);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal-content {
    width: 100%;
    background: white;
    border-radius: 28rpx 28rpx 0 0;
    overflow: hidden;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
  }
  
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 36rpx;
  }
  
  .modal-type-tag {
    font-size: 24rpx;
    color: white;
    background: #3D8B7A;
    padding: 8rpx 24rpx;
    border-radius: 20rpx;
    font-weight: 500;
  }
  
  .modal-close {
    width: 36rpx;
    height: 36rpx;
    padding: 10rpx;
  }
  
  /* 条码内容区域 */
  .modal-code-section {
    padding: 0 36rpx 24rpx;
    border-bottom: 1rpx solid #F0EDE0;
  }
  
  .modal-code-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16rpx;
  }
  
  .modal-code-text {
    font-size: 32rpx;
    color: #0D1B2A;
    font-weight: 600;
    word-break: break-all;
    line-height: 1.5;
    flex: 1;
  }
  
  .modal-scan-count {
    font-size: 20rpx;
    color: #E67E22;
    background: #FFF3E0;
    padding: 4rpx 12rpx;
    border-radius: 12rpx;
    white-space: nowrap;
  }
  
  .modal-code-time {
    font-size: 22rpx;
    color: #999;
    margin-top: 10rpx;
    display: block;
  }
  
  .modal-code-source {
    font-size: 20rpx;
    color: #666;
    margin-top: 8rpx;
    display: block;
  }
  
  /* 解码详情区域 */
  .modal-detail {
    padding: 20rpx 36rpx;
    max-height: 48vh;
    overflow-y: auto;
  }
  
  /* 解码详情标题 */
  .detail-section-title {
    font-size: 28rpx;
    color: #3D8B7A;
    font-weight: 600;
    margin-bottom: 16rpx;
    padding-bottom: 12rpx;
    border-bottom: 2rpx solid #EFF5F3;
  }
  
  .detail-row {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #F0EDE0;
  }
  
  .detail-row:last-child {
    border-bottom: none;
  }
  
  .detail-label {
    font-size: 26rpx;
    color: #999;
    width: 160rpx;
    flex-shrink: 0;
  }
  
  /* 标签容器 - 支持标签组合 */
  .detail-label-wrap {
    display: flex;
    align-items: center;
    gap: 12rpx;
    flex-shrink: 0;
  }
  
  .detail-label-wrap .detail-label {
    width: auto;
  }
  
  .detail-value {
    font-size: 26rpx;
    color: #0D1B2A;
    flex: 1;
    word-break: break-all;
  }
  
  .detail-value.valid {
    color: #3D8B7A;
    font-weight: 600;
  }
  
  .detail-value.invalid {
    color: #E07A5F;
    font-weight: 600;
  }
  
  .detail-link {
    color: #3D8B7A;
    text-decoration: underline;
  }
  
  .detail-copy {
    font-size: 24rpx;
    color: #3D8B7A;
    padding: 6rpx 20rpx;
    background: #EFF5F3;
    border-radius: 16rpx;
    margin-left: 16rpx;
    flex-shrink: 0;
  }
  
  /* 条码结构分析 */
  .detail-structure {
    margin-top: 16rpx;
    padding: 16rpx 20rpx;
    background: #F8F9FA;
    border-radius: 12rpx;
    border-left: 4rpx solid #3D8B7A;
  }
  
  .structure-label {
    font-size: 24rpx;
    color: #666;
    display: block;
    margin-bottom: 8rpx;
  }
  
  .structure-code {
    font-size: 26rpx;
    color: #0D1B2A;
    font-weight: 600;
    letter-spacing: 2rpx;
    display: block;
  }
  
  .detail-copy:active {
    background: #D5EDE8;
  }
  
  /* 底部按钮 */
  .modal-footer {
    display: flex;
    padding: 20rpx 32rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
    gap: 16rpx;
    border-top: 1rpx solid #F0EDE0;
  }
  
  .btn-copy, .btn-history, .btn-continue {
    flex: 1;
    height: 76rpx;
    line-height: 76rpx;
    font-size: 28rpx;
    border-radius: 38rpx;
    text-align: center;
    padding: 0;
    margin: 0;
    font-weight: 500;
  }
  
  .btn-copy {
    background: #F5F5F0;
    color: #666;
  }
  
  .btn-history {
    background: #E8F4F0;
    color: #3D8B7A;
  }
  
  .btn-continue {
    background: linear-gradient(135deg, #3D8B7A, #2D7A6A);
    color: white;
    box-shadow: 0 4rpx 16rpx rgba(61,139,122,0.3);
  }

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.recent-title-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recent-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0D1B2A;
}

.recent-count-badge {
  background: linear-gradient(135deg, #3D8B7A, #2D7A6A);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.recent-count-badge text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.recent-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recent-action-btn {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.recent-close-btn {
  background: #FFF5F0;
}

.recent-close-btn text {
  color: #E07A5F;
  font-weight: 500;
}

.recent-more-btn {
  background: #F0EDE0;
}

.recent-more-btn text {
  color: #0D1B2A;
  font-weight: 500;
}

.recent-closed-tip {
  position: fixed;
  bottom: 80rpx;
  left: 32rpx;
  right: 32rpx;
  background: rgba(13,27,42,0.9);
  backdrop-filter: blur(20px);
  padding: 24rpx 32rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #fff;
  font-size: 28rpx;
  z-index: 55;
}

.tip-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-icon {
  width: 28rpx;
  height: 28rpx;
}

.tip-arrow {
  font-size: 32rpx;
  opacity: 0.7;
}

.recent-closed-tip:active {
  background: rgba(13,27,42,0.95);
}

/* 自定义规则结果行 - 高亮样式 */
.custom-rule-row {
  background: linear-gradient(135deg, #FFF8E7 0%, #FFF3D6 100%);
  border-radius: 12rpx;
  padding: 16rpx 20rpx !important;
  margin: 12rpx 0;
  border: none !important;
  position: relative;
  overflow: hidden;
}

.custom-rule-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #FF9500, #FF6B00);
}

.custom-rule-row .detail-label {
  color: #B35A00;
  font-weight: 600;
  font-size: 26rpx;
}

.custom-rule-row .detail-value {
  color: #D4380D;
  font-weight: 700;
  font-size: 30rpx;
}

/* 高亮值 - 特殊强调 */
.highlight-value {
  background: linear-gradient(135deg, #FF9500 0%, #FF6B00 100%);
  color: white !important;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 700 !important;
  font-size: 32rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.3);
}

/* 日期转换标签 */
.date-convert-tag {
  display: inline-block;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: white;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  vertical-align: middle;
  font-weight: 600;
}

/* 原始值显示 */
.raw-value {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

