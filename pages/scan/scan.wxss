/* 扫码按钮区域 */
.scan-button-area {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(160deg, #0D1B2A 0%, #1B3A4B 60%, #3D8B7A 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .scan-btn {
    background: white;
    border-radius: 120rpx;
    padding: 50rpx 80rpx;
    text-align: center;
    box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.2);
    margin-bottom: 80rpx;
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0% {
      transform: scale(1);
      box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.2);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 30rpx 50rpx rgba(0, 0, 0, 0.3);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.2);
    }
  }
  
  .scan-icon {
    width: 120rpx;
    height: 120rpx;
    display: block;
    margin-bottom: 20rpx;
  }
  
  .scan-text {
    font-size: 36rpx;
    font-weight: bold;
    color: #0D1B2A;
  }
  
  .scan-options {
    display: flex;
    gap: 60rpx;
  }
  
  .option-item {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 60rpx;
    padding: 20rpx 40rpx;
    text-align: center;
    color: white;
  }
  
  .option-icon {
    width: 48rpx;
    height: 48rpx;
    display: block;
    margin-bottom: 10rpx;
  }
  
  .option-item text {
    font-size: 24rpx;
  }

  .option-active {
    background: rgba(61,139,122,0.5) !important;
    border: 1rpx solid #3D8B7A;
  }
  
  /* 预览区域 */
  .preview-area {
    position: relative;
    width: 100%;
    height: 100vh;
    background-color: #000;
  }
  
  .camera-preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .scan-area {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  
  .scan-border {
    position: relative;
    width: 500rpx;
    height: 500rpx;
    border: 2rpx solid rgba(255, 255, 255, 0.8);
  }
  
  .scan-corner {
    position: absolute;
    width: 60rpx;
    height: 60rpx;
    border-color: #3D8B7A;
    border-style: solid;
  }
  
  .top-left {
    top: -4rpx;
    left: -4rpx;
    border-top-width: 6rpx;
    border-left-width: 6rpx;
  }
  
  .top-right {
    top: -4rpx;
    right: -4rpx;
    border-top-width: 6rpx;
    border-right-width: 6rpx;
  }
  
  .bottom-left {
    bottom: -4rpx;
    left: -4rpx;
    border-bottom-width: 6rpx;
    border-left-width: 6rpx;
  }
  
  .bottom-right {
    bottom: -4rpx;
    right: -4rpx;
    border-bottom-width: 6rpx;
    border-right-width: 6rpx;
  }
  
  .scan-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4rpx;
    background: linear-gradient(90deg, transparent, #3D8B7A, transparent);
    animation: scan 2s linear infinite;
  }
  
  @keyframes scan {
    0% {
      top: 0;
    }
    100% {
      top: 100%;
    }
  }
  
  .scan-tip {
    display: block;
    margin-top: 40rpx;
    color: white;
    font-size: 28rpx;
    text-align: center;
  }
  
  .flash-control {
    position: absolute;
    bottom: 200rpx;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7);
    padding: 20rpx 40rpx;
    border-radius: 60rpx;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    gap: 10rpx;
  }

  .flash-icon {
    width: 32rpx;
    height: 32rpx;
  }
  
  .close-preview {
    position: absolute;
    top: 100rpx;
    right: 30rpx;
    background: rgba(0, 0, 0, 0.7);
    padding: 15rpx 30rpx;
    border-radius: 60rpx;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    gap: 8rpx;
  }

  .close-icon {
    width: 28rpx;
    height: 28rpx;
  }
  
  /* 最近扫描记录 */
  .recent-scans {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    padding: 30rpx;
    border-top-left-radius: 30rpx;
    border-top-right-radius: 30rpx;
  }

  .recent-list {
    white-space: nowrap;
  }
  
  .recent-item {
    display: inline-block;
    width: 200rpx;
    margin-right: 20rpx;
    text-align: center;
  }
  
  .recent-icon {
    width: 60rpx;
    height: 60rpx;
    display: block;
    margin-bottom: 12rpx;
  }
  
  .recent-code {
    display: block;
    font-size: 24rpx;
    color: #0D1B2A;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .recent-type {
    display: block;
    font-size: 20rpx;
    color: #999;
    margin-top: 8rpx;
  }
  
  /* 结果弹窗 */
  .result-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(13,27,42,0.55);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal-content {
    width: 100%;
    background: white;
    border-radius: 28rpx 28rpx 0 0;
    overflow: hidden;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
  }
  
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 36rpx;
  }
  
  .modal-type-tag {
    font-size: 24rpx;
    color: white;
    background: #3D8B7A;
    padding: 8rpx 24rpx;
    border-radius: 20rpx;
    font-weight: 500;
  }
  
  .modal-close {
    width: 36rpx;
    height: 36rpx;
    padding: 10rpx;
  }
  
  /* 条码内容区域 */
  .modal-code-section {
    padding: 0 36rpx 24rpx;
    border-bottom: 1rpx solid #F0EDE0;
  }
  
  .modal-code-text {
    font-size: 32rpx;
    color: #0D1B2A;
    font-weight: 600;
    word-break: break-all;
    line-height: 1.5;
    display: block;
  }
  
  .modal-code-time {
    font-size: 22rpx;
    color: #999;
    margin-top: 10rpx;
    display: block;
  }
  
  /* 解码详情区域 */
  .modal-detail {
    padding: 20rpx 36rpx;
    max-height: 40vh;
    overflow-y: auto;
  }
  
  .detail-row {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #F0EDE0;
  }
  
  .detail-row:last-child {
    border-bottom: none;
  }
  
  .detail-label {
    font-size: 26rpx;
    color: #999;
    width: 160rpx;
    flex-shrink: 0;
  }
  
  .detail-value {
    font-size: 26rpx;
    color: #0D1B2A;
    flex: 1;
    word-break: break-all;
  }
  
  .detail-value.valid {
    color: #3D8B7A;
    font-weight: 600;
  }
  
  .detail-value.invalid {
    color: #E07A5F;
    font-weight: 600;
  }
  
  .detail-link {
    color: #3D8B7A;
    text-decoration: underline;
  }
  
  .detail-copy {
    font-size: 24rpx;
    color: #3D8B7A;
    padding: 6rpx 20rpx;
    background: #EFF5F3;
    border-radius: 16rpx;
    margin-left: 16rpx;
    flex-shrink: 0;
  }
  
  .detail-copy:active {
    background: #D5EDE8;
  }
  
  /* 底部按钮 */
  .modal-footer {
    display: flex;
    padding: 24rpx 36rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    gap: 16rpx;
    border-top: 1rpx solid #F0EDE0;
  }
  
  .btn-copy, .btn-search, .btn-continue {
    flex: 1;
    height: 72rpx;
    line-height: 72rpx;
    font-size: 28rpx;
    border-radius: 36rpx;
    text-align: center;
    padding: 0;
    margin: 0;
  }
  
  .btn-copy {
    background: #F0EDE0;
    color: #6B6B6B;
  }
  
  .btn-search {
    background: #0D1B2A;
    color: white;
  }
  
  .btn-continue {
    background: #3D8B7A;
    color: white;
  }

.recent-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .recent-title-area {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .recent-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #0D1B2A;
  }
  
  .recent-count {
    font-size: 24rpx;
    color: #999;
  }
  
  .recent-actions {
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .recent-more {
    font-size: 26rpx;
    color: #3D8B7A;
  }
  
  .recent-close {
    font-size: 24rpx;
    color: #E07A5F;
    padding: 8rpx 16rpx;
    background: #FFF5F0;
    border-radius: 20rpx;
  }
  
  .recent-closed-tip {
    position: absolute;
    bottom: 30rpx;
    left: 30rpx;
    right: 30rpx;
    background: rgba(13,27,42,0.8);
    backdrop-filter: blur(10px);
    padding: 24rpx;
    border-radius: 60rpx;
    text-align: center;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10rpx;
  }

  .tip-icon {
    width: 32rpx;
    height: 32rpx;
  }
  
  .recent-closed-tip:active {
    background: rgba(13,27,42,0.95);
  }
