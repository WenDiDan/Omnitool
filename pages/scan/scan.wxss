/* 扫码按钮区域 */
.scan-button-area {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f5f6f7;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  z-index: 50;
}

/* 顶部标题 */
.scan-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.scan-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.scan-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 白色面板 */
.card-panel {
  background: #fff;
  border-radius: 28rpx;
  margin: 0 32rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  width: calc(100% - 64rpx);
  box-sizing: border-box;
}

/* 2x2 卡片网格 */
.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.grid-card {
  border-radius: 20rpx;
  padding: 28rpx 26rpx;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  transition: opacity 0.15s;
}

.grid-card:nth-child(1) { background: #60A5FA; }
.grid-card:nth-child(2) { background: #4ADE80; }
.grid-card:nth-child(3) { background: #FB923C; }
.grid-card:nth-child(4) { background: #C084FC; }

.grid-card:active {
  opacity: 0.85;
}

.grid-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 16rpx;
}

.grid-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  text-align: left;
  margin-bottom: 6rpx;
}

.grid-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  text-align: left;
}

/* 连续模式激活态 */
.grid-active {
  background: #A5D6A7 !important;
  border: 2rpx solid #2E7D32;
  box-shadow: 0 2rpx 12rpx rgba(46,125,50,0.18) !important;
}
  
  /* 预览区域 */
  .preview-area {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100vh;
    background-color: #000;
    z-index: 100;
  }
  
  .camera-preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .scan-area {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 101;
  }
  
  .scan-border {
    position: relative;
    width: 500rpx;
    height: 500rpx;
  }
  
  .scan-border::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border: 4rpx solid rgba(255,255,255,0.3);
    border-radius: 16rpx;
  }
  
  .scan-corner {
    position: absolute;
    width: 80rpx;
    height: 80rpx;
    border-color: #fff;
    border-style: solid;
  }
  
  .top-left {
    top: 0;
    left: 0;
    border-top-width: 8rpx;
    border-left-width: 8rpx;
    border-top-left-radius: 16rpx;
  }
  
  .top-right {
    top: 0;
    right: 0;
    border-top-width: 8rpx;
    border-right-width: 8rpx;
    border-top-right-radius: 16rpx;
  }
  
  .bottom-left {
    bottom: 0;
    left: 0;
    border-bottom-width: 8rpx;
    border-left-width: 8rpx;
    border-bottom-left-radius: 16rpx;
  }
  
  .bottom-right {
    bottom: 0;
    right: 0;
    border-bottom-width: 8rpx;
    border-right-width: 8rpx;
    border-bottom-right-radius: 16rpx;
  }
  
  .scan-line {
    position: absolute;
    top: 0;
    left: 20rpx;
    right: 20rpx;
    height: 4rpx;
    background: linear-gradient(90deg, transparent, #fff, #3D8B7A, #fff, transparent);
    box-shadow: 0 0 20rpx rgba(61,139,122,0.5);
    animation: scan 2s ease-in-out infinite;
  }
  
  @keyframes scan {
    0%, 100% {
      top: 10rpx;
      opacity: 1;
    }
    50% {
      top: calc(100% - 14rpx);
      opacity: 0.8;
    }
  }
  
  .scan-tip {
    display: block;
    margin-top: 48rpx;
    color: rgba(255,255,255,0.9);
    font-size: 30rpx;
    text-align: center;
    text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  }
  
  .flash-control {
    position: absolute;
    bottom: 240rpx;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    padding: 24rpx 48rpx;
    border-radius: 60rpx;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    gap: 12rpx;
    z-index: 102;
    border: 1rpx solid rgba(255,255,255,0.2);
  }

  .flash-icon {
    width: 36rpx;
    height: 36rpx;
  }
  
  .close-preview {
    position: absolute;
    top: 100rpx;
    left: 32rpx;
    background: rgba(0, 0, 0, 0.6);
    padding: 20rpx 32rpx;
    border-radius: 60rpx;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    gap: 10rpx;
    z-index: 102;
    border: 1rpx solid rgba(255,255,255,0.2);
  }

  .close-icon {
    width: 32rpx;
    height: 32rpx;
  }
  
  /* 结果弹窗 */
  .result-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(13,27,42,0.55);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal-content {
    width: 100%;
    background: white;
    border-radius: 28rpx 28rpx 0 0;
    overflow: hidden;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
  }
  
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 36rpx;
  }
  
  .modal-type-tag {
    font-size: 24rpx;
    color: white;
    background: #3D8B7A;
    padding: 8rpx 24rpx;
    border-radius: 20rpx;
    font-weight: 500;
  }
  
  .modal-close {
    width: 36rpx;
    height: 36rpx;
    padding: 10rpx;
  }
  
  /* 条码内容区域 */
  .modal-code-section {
    padding: 0 36rpx 24rpx;
    border-bottom: 1rpx solid #F0EDE0;
  }
  
  .modal-code-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16rpx;
  }
  
  .modal-code-text {
    font-size: 32rpx;
    color: #0D1B2A;
    font-weight: 600;
    word-break: break-all;
    line-height: 1.5;
    flex: 1;
  }
  
  .modal-scan-count {
    font-size: 20rpx;
    color: #E67E22;
    background: #FFF3E0;
    padding: 4rpx 12rpx;
    border-radius: 12rpx;
    white-space: nowrap;
  }
  
  .modal-code-time {
    font-size: 22rpx;
    color: #999;
    margin-top: 10rpx;
    display: block;
  }
  
  .modal-code-source {
    font-size: 20rpx;
    color: #666;
    margin-top: 8rpx;
    display: block;
  }
  
  /* 解码详情区域 */
  .modal-detail {
    padding: 20rpx 36rpx;
    max-height: 48vh;
    overflow-y: auto;
  }
  
  /* 解码详情标题 */
  .detail-section-title {
    font-size: 28rpx;
    color: #3D8B7A;
    font-weight: 600;
    margin-bottom: 16rpx;
    padding-bottom: 12rpx;
    border-bottom: 2rpx solid #EFF5F3;
  }
  
  .detail-row {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #F0EDE0;
  }
  
  .detail-row:last-child {
    border-bottom: none;
  }
  
  .detail-label {
    font-size: 26rpx;
    color: #999;
    width: 160rpx;
    flex-shrink: 0;
  }
  
  /* 标签容器 - 支持标签组合 */
  .detail-label-wrap {
    display: flex;
    align-items: center;
    gap: 12rpx;
    flex-shrink: 0;
  }
  
  .detail-label-wrap .detail-label {
    width: auto;
  }
  
  .detail-value {
    font-size: 26rpx;
    color: #0D1B2A;
    flex: 1;
    word-break: break-all;
  }
  
  .detail-value.valid {
    color: #3D8B7A;
    font-weight: 600;
  }
  
  .detail-value.invalid {
    color: #E07A5F;
    font-weight: 600;
  }
  
  .detail-link {
    color: #3D8B7A;
    text-decoration: underline;
  }
  
  .detail-copy {
    font-size: 24rpx;
    color: #3D8B7A;
    padding: 6rpx 20rpx;
    background: #EFF5F3;
    border-radius: 16rpx;
    margin-left: 16rpx;
    flex-shrink: 0;
  }
  
  /* 条码结构分析 */
  .detail-structure {
    margin-top: 16rpx;
    padding: 16rpx 20rpx;
    background: #F8F9FA;
    border-radius: 12rpx;
    border-left: 4rpx solid #3D8B7A;
  }
  
  .structure-label {
    font-size: 24rpx;
    color: #666;
    display: block;
    margin-bottom: 8rpx;
  }
  
  .structure-code {
    font-size: 26rpx;
    color: #0D1B2A;
    font-weight: 600;
    letter-spacing: 2rpx;
    display: block;
  }
  
  .detail-copy:active {
    background: #D5EDE8;
  }
  
  /* 底部按钮 */
  .modal-footer {
    display: flex;
    padding: 20rpx 32rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
    gap: 16rpx;
    border-top: 1rpx solid #F0EDE0;
  }
  
  .btn-copy, .btn-history, .btn-continue {
    flex: 1;
    height: 76rpx;
    line-height: 76rpx;
    font-size: 28rpx;
    border-radius: 38rpx;
    text-align: center;
    padding: 0;
    margin: 0;
    font-weight: 500;
  }
  
  .btn-copy {
    background: #F5F5F0;
    color: #666;
  }
  
  .btn-history {
    background: #E8F4F0;
    color: #3D8B7A;
  }
  
  .btn-continue {
    background: linear-gradient(135deg, #3D8B7A, #2D7A6A);
    color: white;
    box-shadow: 0 4rpx 16rpx rgba(61,139,122,0.3);
  }

/* 自定义规则结果行 - 高亮样式 */
.custom-rule-row {
  background: linear-gradient(135deg, #FFF8E7 0%, #FFF3D6 100%);
  border-radius: 12rpx;
  padding: 16rpx 20rpx !important;
  margin: 12rpx 0;
  border: none !important;
  position: relative;
  overflow: hidden;
}

.custom-rule-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #FF9500, #FF6B00);
}

.custom-rule-row .detail-label {
  color: #B35A00;
  font-weight: 600;
  font-size: 26rpx;
}

.custom-rule-row .detail-value {
  color: #D4380D;
  font-weight: 700;
  font-size: 30rpx;
}

/* 高亮值 - 特殊强调 */
.highlight-value {
  background: linear-gradient(135deg, #FF9500 0%, #FF6B00 100%);
  color: white !important;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 700 !important;
  font-size: 32rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.3);
}

/* 日期转换标签 */
.date-convert-tag {
  display: inline-block;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: white;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  vertical-align: middle;
  font-weight: 600;
}

/* 原始值显示 */
.raw-value {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

