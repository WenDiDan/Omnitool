/* ========================================
   二维码创建 - 暗色极简风格
   ======================================== */

.pg {
  min-height: 100vh;
  background: #0D1117;
  padding: 0 28rpx;
}

/* ===== Tab ===== */
.tabs {
  display: flex;
  padding: 28rpx 0 8rpx;
}
.tb {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #484F58;
  font-weight: 500;
  position: relative;
  transition: color 0.2s;
}
.tb.on {
  color: #F0F0F0;
  font-weight: 700;
}
.tb.on::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #FF5E3A;
}

/* ===== 输入区 ===== */
.input-box {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  background: #161B22;
  border-radius: 16rpx;
  border: 2rpx solid #21262D;
  overflow: hidden;
}

.txt {
  width: 100%;
  min-height: 280rpx;
  padding: 24rpx 24rpx 0;
  font-size: 30rpx;
  color: #F0F0F0;
  line-height: 1.7;
  box-sizing: border-box;
  background: transparent;
}
.ph {
  color: #3A4350;
  font-size: 28rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 18rpx;
  border-top: 1rpx solid #21262D;
  margin-top: 12rpx;
}
.ib-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #8B949E;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}
.ib-left:active {
  background: rgba(255,255,255,0.05);
}
.ib-icon {
  font-size: 24rpx;
}
.ib-count {
  font-size: 22rpx;
  color: #484F58;
}

/* ===== 生成按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: 28rpx 0 calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #484F58;
  background: #161B22;
  border: 2rpx solid #21262D;
  transition: all 0.2s;
}
.btn.go {
  color: #FFF;
  background: #FF5E3A;
  border-color: #FF5E3A;
}
.btn.loading {
  opacity: 0.6;
}

/* ===== 结果弹层 ===== */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  pointer-events: none;
}
.overlay.show {
  pointer-events: auto;
}
.mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.55);
  opacity: 0;
  transition: opacity 0.28s;
}
.show .mask {
  opacity: 1;
}
.sheet {
  width: 100%;
  max-height: 82vh;
  background: #161B22;
  border-radius: 24rpx 24rpx 0 0;
  padding: 48rpx 0 calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
  position: relative;
  z-index: 1;
}
.show .sheet {
  transform: translateY(0);
}

/* 关闭按钮 */
.sh-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  z-index: 2;
}
.sh-close:active {
  background: rgba(255,255,255,0.06);
}
.sh-close text {
  font-size: 30rpx;
  color: #8B949E;
}

/* QR 图片 */
.qr-box {
  display: flex;
  justify-content: center;
  padding: 0 40rpx 24rpx;
}
.qr-img {
  width: 380rpx;
  height: 380rpx;
  border-radius: 12rpx;
  background: #FFF;
}

/* 内容摘要 */
.info {
  margin: 0 32rpx 24rpx;
  padding: 18rpx 24rpx;
  background: #0D1117;
  border-radius: 12rpx;
}
.info-txt {
  font-size: 26rpx;
  color: #8B949E;
  line-height: 1.6;
  word-break: break-all;
  display: block;
}

/* 按钮组 */
.acts {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
}
.act {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.act:active {
  transform: scale(0.97);
}
.act.save {
  background: #FF5E3A;
  color: #FFF;
}
.act.retry {
  background: transparent;
  color: #8B949E;
  border: 2rpx solid #21262D;
}
