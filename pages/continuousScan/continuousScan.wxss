/* ==================== 页面容器 ==================== */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #F9F4EB;
}

/* ==================== 顶部栏 ==================== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.back-icon {
  font-size: 36rpx;
  color: #2B1D18;
  font-weight: bold;
}

.header-title {
  font-size: 32rpx;
  color: #2B1D18;
  font-weight: 600;
}

.scanning-dot {
  color: #C0553D;
  font-size: 20rpx;
  animation: blink-dot 1.2s ease-in-out infinite;
  line-height: 1;
}

@keyframes blink-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

.header-right {
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.header-action {
  font-size: 24rpx;
  color: #C0553D;
  padding: 10rpx 16rpx;
  font-weight: 500;
}

.header-clear {
  color: #FF4D4F;
}

/* ==================== 扫码记录区域 ==================== */
.record-area {
  flex: 1;
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.record-border {
  flex: 1;
  position: relative;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 400rpx;
}

.record-scroll-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
}

/* 记录列表 */
.record-list {
  flex: 1;
  height: 100%;
}

.record-item {
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  background: #fff;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:active {
  background: #FAFAFA;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.type-tag {
  font-size: 22rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.tag-default { background: #C0553D; }
.tag-QR_CODE { background: #C0553D; }
.tag-EAN_13 { background: #52C41A; }
.tag-EAN_8 { background: #52C41A; }
.tag-CODE_128 { background: #FF7A45; }
.tag-CODE_39 { background: #9254DE; }
.tag-CODE_93 { background: #13C2C2; }
.tag-CODABAR { background: #2B1D18; }
.tag-ITF { background: #FF4D4F; }
.tag-PDF417 { background: #FA8C16; }
.tag-AZTEC { background: #EB2F96; }
.tag-DATA_MATRIX { background: #2F54EB; }

.item-time {
  font-size: 22rpx;
  color: #999;
}

.item-code {
  font-size: 28rpx;
  color: #2B1D18;
  line-height: 1.5;
  display: block;
  word-break: break-all;
  margin-bottom: 14rpx;
}

.item-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  font-size: 22rpx;
  color: #C0553D;
  padding: 6rpx 24rpx;
  background: #F3E7D8;
  border-radius: 16rpx;
  border: none;
}

.action-open {
  color: #52C41A;
  background: #F0FFF0;
}

.action-toggle {
  color: #8C8C8C;
  background: #FAFAFA;
}

/* 展开状态高亮 */
.item-expanded {
  background: #FAFBFF !important;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
}

/* 计数栏 */
.count-bar {
  padding: 14rpx 0 4rpx;
  text-align: center;
}

.count-text {
  font-size: 24rpx;
  color: #999;
}

/* ==================== 底部扫码按钮区 ==================== */
.bottom-area {
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #F0F0F0;
}

.scan-btn {
  height: 96rpx;
  background: linear-gradient(135deg, #C0553D, #4A6FE0);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 127, 255, .35);
  transition: all .2s ease;
}

.scan-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.scan-btn.btn-active {
  background: #2B1D18;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, .35);
}

.scan-btn-icon {
  font-size: 36rpx;
}

.scan-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 4rpx;
}

/* ==================== 内联展开详情 ==================== */
.item-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3E7D8;
}

.item-detail .detail-code-box {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 14rpx;
}

.detail-code {
  font-size: 28rpx;
  color: #2B1D18;
  font-weight: 600;
  word-break: break-all;
  line-height: 1.6;
  display: block;
}

/* 高亮结果 */
.item-detail .detail-highlight {
  background: linear-gradient(135deg, #F3E7D8, #E0E6FF);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.highlight-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.highlight-value {
  font-size: 28rpx;
  color: #C0553D;
  font-weight: 700;
  word-break: break-all;
}

/* 信息行 */
.item-detail .detail-info-list {
  margin-bottom: 4rpx;
}

.d-info-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.d-label {
  font-size: 24rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.d-value {
  font-size: 24rpx;
  color: #2B1D18;
  flex: 1;
  word-break: break-all;
}

/* 底部操作按钮 */
.item-detail .detail-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.d-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
  text-align: center;
  font-weight: 500;
  padding: 0;
  margin: 0;
  background: none;
}

.d-copy::after { border: none; }
.d-url::after { border: none; }

.d-copy {
  background: #F5F5F5;
  color: #666;
}

.d-url {
  background: #F3E7D8;
  color: #C0553D;
}
