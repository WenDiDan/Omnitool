<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">←</text>
      <text class="header-title">连续扫码</text>
      <text wx:if="{{continuousActive}}" class="scanning-dot">●</text>
    </view>
    <view class="header-right" wx:if="{{scanList.length > 0}}">
      <text class="header-action" bindtap="copyAllList">整体复制</text>
      <text class="header-action" bindtap="exportList">导出</text>
      <text class="header-action header-clear" bindtap="clearAllList">清空</text>
    </view>
  </view>

  <!-- 扫码记录区域 -->
  <view class="record-area">
    <view class="record-border">
      <!-- 有记录时显示列表 -->
      <scroll-view class="record-list" scroll-y wx:if="{{scanList.length > 0}}">
        <view 
          class="record-item" 
          wx:for="{{scanList}}" 
          wx:key="index"
          bindtap="showDetail" 
          data-index="{{index}}"
        >
          <view class="item-row">
            <view class="type-tag {{item.typeColor || 'tag-default'}}">{{item.type}}</view>
            <text class="item-time">{{item.time}}</text>
          </view>
          <text class="item-code" selectable>{{item.code}}</text>
          <view class="item-actions">
            <view class="action-btn" catchtap="copyItem" data-index="{{index}}">
              <text>复制</text>
            </view>
            <view class="action-btn action-open" catchtap="openUrl" data-index="{{index}}" wx:if="{{item.isUrl}}">
              <text>打开</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无扫码记录</text>
        <text class="empty-hint">点击下方按钮开始持续扫描</text>
      </view>
    </view>

    <!-- 计数标签 -->
    <view class="count-bar" wx:if="{{scanList.length > 0}}">
      <text class="count-text">共 {{scanList.length}} 条记录{{continuousActive ? ' · 持续扫描中' : ''}}</text>
    </view>
  </view>

  <!-- 扫码按钮 -->
  <view class="bottom-area">
    <view 
      class="scan-btn {{continuousActive ? 'btn-active' : ''}}" 
      bindtap="toggleScan"
    >
      <text class="scan-btn-icon">{{continuousActive ? '⏹' : '📷'}}</text>
      <text class="scan-btn-text">{{continuousActive ? '停止扫码' : '扫码'}}</text>
    </view>
  </view>

  <!-- 详情弹窗 -->
  <view class="detail-mask" wx:if="{{showDetailPanel}}" catchtap="closeDetailPanel">
    <view class="detail-panel" catchtap="stopPropagation">
      <view class="detail-header">
        <view class="detail-type-tag">{{detailData.type}}</view>
        <text class="detail-close" bindtap="closeDetailPanel">✕</text>
      </view>
      <scroll-view class="detail-body" scroll-y>
        <view class="detail-code-box">
          <text class="detail-code" selectable>{{detailData.code}}</text>
        </view>
        
        <block wx:if="{{detailDecoded.customData}}">
          <view class="detail-highlight">
            <text class="highlight-label">{{detailDecoded.customLabel || '解析结果'}}</text>
            <text class="highlight-value">{{detailDecoded.customData}}</text>
          </view>
        </block>

        <view class="detail-info-list">
          <view class="d-info-row">
            <text class="d-label">字符长度</text>
            <text class="d-value">{{detailData.code.length}}</text>
          </view>
          <view class="d-info-row" wx:if="{{detailDecoded.country}}">
            <text class="d-label">国家/地区</text>
            <text class="d-value">{{detailDecoded.country}}</text>
          </view>
          <view class="d-info-row" wx:if="{{detailDecoded.domain}}">
            <text class="d-label">域名</text>
            <text class="d-value">{{detailDecoded.domain}}</text>
          </view>
          <view class="d-info-row">
            <text class="d-label">扫描时间</text>
            <text class="d-value">{{detailData.time}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="detail-footer">
        <button class="d-btn d-copy" bindtap="copyDetailCode">复制</button>
        <button class="d-btn d-url" bindtap="openDetailUrl" wx:if="{{detailData.isUrl}}">打开链接</button>
        <button class="d-btn d-deep" bindtap="goDeepDecode">深度解密</button>
      </view>
    </view>
  </view>
</view>
