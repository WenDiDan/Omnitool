.code-input {
    width: 100%;
    min-height: 200rpx;
    padding: 20rpx;
    border: 1rpx solid #e5e5e5;
    border-radius: 12rpx;
    margin-bottom: 30rpx;
    font-size: 28rpx;
  }
  
  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #e5e5e5;
  }
  
  .result-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .result-copy {
    font-size: 26rpx;
    color: #007aff;
  }
  
  .info-row {
    margin-bottom: 20rpx;
    line-height: 1.6;
  }
  
  .info-label {
    font-size: 28rpx;
    color: #666;
    margin-right: 20rpx;
  }
  
  .info-value {
    font-size: 28rpx;
    color: #333;
    word-break: break-all;
  }
  
  .valid {
    color: #34c759;
  }
  
  .invalid {
    color: #ff3b30;
  }