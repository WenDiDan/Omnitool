/* ===== 页面容器 ===== */
.decode-page {
  min-height: 100vh;
  background: #F2F3F7;
  padding-bottom: 60rpx;
}

/* ===== 输入区域 ===== */
.input-section {
  padding: 24rpx 24rpx 0;
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.input-actions {
  display: flex;
  gap: 24rpx;
}

.input-action {
  font-size: 26rpx;
  color: #5B7FFF;
}

.input-box {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.code-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.6;
}

.type-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #5B7FFF;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.type-badge-text {
  font-size: 22rpx;
  color: #fff;
}

.decode-btn-area {
  margin-top: 20rpx;
}

.decode-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #1a1a2e;
  color: #fff;
  padding: 26rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.decode-btn:active {
  opacity: 0.85;
}

.decode-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.decode-btn-text {
  color: #fff;
}

/* ===== 类型识别卡 ===== */
.result-section {
  margin-top: 20rpx;
}

.type-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.type-card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  overflow: hidden;
}

/* 根据类型动态背景色 */
.type-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.type-icon-box.type-ean,
.type-icon-box.type-barcode {
  background: #E07A5F;
}

.type-icon-box.type-qr {
  background: #5B7FFF;
}

.type-icon-box.type-url {
  background: #13C2C2;
}

.type-icon-box.type-wifi {
  background: #52C41A;
}

.type-icon-box.type-vcard {
  background: #9254DE;
}

.type-icon-box.type-tel {
  background: #FF7A45;
}

.type-icon-box.type-email {
  background: #EB2F96;
}

.type-icon-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 0;
}

.type-info {
  flex: 1;
  overflow: hidden;
}

.type-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
  display: block;
  margin-bottom: 6rpx;
}

.type-data {
  font-size: 24rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-valid {
  font-size: 24rpx;
  color: #fff;
  background: #52C41A;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

.status-invalid {
  font-size: 24rpx;
  color: #fff;
  background: #FF4D4F;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

/* ===== 解码详情卡 ===== */
.detail-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.detail-card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 16rpx;
  display: block;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  width: 150rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #1a1a2e;
  flex: 1;
  word-break: break-all;
}

.detail-link {
  color: #5B7FFF;
  text-decoration: underline;
}

.detail-copy-btn {
  font-size: 22rpx;
  color: #5B7FFF;
  padding: 4rpx 16rpx;
  background: #EBF0FF;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 编码转换卡 ===== */
.encode-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.encode-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.encode-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.encode-toggle {
  font-size: 24rpx;
  color: #5B7FFF;
}

.encode-body {
  padding: 0 24rpx 24rpx;
}

.encode-row {
  padding: 14rpx 0;
  border-top: 1rpx solid #F5F5F5;
}

.encode-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.encode-value {
  font-size: 24rpx;
  color: #1a1a2e;
  word-break: break-all;
  line-height: 1.6;
  display: block;
  /* 移除 max-height 截断，内容完整展示 */
}

.encode-copy {
  font-size: 22rpx;
  color: #5B7FFF;
  padding: 4rpx 16rpx;
  background: #EBF0FF;
  border-radius: 12rpx;
  display: inline-block;
  margin-top: 8rpx;
}

/* ===== 快捷操作 ===== */
.action-section {
  margin: 0 24rpx 16rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 16rpx;
  display: block;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  min-width: 120rpx;
}

.action-btn:active {
  background: #F5F7FF;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.action-btn text {
  font-size: 22rpx;
  color: #1a1a2e;
}

/* ===== 更多工具 ===== */
.tools-section {
  margin: 0 24rpx 16rpx;
}

.tools-title {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
  padding-left: 4rpx;
}

.tools-grid {
  display: flex;
  gap: 16rpx;
}

.tool-card {
  width: 280rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.tool-vip-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 16rpx;
  background: #FF7A45;
  color: #fff;
  font-size: 18rpx;
  font-weight: bold;
  border-radius: 0 20rpx 0 12rpx;
}

.tool-card:active {
  background: #F5F5F5;
}

.tool-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.tool-icon {
  width: 32rpx;
  height: 32rpx;
}

.tool-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
  display: block;
  margin-bottom: 6rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #999;
}

/* ===== 二维码弹窗 ===== */
.qr-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(13, 27, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.qr-modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 30rpx;
}

.qr-modal-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 12rpx;
  border: 2rpx solid #F0F0F0;
}

.qr-modal-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.qr-modal-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.qr-modal-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #5B7FFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.qr-modal-btn:active {
  opacity: 0.85;
}

.qr-modal-btn-outline {
  background: transparent;
  color: #1a1a2e;
  border: 2rpx solid #E0E0E0;
}

/* ===== 登录提示弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  background: #fff;
  border-radius: 28rpx;
  width: 600rpx;
  max-width: 90%;
  overflow: hidden;
  box-shadow: 0 24rpx 64rpx rgba(13, 27, 42, 0.2);
}

.login-modal {
  max-width: 560rpx;
}

.login-tip {
  padding: 40rpx 32rpx;
  text-align: center;
}

.login-tip-text {
  font-size: 30rpx;
  color: #1a1a2e;
  line-height: 1.6;
}

.modal-header {
  padding: 36rpx 36rpx 0;
  display: flex;
  align-items: center;
}

.modal-accent-bar {
  width: 8rpx;
  height: 32rpx;
  background: #5B7FFF;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a2e;
}

/* ===== 资料设置弹窗 ===== */
.profile-edit-tip {
  padding: 20rpx 36rpx 0;
  background: linear-gradient(135deg, #EBF0FF 0%, #F0F4FF 100%);
  margin: 20rpx 36rpx 0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.profile-tip-text {
  font-size: 24rpx;
  color: #5B7FFF;
  line-height: 1.5;
}

.profile-edit-row {
  display: flex;
  align-items: center;
  padding: 24rpx 36rpx 0;
}

.profile-edit-label {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.profile-avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
  flex: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 16rpx;
  background: #F0F0F0;
}

.profile-avatar-hint {
  font-size: 26rpx;
  color: #5B7FFF;
}

.profile-nick-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  background: #FAFAFA;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin: 36rpx 36rpx 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-cancel {
  background: #F0F0F0;
  color: #6B6B6B;
}

.modal-confirm {
  background: #5B7FFF;
  color: #fff;
}
