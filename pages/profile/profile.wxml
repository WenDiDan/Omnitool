<view class="page-wrap">
  <!-- 用户信息卡片 -->
  <view class="user-card reveal">
    <!-- 封禁提示 -->
    <view class="block-banner" wx:if="{{isLoggedIn && userInfo && userInfo.isBlocked}}">
      <image class="block-icon" src="/images/ui_info_white.png" mode="aspectFit"/>
      <text class="block-text">您的账号已被封禁，仅能登录，无法使用其他功能</text>
      <text class="block-reason" wx:if="{{userInfo.banReason}}">封禁原因：{{userInfo.banReason}}</text>
      <text class="block-reason" wx:if="{{userInfo.bannedAt}}">封禁时间：{{userInfo.bannedAt}}</text>
    </view>

    <!-- 已登录 -->
    <view class="user-header" bindtap="onEditProfile">
      <view class="avatar-box">
        <image class="avatar" src="{{avatarUrl || '/images/nav_user_white.png'}}" mode="aspectFill"/>
      </view>
      <view class="user-main">
        <view class="name-line">
          <text class="nick-name">{{nickName || '微信用户'}}</text>
          <view class="role-tag">{{roleLabel || '普通用户'}}</view>
        </view>
        <text class="profile-tip">点击头像完善个人资料</text>
      </view>
    </view>

    <!-- 会员信息 -->
    <view class="member-row">
      <view class="member-item">
        <text class="member-label">会员状态</text>
        <text class="member-value {{isAdmin ? 'member-admin' : (vipDaysLeft !== 0 ? 'member-vip' : '')}}">{{vipLabel || roleLabel}}</text>
      </view>
      <view class="member-divider"></view>
      <view class="member-item">
        <text class="member-label">到期时间</text>
        <text class="member-value {{vipDaysLeft === -1 ? 'member-permanent' : (vipDaysLeft > 0 ? 'member-active' : 'member-inactive')}}">{{vipDaysLeft === -1 ? '永久有效' : (vipExpiresDate || '未开通')}}</text>
      </view>
    </view>

    <!-- ID 信息 -->
    <view class="id-bar">
      <text class="id-text" bindtap="copyOpenid">用户ID：{{openidShort}}...（点击复制）</text>
    </view>
  </view>

  <!-- 更多服务 -->
  <view class="section reveal" style="animation-delay: 80ms">
    <view class="section-title">更多服务</view>
    <view class="menu-card">
      <view class="menu-row" bindtap="showAbout">
        <view class="menu-icon icon-clay">
          <image class="menu-icon-img" src="/images/ui_info_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-text">
          <text class="menu-title">当前版本</text>
          <text class="menu-desc">检查当前小程序版本和更新状态</text>
        </view>
        <view class="menu-right">
          <text class="version-text">V{{appVersion}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
      <view class="menu-row menu-row-btn">
        <view class="menu-icon icon-teal">
          <image class="menu-icon-img" src="/images/ui_edit_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-text">
          <text class="menu-title">分享好友</text>
          <text class="menu-desc">把这款工具推荐给团队伙伴或朋友</text>
        </view>
        <text class="menu-arrow">›</text>
        <button class="menu-btn-overlay" open-type="share"></button>
      </view>
      <view class="menu-row menu-row-btn menu-row-last">
        <view class="menu-icon icon-pink">
          <image class="menu-icon-img" src="/images/nav_user_white.png" mode="aspectFit"/>
        </view>
        <view class="menu-text">
          <text class="menu-title">联系客服</text>
          <text class="menu-desc">遇到问题可直接联系官方客服支持</text>
        </view>
        <text class="menu-arrow">›</text>
        <button class="menu-btn-overlay" open-type="contact"></button>
      </view>
    </view>
  </view>

  <!-- 管理功能 -->
  <view class="section reveal" wx:if="{{isAdmin}}" style="animation-delay: 140ms">
    <view class="section-title">管理功能</view>
    <view class="menu-card">
      <view class="menu-row" bindtap="goToToolConfig">
        <view class="menu-icon icon-amber">
          <image class="menu-icon-img" src="/images/icon_device.png" mode="aspectFit"/>
        </view>
        <view class="menu-text">
          <text class="menu-title">工具配置</text>
          <text class="menu-desc">名称、描述、排序与上下线</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row menu-row-last" bindtap="goToDataManage">
        <view class="menu-icon icon-pink">
          <image class="menu-icon-img" src="/images/icon_device.png" mode="aspectFit"/>
        </view>
        <view class="menu-text">
          <text class="menu-title">用户管理</text>
          <text class="menu-desc">角色、VIP 与保留天数管理</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="footer-gap"></view>

  <!-- 编辑资料弹窗 -->
  <view class="modal-mask" wx:if="{{showProfileModal}}" bindtap="closeProfileModal">
    <view class="modal-box" catchtap="stopTap">
      <view class="modal-header">
        <view class="modal-accent-bar"></view>
        <text class="modal-title">{{isFirstLogin ? '设置头像昵称' : '编辑资料'}}</text>
      </view>
      <view class="profile-edit-tip" wx:if="{{isFirstLogin}}">
        <text class="profile-tip-text">获取微信头像和昵称，提升个性化体验</text>
      </view>
      <view class="profile-edit-row">
        <text class="profile-edit-label">头像</text>
        <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onEditChooseAvatar">
          <image class="profile-avatar-preview" src="{{editAvatarUrl || '/images/nav_user_white.png'}}" mode="aspectFill"/>
          <text class="profile-avatar-hint">{{editAvatarUrl ? '更换' : '选择头像'}}</text>
        </button>
      </view>
      <view class="profile-edit-row">
        <text class="profile-edit-label">昵称</text>
        <input class="profile-nick-input" type="nickname" value="{{editNickName}}" placeholder="点击此处获取微信昵称" bindinput="onEditNickInput"/>
      </view>
      <view class="modal-btns">
        <view class="modal-btn modal-cancel" bindtap="closeProfileModal">{{isFirstLogin ? '跳过' : '取消'}}</view>
        <view class="modal-btn modal-confirm" bindtap="confirmProfile">保存</view>
      </view>
    </view>
  </view>
</view>
