/* ===== 页面容器 ===== */
.page-wrap {
  min-height: 100vh;
  background: var(--bg-page-grad);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 用户卡片 ===== */
.user-card {
  position: relative;
  overflow: hidden;
  /* 陶土色渐变卡面：让「我的」页也有一块有分量的颜色 */
  background: linear-gradient(158deg, #FFF8F1 0%, var(--surface-clay) 46%, #F6DACA 100%);
  border: 2rpx solid #EBCBB8;
  border-radius: var(--r-xl);
  margin: var(--sp-4) var(--sp-5) var(--sp-4);
  padding: calc(var(--sp-5) + 10rpx) var(--sp-4) var(--sp-5);
  box-shadow: 0 14rpx 34rpx rgba(192, 85, 61, 0.14);
}

/* 顶部品牌色带：与首页刊头同一套语言 */
.user-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-strong) 60%, #F5CFA0 100%);
}

/* 封禁提示 */
.block-banner {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background: linear-gradient(135deg, #D24548, #A8452F);
  border-radius: var(--r-md);
  padding: var(--sp-3) 20rpx;
  margin-bottom: var(--sp-4);
  box-shadow: 0 6rpx 16rpx rgba(210, 69, 72, 0.22);
}

.block-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: var(--sp-2);
  flex-shrink: 0;
}

.block-text {
  font-size: var(--fs-note);
  color: var(--text-invert);
  flex: 1;
  line-height: 1.4;
}

/* 用户头部 */
.user-header {
  display: flex;
  align-items: center;
}

.avatar-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C79B7B, #A97A57);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--sp-4);
  /* 双层描边：白色留白环 + 米棕细线，替代生硬的实心描边 */
  box-shadow: 0 0 0 4rpx var(--surface), 0 0 0 6rpx var(--brand-line);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.name-line {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-1);
}

.nick-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-right: var(--sp-3);
}

.role-tag {
  padding: 4rpx 16rpx;
  background: var(--brand-tint);
  border-radius: var(--r-full);
  font-size: var(--fs-tiny);
  color: var(--brand-primary);
  flex-shrink: 0;
}

.profile-tip {
  font-size: var(--fs-note);
  color: var(--text-4);
}

.login-btn-small {
  padding: 10rpx 26rpx;
  background: linear-gradient(135deg, #CB5F47, var(--brand-primary));
  border-radius: var(--r-full);
  font-size: var(--fs-note);
  color: var(--text-invert);
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(192, 85, 61, 0.22);
}

/* 会员信息：独立数据条，与上方身份区拉开层次 */
.member-row {
  display: flex;
  align-items: center;
  margin-top: var(--sp-5);
  padding: var(--sp-3) var(--sp-2);
  /* 半透明白：压在陶土卡面上形成"卡中卡"，比实色米底干净 */
  background: rgba(255, 255, 255, 0.70);
  border: 2rpx solid #EBCBB8;
  border-radius: var(--r-md);
}

.member-item {
  flex: 1;
  text-align: center;
}

.member-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--brand-line);
}

.member-label {
  display: block;
  font-size: var(--fs-tiny);
  color: var(--text-4);
  margin-bottom: var(--sp-1);
}

.member-value {
  font-size: var(--fs-h3);
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--font-mono);
}

.member-inactive {
  color: var(--text-4);
}

.member-permanent {
  color: var(--brand-green);
}

.member-admin {
  color: #C8952C;
}

.member-vip {
  color: var(--brand-primary);
}

.member-active {
  color: var(--brand-primary);
}

/* ID 行 */
.id-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-4);
  padding-top: var(--sp-4);
  border-top: 2rpx solid var(--brand-line);
}

.id-text {
  font-size: var(--fs-note);
  color: var(--text-4);
  font-family: var(--font-mono);
}

.upgrade-btn {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #EFAF5A, var(--brand-strong));
  border-radius: var(--r-full);
  font-size: var(--fs-note);
  color: var(--text-invert);
  font-weight: 700;
  flex-shrink: 0;
}

/* ===== 区域 ===== */
.section {
  margin: 0 var(--sp-5) var(--sp-4);
}

/* ===== 菜单卡片 ===== */
.menu-card {
  background: var(--surface);
  border: 2rpx solid var(--brand-line);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-row {
  display: flex;
  align-items: center;
  padding: var(--sp-4);
  position: relative;
}

.menu-row::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 108rpx;
  right: var(--sp-4);
  height: 2rpx;
  background: var(--brand-line);
}

.menu-row-last::after {
  display: none;
}

.menu-row:active {
  background: var(--surface-2);
}

/* 含透明 overlay button 的菜单行 */
.menu-row-btn {
  position: relative;
}

.menu-btn-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  z-index: 2;
}

.menu-btn-overlay::after {
  border: none;
}

.menu-btn-overlay:active {
  background: rgba(43, 29, 24, 0.04);
}

/* 菜单图标 */
.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--sp-4);
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(43, 29, 24, 0.12);
}

.menu-icon-img {
  /* 线稿图标比原实心图标视觉更轻，放大一档补回重量 */
  width: 42rpx;
  height: 42rpx;
}

/* 图标底色：全部取自暖纸色系，并压深一档保证白色图标可读 */
.icon-clay { background: linear-gradient(135deg, #C79B7B, #A97A57); }
.icon-teal { background: linear-gradient(135deg, #7FB3A6, #5C9585); }
.icon-amber { background: linear-gradient(135deg, #D4913A, #A85F28); }
.icon-pink { background: linear-gradient(135deg, #DD9A8D, #C4756A); }
.icon-red { background: linear-gradient(135deg, #C9695B, #B2503F); }
.icon-dark { background: linear-gradient(135deg, #3A2A20, #2B1D18); }

/* 菜单文字 */
.menu-text {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 700;
}

.menu-desc {
  display: block;
  font-size: var(--fs-tiny);
  color: var(--text-4);
  margin-top: 6rpx;
}

/* 菜单右侧 */
.menu-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.version-text {
  font-size: var(--fs-note);
  color: var(--text-4);
  margin-right: var(--sp-1);
  font-family: var(--font-mono);
}

.menu-arrow {
  font-size: 30rpx;
  color: var(--text-4);
  flex-shrink: 0;
}

/* 退出登录 */
.menu-row-logout .menu-title {
  color: var(--brand-primary-deep);
}

/* 底部留白 */
.footer-gap {
  height: var(--sp-6);
}

/* ===== 个人信息弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 16, 12, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 600rpx;
  background: var(--surface);
  border-radius: var(--r-xl);
  padding: var(--sp-6) var(--sp-6) var(--sp-5);
  box-shadow: var(--shadow-lg);
  box-sizing: border-box;
}

.modal-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.modal-accent-bar {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-primary);
  margin: 0 auto 20rpx;
}

.modal-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--text-1);
}

/* 弹窗内编辑行 */
.profile-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

/* 提示信息 */
.profile-edit-tip {
  background: var(--brand-tint-2);
  border-radius: var(--r-sm);
  padding: 20rpx var(--sp-4);
  margin-bottom: 28rpx;
}

.profile-tip-text {
  font-size: var(--fs-note);
  color: var(--brand-primary);
  line-height: 1.5;
}

.profile-edit-label {
  width: 80rpx;
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

/* 弹窗内头像按钮 */
.profile-avatar-btn {
  display: flex;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
  flex: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: var(--sp-3);
  background: var(--brand-tint);
}

.profile-avatar-hint {
  font-size: var(--fs-body);
  color: var(--brand-primary);
}

/* 弹窗内昵称输入 */
.profile-nick-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: var(--r-md);
  padding: 0 var(--sp-4);
  font-size: 28rpx;
  color: var(--text-1);
  background: var(--surface-2);
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--r-full);
  font-size: var(--fs-h3);
  font-weight: 700;
}

.modal-cancel {
  background: var(--brand-tint-2);
  color: var(--text-2);
}

.modal-confirm {
  background: linear-gradient(135deg, #CB5F47, var(--brand-primary));
  color: var(--text-invert);
  box-shadow: var(--shadow-brand);
}

.block-reason {
  width: 100%;
  margin-left: 40rpx;
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

/* 分区标题（若页面使用 .section-title，则采用全局细线小标题风格） */
.section .section-title {
  margin-bottom: var(--sp-3);
  padding-left: 2rpx;
}
