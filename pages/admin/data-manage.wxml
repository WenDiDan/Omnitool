<view class="page-wrap">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索用户ID或昵称" value="{{searchKey}}" bindinput="onSearchInput"/>
    <text class="search-btn" bindtap="onRefresh">刷新</text>
  </view>

  <!-- 角色统计卡（全量口径，点击可筛选列表） -->
  <view class="stat-cards">
    <view class="stat-card {{activeRole === 'admin' ? 'active' : ''}}" bindtap="tapStat" data-role="admin">
      <text class="stat-num">{{stats.admin}}</text>
      <text class="stat-label">管理员</text>
    </view>
    <view class="stat-card {{activeRole === 'vip' ? 'active' : ''}}" bindtap="tapStat" data-role="vip">
      <text class="stat-num stat-vip">{{stats.vip}}</text>
      <text class="stat-label">VIP</text>
    </view>
    <view class="stat-card {{activeRole === 'user' ? 'active' : ''}}" bindtap="tapStat" data-role="user">
      <text class="stat-num">{{stats.user}}</text>
      <text class="stat-label">用户</text>
    </view>
    <view class="stat-card {{activeRole === 'blocked' ? 'active' : ''}}" bindtap="tapStat" data-role="blocked">
      <text class="stat-num stat-blocked">{{stats.blocked}}</text>
      <text class="stat-label">封禁</text>
    </view>
  </view>

  <!-- 列表计数：先给总量，再看列表 -->
  <view class="list-caption">
    <text wx:if="{{activeRole}}" class="filter-chip" bindtap="clearRoleFilter">{{activeRoleLabel}} ✕</text>
    <text>共 {{total}} 位用户 · 已加载 {{users.length}} · 点击 ID 可复制</text>
  </view>

  <!-- 用户列表：触底加载下一页 -->
  <scroll-view class="user-list" scroll-y bindscrolltolower="loadMore" lower-threshold="80">
    <block wx:for="{{users}}" wx:key="openid">
      <view class="user-row {{item.role === 'blocked' ? 'row-blocked' : ''}}">
        <image class="user-avatar" src="{{item.avatarUrl || '/images/nav_user_white.png'}}" mode="aspectFill"/>
        <view class="user-meta">
          <view class="user-name-line">
            <text class="user-name">{{item.nickName || '未设置'}}</text>
            <text class="role-tag role-{{item.role}}">{{item.roleLabel}}</text>
            <text class="copy-link" bindtap="copyOpenid" data-openid="{{item.openid}}">复制</text>
          </view>
          <view class="user-id-line">
            <text class="id-label">ID:</text>
            <text class="user-id">{{item.openid}}</text>
          </view>
          <text class="user-sub">加入: {{item.joinedText || '—'}}{{item.vipText ? ' · ' + item.vipText : ''}}</text>
          <view class="user-sub sub-retain">
            <text class="retain-label">保留:</text>
            <text class="retain-value">{{item.retentionDays || item.historyRetentionDays || 3}} 天</text>
          </view>
        </view>
        <view class="user-side">
          <text class="side-btn btn-days" bindtap="showEdit" data-openid="{{item.openid}}">天数</text>
          <text class="side-btn btn-role" bindtap="showRoleEdit" data-openid="{{item.openid}}">角色</text>
          <text class="side-btn btn-del" wx:if="{{item.openid !== myOpenid}}" bindtap="confirmDelete" data-openid="{{item.openid}}">删除</text>
        </view>
      </view>
    </block>
    <view class="empty-tip" wx:if="{{users.length === 0}}">
      <text>{{searchKey ? '没有匹配的用户' : '暂无用户数据'}}</text>
    </view>
    <view class="load-more-tip" wx:if="{{users.length > 0}}">
      <text wx:if="{{loadingMore}}">加载中...</text>
      <text wx:elif="{{hasMore}}">上拉加载更多</text>
      <text wx:else>已全部加载</text>
    </view>
  </scroll-view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal">
    <view class="modal-box" catchtap="stopTap">
      <view class="modal-header">
        <view class="modal-accent"></view>
        <text class="modal-title">修改保留天数</text>
      </view>
      <view class="modal-body">
        <text class="modal-label">用户：{{editUser.nickName || editUser.openid || ''}}</text>
        <!-- VIP剩余天数（只读显示） -->
        <view class="modal-display-row" wx:if="{{editVipRemainDays > 0}}">
          <text class="modal-input-label">VIP剩余天数</text>
          <view class="modal-display-value">{{editVipRemainDays}}天</view>
        </view>
        <!-- 基础保留天数（可编辑） -->
        <view class="modal-input-row">
          <text class="modal-input-label">基础保留天数（1-36500）</text>
          <input class="modal-input" type="number" value="{{editDays}}" bindinput="onEditDaysInput" placeholder="输入天数"/>
        </view>
        <view class="modal-hint">
          <text>普通用户：实际保留天数=此值（默认3天）\nVIP用户：实际保留天数=此值与VIP剩余天数取大者；永久VIP=永久\n管理员：实际保留天数=此值（36500=永久）</text>
        </view>
      </view>
      <view class="modal-btns">
        <view class="modal-btn modal-cancel" bindtap="closeEditModal">取消</view>
        <view class="modal-btn modal-confirm" bindtap="saveRetention">保存</view>
      </view>
    </view>
  </view>
</view>
