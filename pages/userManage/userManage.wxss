/* 用户管理页面样式 */

.page-wrap {
  min-height: 100vh;
  background: #F4F1DE;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 头部区域 */
.header-section {
  position: relative;
  padding: 30rpx 30rpx 0;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 220rpx;
  background: linear-gradient(135deg, #0D1B2A 0%, #1D3557 50%, #3D8B7A 100%);
  border-radius: 0 0 40rpx 40rpx;
  z-index: 0;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 40rpx;
  background: rgba(61, 139, 122, 0.2);
  border-radius: 50%;
  filter: blur(20rpx);
}

.stats-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(13, 27, 42, 0.15);
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #0D1B2A;
  display: block;
  letter-spacing: -2rpx;
}

.stat-num.accent {
  color: #E9C46A;
  text-shadow: 0 2rpx 10rpx rgba(233, 196, 106, 0.4);
}

.stat-num.blocked {
  color: #E63946;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #3D8B7A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #888;
}

/* 用户列表 */
.user-list {
  padding: 30rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0D1B2A;
  letter-spacing: -1rpx;
}

.list-count {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
}

.user-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(13, 27, 42, 0.08);
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  transition: all 0.3s ease;
}

.user-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(13, 27, 42, 0.05);
}

.user-item.blocked {
  opacity: 0.6;
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
}

.user-item.admin {
  border-left: 6rpx solid #E63946;
}

.user-item.vip {
  border-left: 6rpx solid #E9C46A;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  margin-right: 28rpx;
}

.avatar-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e0e0e0 0%, #f0f0f0 100%);
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 20rpx rgba(13, 27, 42, 0.15);
}

/* 当前用户头像特殊边框 */
.current-user .avatar-img {
  border: 5rpx solid #3D8B7A;
  box-shadow: 0 0 0 6rpx rgba(61, 139, 122, 0.25), 0 6rpx 20rpx rgba(61, 139, 122, 0.3);
}

/* 当前用户卡片样式 */
.user-item.current-user {
  background: linear-gradient(135deg, #f0faf7 0%, #fff 100%);
  border: 2rpx solid #3D8B7A;
  box-shadow: 0 8rpx 30rpx rgba(61, 139, 122, 0.2);
}

.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
}

.role-dot-admin { background: #E63946; }
.role-dot-vip { background: #3D8B7A; }
.role-dot-user { background: #457B9D; }
.role-dot-blocked { background: #999; display: none; }

.user-detail {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D1B2A;
  margin-right: 16rpx;
}

.role-tag {
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.role-tag.role-admin { 
  background: linear-gradient(135deg, #FFE5E7 0%, #FFD0D5 100%); 
  color: #E63946; 
}
.role-tag.role-vip { 
  background: linear-gradient(135deg, #FFF8E7 0%, #FFE9C4 100%); 
  color: #B8860B;
  border: 1rpx solid rgba(233, 196, 106, 0.5);
}
.role-tag.role-user { 
  background: linear-gradient(135deg, #EDF4F8 0%, #E3EDF5 100%); 
  color: #457B9D; 
}
.role-tag.role-blocked { 
  background: #f0f0f0; 
  color: #888;
}

/* 本机标签 */
.current-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
  background: linear-gradient(135deg, #3D8B7A 0%, #2D6B5A 100%);
  border: 1rpx solid rgba(61, 139, 122, 0.3);
}

.current-tag-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.user-id-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  gap: 8rpx;
}

.user-id-label {
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
}

.user-id-value {
  font-size: 22rpx;
  color: #0D1B2A;
  font-weight: 500;
  letter-spacing: 1rpx;
  font-family: Monaco, Menlo, Consolas, monospace;
  word-break: break-all;
  flex: 1;
  min-width: 200rpx;
}

.user-id-copy {
  font-size: 20rpx;
  color: #3D8B7A;
  flex-shrink: 0;
}

.user-meta {
  font-size: 22rpx;
  color: #999;
}

.user-actions {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-row {
  width: 100%;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #3D8B7A 0%, #2D6B5A 100%);
  box-shadow: 0 2rpx 8rpx rgba(61, 139, 122, 0.25);
  transition: all 0.2s ease;
  min-width: 90rpx;
}

.action-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(61, 139, 122, 0.2);
}

.action-btn.admin { 
  background: linear-gradient(135deg, #E63946 0%, #D32F3F 100%);
  box-shadow: 0 4rpx 12rpx rgba(230, 57, 70, 0.3);
}
.action-btn.admin:active {
  box-shadow: 0 2rpx 6rpx rgba(230, 57, 70, 0.2);
}
.action-btn.vip { 
  background: linear-gradient(135deg, #E9C46A 0%, #D4A84B 100%);
  box-shadow: 0 4rpx 12rpx rgba(233, 196, 106, 0.3);
}
.action-btn.blocked { 
  background: #9CA3AF;
  box-shadow: none;
}
.action-btn.self { 
  background: linear-gradient(135deg, #3D8B7A 0%, #2D6B5A 100%);
  box-shadow: 0 4rpx 12rpx rgba(61, 139, 122, 0.3);
}

.action-text {
  font-size: 22rpx;
  color: #fff;
}

.action-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
  vertical-align: middle;
}

.delete-btn .action-icon {
  filter: drop-shadow(0 1rpx 2rpx rgba(0,0,0,0.2));
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
  position: relative;
}

.empty-icon-img {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 1;
  opacity: 0.6;
}

.empty-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%);
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(61, 139, 122, 0.1) 0%, rgba(61, 139, 122, 0.05) 100%);
  border: 4rpx dashed rgba(61, 139, 122, 0.2);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: translate(-50%, -60%) scale(1); opacity: 0.5; }
  50% { transform: translate(-50%, -60%) scale(1.05); opacity: 0.8; }
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0D1B2A;
  margin-bottom: 16rpx;
  letter-spacing: -1rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #6B7280;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #bbb;
}

/* 删除按钮 */
.delete-btn {
  position: relative;
  background: linear-gradient(135deg, #E63946 0%, #B71C1C 100%);
  box-shadow: 0 4rpx 16rpx rgba(230, 57, 70, 0.4);
  border: none;
  overflow: hidden;
}

.delete-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s ease;
}

.delete-btn:active::before {
  left: 100%;
}

.delete-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(230, 57, 70, 0.3);
  background: linear-gradient(135deg, #C62828 0%, #9A1010 100%);
}

/* ===== 删除确认弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(13, 27, 42, 0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-box {
  width: 580rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(13, 27, 42, 0.25);
  animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from { transform: scale(0.85); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx 24rpx;
}

.modal-accent-bar {
  width: 8rpx;
  height: 40rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
}

.modal-accent-bar.danger {
  background: linear-gradient(180deg, #E63946 0%, #C62828 100%);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0D1B2A;
  letter-spacing: -1rpx;
}

.modal-body {
  padding: 20rpx 36rpx 36rpx;
  text-align: center;
}

.delete-tip {
  font-size: 30rpx;
  color: #4B5563;
  line-height: 1.6;
}

.delete-nickname {
  font-size: 36rpx;
  font-weight: 800;
  color: #E63946;
  margin: 0 8rpx;
}

.modal-btns {
  display: flex;
  gap: 24rpx;
  padding: 0 36rpx 36rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.modal-cancel {
  background: #F4F1DE;
  color: #6B7280;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.modal-cancel:active {
  background: #EBE8D8;
  transform: scale(0.98);
}

.modal-confirm {
  background: linear-gradient(135deg, #E63946 0%, #C62828 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(230, 57, 70, 0.4);
}

.modal-confirm:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(230, 57, 70, 0.3);
}

/* 弹窗图标 */
.modal-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.modal-icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE5E7 0%, #FFD0D5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(230, 57, 70, 0.3);
  animation: shake 0.5s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}

.modal-icon {
  width: 56rpx;
  height: 56rpx;
}

.delete-warn {
  display: block;
  font-size: 26rpx;
  color: #E63946;
  margin-top: 16rpx;
  font-weight: 500;
}
