/* 用户管理页面样式 */

.page-wrap {
  min-height: 100vh;
  background: #F4F1DE;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 头部区域 */
.header-section {
  position: relative;
  padding: 30rpx 30rpx 0;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #0D1B2A 0%, #1B3A4B 100%);
  border-radius: 0 0 40rpx 40rpx;
  z-index: 0;
}

.stats-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #0D1B2A;
  display: block;
}

.stat-num.accent {
  color: #3D8B7A;
}

.stat-num.blocked {
  color: #E63946;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #3D8B7A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #888;
}

/* 用户列表 */
.user-list {
  padding: 30rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D1B2A;
}

.list-count {
  font-size: 26rpx;
  color: #888;
}

.user-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-item.blocked {
  opacity: 0.7;
  background: #f8f8f8;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-right: 24rpx;
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e0e0e0;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 当前用户头像特殊边框 */
.current-user .avatar-img {
  border-color: #3D8B7A;
  box-shadow: 0 0 0 4rpx rgba(61, 139, 122, 0.3);
}

/* 当前用户卡片样式 */
.user-item.current-user {
  background: linear-gradient(135deg, #f8fff9 0%, #fff 100%);
  border: 2rpx solid #3D8B7A;
}

.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
}

.role-dot-admin { background: #E63946; }
.role-dot-vip { background: #3D8B7A; }
.role-dot-user { background: #457B9D; }
.role-dot-blocked { background: #999; display: none; }

.user-detail {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D1B2A;
  margin-right: 16rpx;
}

.role-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.role-tag.role-admin { background: #FFE5E7; color: #E63946; }
.role-tag.role-vip { background: #E8F5F3; color: #3D8B7A; }
.role-tag.role-user { background: #EDF4F8; color: #457B9D; }
.role-tag.role-blocked { background: #f0f0f0; color: #999; }

/* 本机标签 */
.current-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
  background: linear-gradient(135deg, #3D8B7A 0%, #2D6B5A 100%);
  border: 1rpx solid rgba(61, 139, 122, 0.3);
}

.current-tag-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.user-id-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  gap: 8rpx;
}

.user-id-label {
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
}

.user-id-value {
  font-size: 22rpx;
  color: #0D1B2A;
  font-weight: 500;
  letter-spacing: 1rpx;
  font-family: Monaco, Menlo, Consolas, monospace;
  word-break: break-all;
  flex: 1;
  min-width: 200rpx;
}

.user-id-copy {
  font-size: 20rpx;
  color: #3D8B7A;
  flex-shrink: 0;
}

.user-meta {
  font-size: 22rpx;
  color: #999;
}

.user-actions {
  margin-left: 20rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #3D8B7A;
}

.action-btn.admin { background: #E63946; }
.action-btn.vip { background: #3D8B7A; }
.action-btn.blocked { background: #999; }
.action-btn.self { 
  background: linear-gradient(135deg, #3D8B7A 0%, #2D6B5A 100%);
  cursor: default;
}

.action-text {
  font-size: 24rpx;
  color: #fff;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #0D1B2A;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #888;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #bbb;
}
