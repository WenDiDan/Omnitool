
var subStr = function (val, start, stop) {
    if (val) { return val.substring(start, stop)} 
    else {
      return ''
    }
  }
  var start=15;
  var stop=16;
  var subDate = function (val) {
    if (val) {return val.substring(start, stop)}
    else { return ''}
  }
  var subDate1 = function (val) {
    if (val) {return val.substring(16, 17)}

    else {return ''}
  }
  var subDate2 = function (val) {
    if (val) {
      return val.length(1,2)
    } else  {
      return ''
    }
  }
  var convertTo = function (rec1) {
      eveng=rec1.toString();
    if (eveng === A ) {
        return '空'
      } else  
      {
        return 'W'
      }
  }




     module.exports = {
       subStr: subStr,
       subDate: subDate,
       subDate1: subDate1,
       subDate2:subDate2,
       start:start,
       stop:stop,
       convertTo:convertTo,

};