.regcode-page {
  min-height: 100vh;
  background: #F9F4EB;
  padding-bottom: 40rpx;
}

/* ===== 权限拦截 ===== */
.permission-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 0 64rpx;
}

.permission-loading {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EAECF0;
  border-top-color: #C0553D;
  border-radius: 50%;
  animation: perm-spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes perm-spin {
  to { transform: rotate(360deg); }
}

.permission-loading-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.permission-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(91, 127, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.permission-lock-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #C0553D;
}

.permission-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 16rpx;
}

.permission-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.permission-btn {
  padding: 20rpx 80rpx;
  background: linear-gradient(135deg, #C0553D, #3D5FD9);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 20rpx rgba(91, 127, 255, 0.3);
}

/* ===== 模式切换 ===== */
.mode-tabs {
  display: flex;
  margin: 24rpx 24rpx 0;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #9CA3AF;
  position: relative;
}

.mode-tab text {
  position: relative;
  z-index: 1;
}

.tab-active {
  color: white;
  font-weight: bold;
}

.tab-active::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  background: linear-gradient(135deg, #C0553D, #3D5FD9);
  border-radius: 12rpx;
}

/* ===== 输入区域 ===== */
.input-section {
  padding: 24rpx;
}

.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 12rpx;
  display: block;
}

.input-row {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 88rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #2B1D18;
  height: 100%;
}

.input-clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.35;
}

.input-hint {
  font-size: 24rpx;
  color: #E63946;
  margin-top: 8rpx;
  display: block;
}

/* 日期 */
.date-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.date-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 88rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.date-text {
  font-size: 30rpx;
  color: #2B1D18;
}

.date-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.35;
}

.date-today {
  font-size: 26rpx;
  color: #C0553D;
  background: rgba(91, 127, 255, 0.1);
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  font-weight: 500;
}

/* 按钮 */
.generate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #C0553D, #3D5FD9);
  color: white;
  padding: 28rpx;
  border-radius: 20rpx;
  margin-top: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 127, 255, 0.35);
}

.generate-btn:active {
  opacity: 0.85;
}

.gen-icon {
  width: 40rpx;
  height: 40rpx;
}

.gen-text {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

/* ===== 注册码结果 ===== */
.result-section {
  padding: 0 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2B1D18;
}

.result-copy-all {
  font-size: 26rpx;
  color: #C0553D;
  padding: 8rpx 24rpx;
  background: rgba(91, 127, 255, 0.1);
  border-radius: 20rpx;
  font-weight: 500;
}

.codes-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.code-card {
  width: calc(50% - 8rpx);
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
}

.code-index {
  font-size: 22rpx;
  color: #9CA3AF;
  display: block;
  margin-bottom: 8rpx;
}

.code-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2B1D18;
  font-family: 'Menlo', 'Consolas', monospace;
  display: block;
}

.code-copy {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(91, 127, 255, 0.08);
  border-radius: 12rpx;
}

.code-copy:active {
  background: rgba(91, 127, 255, 0.18);
}

.code-copy-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

/* ===== 生成参数 ===== */
.params-card {
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.params-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.params-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #2B1D18;
}

.params-toggle {
  font-size: 24rpx;
  color: #C0553D;
}

.params-body {
  padding: 0 24rpx 20rpx;
  border-top: 1rpx solid #EAECF0;
}

.param-row {
  display: flex;
  padding: 12rpx 0;
}

.param-label {
  font-size: 24rpx;
  color: #9CA3AF;
  width: 160rpx;
  flex-shrink: 0;
}

.param-value {
  font-size: 24rpx;
  color: #2B1D18;
  flex: 1;
  word-break: break-all;
  font-family: 'Menlo', 'Consolas', monospace;
}

/* ===== 解析模式输入 ===== */
.parse-box {
  position: relative;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.parse-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  color: #2B1D18;
  font-family: 'Menlo', 'Consolas', monospace;
  line-height: 1.8;
}

.parse-box-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 12rpx;
}

.parse-action {
  font-size: 26rpx;
  color: #C0553D;
  font-weight: 500;
}

/* ===== 校验状态卡 ===== */
.verify-card {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.verify-valid {
  background: rgba(16, 185, 129, 0.1);
}

.verify-invalid {
  background: rgba(230, 57, 70, 0.1);
}

.verify-status {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}

.verify-valid .verify-status {
  color: #059669;
}

.verify-invalid .verify-status {
  color: #E63946;
}

.verify-desc {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* ===== 详情卡 ===== */
.detail-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.detail-card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 16rpx;
  display: block;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F9F4EB;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #9CA3AF;
  width: 200rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #2B1D18;
  flex: 1;
  font-family: 'Menlo', 'Consolas', monospace;
}

.detail-value.highlight {
  font-weight: bold;
  color: #C0553D;
  font-size: 32rpx;
}

.text-valid {
  color: #059669;
  font-weight: bold;
}

.text-invalid {
  color: #E63946;
  font-weight: bold;
}

.parse-copy-area {
  margin-top: 10rpx;
}
