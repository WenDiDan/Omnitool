<view class="browser-page">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <image class="nav-back-icon" src="/images/icon_close_white.png" mode="aspectFit"/>
    </view>
    <view class="nav-url-box">
      <image class="nav-lock" src="/images/icon_info.png" mode="aspectFit"/>
      <text class="nav-url-text">{{displayUrl}}</text>
    </view>
    <view class="nav-action" bindtap="showActions">
      <image class="nav-more-icon" src="/images/icon_settings_white.png" mode="aspectFit"/>
    </view>
  </view>

  <!-- 加载进度条 -->
  <view class="progress-bar" wx:if="{{loading}}">
    <view class="progress-fill"></view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-area" wx:if="{{loading}}">
    <view class="loading-anim">
      <view class="loading-dot dot1"></view>
      <view class="loading-dot dot2"></view>
      <view class="loading-dot dot3"></view>
    </view>
    <text class="loading-text">正在获取页面内容</text>
  </view>

  <!-- 错误提示 -->
  <view class="error-area" wx:if="{{error}}">
    <view class="error-visual">
      <view class="error-circle">
        <text class="error-mark">!</text>
      </view>
    </view>
    <text class="error-title">无法加载</text>
    <text class="error-msg">{{errorMsg}}</text>
    <view class="error-actions">
      <view class="error-btn" bindtap="retry">
        <image class="error-btn-icon" src="/images/icon_scan_white.png" mode="aspectFit"/>
        <text>重新加载</text>
      </view>
      <view class="error-btn error-btn-outline" bindtap="copyUrl">
        <image class="error-btn-icon" src="/images/icon_album_white.png" mode="aspectFit"/>
        <text>复制链接</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果模式 -->
  <scroll-view scroll-y class="content-scroll" wx:if="{{!loading && !error && isSearch && items.length > 0}}" enhanced show-scrollbar="{{false}}">
    <view class="search-header">
      <text class="search-keyword">搜索: {{searchKeyword}}</text>
      <text class="search-count">约 {{items.length}} 条结果</text>
    </view>
    <view class="search-list">
      <view class="search-card" wx:for="{{items}}" wx:key="index" bindtap="openLink" data-url="{{item.link}}">
        <view class="search-card-header">
          <text class="search-card-index">{{index + 1}}</text>
          <text class="search-card-title">{{item.title}}</text>
        </view>
        <text class="search-card-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        <view class="search-card-link" wx:if="{{item.link}}">
          <image class="search-link-icon" src="/images/icon_info.png" mode="aspectFit"/>
          <text class="search-link-text">{{item.link}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 文章阅读模式 -->
  <scroll-view scroll-y class="content-scroll" wx:if="{{!loading && !error && !isSearch && paragraphs.length > 0}}" enhanced show-scrollbar="{{false}}">
    <view class="article-header" wx:if="{{title}}">
      <text class="article-title">{{title}}</text>
      <view class="article-meta">
        <image class="article-meta-icon" src="/images/icon_info.png" mode="aspectFit"/>
        <text class="article-meta-text">{{displayUrl}}</text>
      </view>
    </view>

    <!-- 文章图片 -->
    <view class="article-images" wx:if="{{images.length > 0}}">
      <image class="article-image" wx:for="{{images}}" wx:key="index" src="{{item.src}}" mode="widthFix" bindtap="previewImage" data-src="{{item.src}}"/>
    </view>

    <!-- 文章段落 -->
    <view class="article-body">
      <block wx:for="{{paragraphs}}" wx:key="index">
        <view class="para-heading" wx:if="{{item.type === 'heading'}}">
          <text class="heading-h{{item.level}}">{{item.text}}</text>
        </view>
        <view class="para-quote" wx:elif="{{item.type === 'quote'}}">
          <view class="quote-bar"></view>
          <text class="quote-text">{{item.text}}</text>
        </view>
        <view class="para-code" wx:elif="{{item.type === 'code'}}">
          <text class="code-text">{{item.text}}</text>
        </view>
        <view class="para-listitem" wx:elif="{{item.type === 'listitem'}}">
          <view class="list-dot"></view>
          <text class="list-text">{{item.text}}</text>
        </view>
        <text class="para-text" wx:else>{{item.text}}</text>
      </block>
    </view>
  </scroll-view>

  <!-- 空内容 -->
  <view class="empty-area" wx:if="{{!loading && !error && !isSearch && paragraphs.length === 0 && !(items.length > 0)}}">
    <view class="empty-visual">
      <view class="empty-doc">
        <view class="doc-line"></view>
        <view class="doc-line short"></view>
        <view class="doc-line"></view>
        <view class="doc-line short"></view>
      </view>
    </view>
    <text class="empty-title">未能提取内容</text>
    <text class="empty-desc">该页面可能需要JavaScript渲染</text>
    <view class="empty-actions">
      <view class="empty-btn" bindtap="copyUrl">复制链接到浏览器打开</view>
    </view>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-bar" wx:if="{{!loading}}">
    <view class="bottom-btn" bindtap="goBack">
      <image class="bottom-icon" src="/images/icon_close_white.png" mode="aspectFit"/>
      <text class="bottom-label">返回</text>
    </view>
    <view class="bottom-btn" bindtap="copyUrl">
      <image class="bottom-icon" src="/images/icon_album_white.png" mode="aspectFit"/>
      <text class="bottom-label">复制</text>
    </view>
    <view class="bottom-btn" bindtap="refreshPage">
      <image class="bottom-icon" src="/images/icon_scan_white.png" mode="aspectFit"/>
      <text class="bottom-label">刷新</text>
    </view>
  </view>
</view>
