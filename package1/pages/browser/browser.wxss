.browser-container {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  .browser-header {
    padding: 20rpx;
    background: white;
    border-bottom: 1rpx solid #e5e5e5;
  }
  
  .header-actions {
    display: flex;
    margin-bottom: 20rpx;
  }
  
  .action-btn {
    font-size: 40rpx;
    margin-right: 30rpx;
    color: #007aff;
  }
  
  .url-input {
    width: 100%;
    height: 70rpx;
    padding: 0 20rpx;
    background: #f5f5f5;
    border-radius: 12rpx;
    font-size: 28rpx;
  }
  
  .webview {
    flex: 1;
  }