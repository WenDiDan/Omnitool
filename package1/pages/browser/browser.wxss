.browser-page {
  min-height: 100vh;
  background: #F9F4EB;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

/* ===== 顶部导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #1a2a4a;
  gap: 16rpx;
}

.nav-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-back:active {
  background: rgba(255,255,255,0.1);
}

.nav-back-icon {
  width: 28rpx;
  height: 28rpx;
}

.nav-url-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.1);
  border-radius: 32rpx;
  padding: 10rpx 20rpx;
  gap: 10rpx;
}

.nav-lock {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.5;
}

.nav-url-text {
  flex: 1;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-action {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-action:active {
  background: rgba(255,255,255,0.1);
}

.nav-more-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 4rpx;
  background: rgba(91, 127, 255, 0.1);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  width: 40%;
  background: linear-gradient(90deg, #C0553D, #818CF8);
  animation: progress 1.5s ease-in-out infinite;
}

@keyframes progress {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(350%); }
}

/* ===== 加载状态 ===== */
.loading-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-anim {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C0553D;
  animation: dotBounce 1.4s ease-in-out infinite;
}

.dot1 { animation-delay: 0s; }
.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1.2);
    opacity: 1;
  }
}

.loading-text {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* ===== 错误提示 ===== */
.error-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.error-visual {
  margin-bottom: 30rpx;
}

.error-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(230, 57, 70, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-mark {
  font-size: 52rpx;
  font-weight: bold;
  color: #E63946;
}

.error-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 12rpx;
}

.error-msg {
  font-size: 26rpx;
  color: #9CA3AF;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 50rpx;
  max-width: 500rpx;
}

.error-actions {
  display: flex;
  gap: 24rpx;
}

.error-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 36rpx;
  background: linear-gradient(135deg, #C0553D, #3D5FD9);
  color: white;
  font-size: 26rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(91, 127, 255, 0.3);
}

.error-btn:active {
  opacity: 0.8;
}

.error-btn-outline {
  background: transparent;
  color: #C0553D;
  border: 2rpx solid #C0553D;
  box-shadow: none;
}

.error-btn-icon {
  width: 24rpx;
  height: 24rpx;
}

/* ===== 搜索结果 ===== */
.content-scroll {
  flex: 1;
  height: calc(100vh - 180rpx);
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx 16rpx;
}

.search-keyword {
  font-size: 26rpx;
  color: #2B1D18;
  font-weight: 600;
}

.search-count {
  font-size: 22rpx;
  color: #9CA3AF;
}

.search-list {
  padding: 0 24rpx;
}

.search-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.search-card:active {
  background: #f8f9ff;
}

.search-card-header {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.search-card-index {
  font-size: 24rpx;
  font-weight: bold;
  color: #C0553D;
  min-width: 32rpx;
  margin-top: 2rpx;
}

.search-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2B1D18;
  line-height: 1.5;
  flex: 1;
}

.search-card-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  margin-left: 46rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-card-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 46rpx;
  margin-top: 14rpx;
}

.search-link-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.4;
}

.search-link-text {
  font-size: 20rpx;
  color: #9CA3AF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

/* ===== 文章阅读模式 ===== */
.article-header {
  padding: 36rpx 30rpx 24rpx;
  border-bottom: 1rpx solid #EAECF0;
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2B1D18;
  line-height: 1.4;
  display: block;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.article-meta-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.4;
}

.article-meta-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.article-images {
  padding: 20rpx 30rpx 0;
}

.article-image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.article-body {
  padding: 24rpx 30rpx;
}

.para-heading {
  margin-top: 36rpx;
  margin-bottom: 16rpx;
}

.heading-h1 {
  font-size: 36rpx;
  font-weight: bold;
  color: #2B1D18;
}

.heading-h2 {
  font-size: 34rpx;
  font-weight: bold;
  color: #2B1D18;
}

.heading-h3 {
  font-size: 32rpx;
  font-weight: 600;
  color: #A8452F;
}

.heading-h4, .heading-h5, .heading-h6 {
  font-size: 30rpx;
  font-weight: 600;
  color: #A8452F;
}

.para-quote {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
  padding: 20rpx 0;
}

.quote-bar {
  width: 6rpx;
  background: #C0553D;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.quote-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  font-style: italic;
}

.para-code {
  background: #1a2a4a;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 20rpx 0;
  overflow-x: auto;
}

.code-text {
  font-size: 24rpx;
  color: #818CF8;
  font-family: monospace;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.para-listitem {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 10rpx 0;
}

.list-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #C0553D;
  margin-top: 18rpx;
  flex-shrink: 0;
}

.list-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  flex: 1;
}

.para-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.9;
  margin: 12rpx 0;
  display: block;
  text-align: justify;
}

/* ===== 空内容 ===== */
.empty-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
}

.empty-visual {
  margin-bottom: 30rpx;
}

.empty-doc {
  width: 120rpx;
  height: 140rpx;
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.doc-line {
  height: 8rpx;
  background: #EAECF0;
  border-radius: 4rpx;
}

.doc-line.short {
  width: 60%;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2B1D18;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 40rpx;
}

.empty-actions {
  margin-top: 10rpx;
}

.empty-btn {
  padding: 18rpx 48rpx;
  background: linear-gradient(135deg, #C0553D, #3D5FD9);
  color: white;
  font-size: 26rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(91, 127, 255, 0.3);
}

.empty-btn:active {
  opacity: 0.8;
}

/* ===== 底部工具栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: white;
  border-top: 1rpx solid #EAECF0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.bottom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 24rpx;
}

.bottom-btn:active {
  opacity: 0.6;
}

.bottom-icon {
  width: 36rpx;
  height: 36rpx;
}

.bottom-label {
  font-size: 20rpx;
  color: #6B7280;
}
