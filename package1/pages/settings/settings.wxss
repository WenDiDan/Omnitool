/* 基础样式 */
.setting-item {
  padding: 6rpx 0;
}

.setting-label {
  font-size: 28rpx;
  color: #0D1B2A;
}

.setting-value {
  font-size: 26rpx;
  color: #3D8B7A;
}

/* 自定义规则卡片 */
.rules-card {
  margin-top: 16rpx;
}

.card-header {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rule-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0D1B2A;
}

.add-btn {
  font-size: 26rpx;
  color: #fff;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #3D8B7A, #2D7A6A);
  border-radius: 20rpx;
  font-weight: 500;
}

/* 编辑表单样式 */
.rule-form {
  background: linear-gradient(180deg, #f8f9fa 0%, #fff 100%);
  border-radius: 14rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  border: 1rpx solid #e8f5f3;
}

.form-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e8f5f3;
}

.form-icon {
  font-size: 32rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #0D1B2A;
}

.form-section {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #eee;
}

.form-section:last-of-type {
  border-bottom: none;
}

.section-title {
  font-size: 24rpx;
  color: #3D8B7A;
  font-weight: 600;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.section-title::before {
  content: '';
  width: 4rpx;
  height: 24rpx;
  background: #3D8B7A;
  border-radius: 2rpx;
}

.form-item {
  margin-bottom: 16rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.form-input {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: #3D8B7A;
}

.regex-input {
  font-family: 'Courier New', monospace;
  letter-spacing: 2rpx;
}

.form-hint {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.flex-row-center {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.form-hint-inline {
  font-size: 20rpx;
  color: #3D8B7A;
}

.position-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.position-item {
  flex: 1;
}

.position-label {
  font-size: 20rpx;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
}

.position-input {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  text-align: center;
}

.range-separator {
  color: #999;
  font-size: 24rpx;
  margin-top: 20rpx;
}

.form-picker {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: #999;
  font-size: 20rpx;
}

/* 日期位置样式 */
.date-pos-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.date-pos-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.date-pos-icon {
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.year-icon {
  background: #FFF3E0;
  color: #F57C00;
}

.month-icon {
  background: #E8F5E9;
  color: #388E3C;
}

.day-icon {
  background: #E3F2FD;
  color: #1976D2;
}

.date-pos-input {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 12rpx;
  font-size: 26rpx;
  text-align: center;
  width: 100%;
}

/* 表单操作按钮 */
.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.cancel-btn {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  padding: 18rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  text-align: center;
}

.save-btn {
  flex: 2;
  font-size: 26rpx;
  color: #fff;
  padding: 18rpx;
  background: linear-gradient(135deg, #3D8B7A, #2D7A6A);
  border-radius: 10rpx;
  text-align: center;
  font-weight: 600;
}

/* 空状态 */
.empty-rules {
  padding: 40rpx 32rpx;
  text-align: center;
  background: #fafafa;
  border-radius: 10rpx;
  margin: 16rpx 0;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 14rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #999;
}

/* 规则列表 */
.rule-list {
  margin: 16rpx 0;
}

.rule-item {
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}

.rule-item:active {
  background: #f8f9fa;
}

.rule-item.disabled {
  opacity: 0.6;
}

.rule-main,
.rule-content {
  flex: 1;
}

.rule-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.rule-name {
  font-size: 28rpx;
  color: #0D1B2A;
  font-weight: 600;
}

.rule-badge {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: #ccc;
  color: #fff;
}

.rule-badge.active {
  background: #3D8B7A;
}

.rule-details {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.rule-pattern {
  font-size: 22rpx;
  color: #3D8B7A;
  font-family: 'Courier New', monospace;
  background: #e8f5f3;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
}

.rule-separator {
  color: #ddd;
}

.rule-label {
  font-size: 22rpx;
  color: #666;
}

.rule-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.rule-tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}

.date-tag {
  background: #FFF3E0;
  color: #E65100;
}

.length-tag {
  background: #E3F2FD;
  color: #1565C0;
}

.rule-toggle {
  margin-left: 20rpx;
}

.rule-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 20rpx;
}

.rule-delete-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.rule-delete-btn:active {
  background: #fff0f0;
  transform: scale(0.95);
}

/* 删除规则按钮（表单内） */
.delete-rule-btn {
  background: #fff0f0;
  color: #cf1322;
  border: 2rpx solid #ffa39e;
}

.delete-rule-btn:active {
  background: #ffccc7;
}

/* 预设规则 */
.rule-presets {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e0e0e0;
}

.preset-header {
  margin-bottom: 14rpx;
}

.preset-title {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.preset-hint {
  font-size: 20rpx;
  color: #999;
}

.preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.preset-item {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 18rpx 12rpx;
  text-align: center;
  border: 1rpx solid #e8f5f3;
  transition: all 0.2s;
}

.preset-item:active {
  background: #e8f5f3;
  transform: scale(0.98);
}

.preset-icon {
  font-size: 32rpx;
  display: block;
  margin-bottom: 6rpx;
}

.preset-name {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
}

/* 日期代码对照表 */
.date-code-helper {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.helper-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.toggle-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.toggle-icon {
  font-size: 28rpx;
}

.toggle-title {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
}

.toggle-arrow {
  font-size: 22rpx;
  color: #3D8B7A;
}

.helper-content {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 18rpx;
  margin-top: 12rpx;
}

.mapping-info {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #ddd;
}

.info-item {
  flex: 1;
  background: #fff;
  border-radius: 8rpx;
  padding: 12rpx;
}

.info-label {
  font-size: 22rpx;
  color: #3D8B7A;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.info-desc {
  font-size: 18rpx;
  color: #666;
  display: block;
  margin-bottom: 4rpx;
}

.mapping-section {
  margin-bottom: 16rpx;
}

.mapping-title {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.mapping-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 6rpx;
}

.mapping-grid.small {
  grid-template-columns: repeat(3, 1fr);
}

.mapping-grid.day-grid {
  grid-template-columns: repeat(6, 1fr);
}

.mapping-item {
  background: #fff;
  border-radius: 6rpx;
  padding: 8rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #e8f5f3;
}

.mapping-letter {
  font-size: 22rpx;
  color: #0D1B2A;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  margin-bottom: 4rpx;
}

.mapping-input {
  width: 44rpx;
  height: 30rpx;
  border: 1rpx solid #ddd;
  border-radius: 4rpx;
  text-align: center;
  font-size: 18rpx;
  background: #fafafa;
}

.mapping-note {
  font-size: 18rpx;
  color: #999;
  font-style: italic;
  margin-top: 8rpx;
  display: block;
}

.base-year {
  background: #fff;
  border-radius: 8rpx;
  padding: 12rpx;
}

.base-year-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.base-year-input {
  width: 120rpx;
  height: 52rpx;
  border: 2rpx solid #3D8B7A;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  background: #e8f5f3;
}

.base-year-hint {
  font-size: 20rpx;
  color: #999;
  flex: 1;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #f0f0f0;
}

/* 工具类 */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 测试区域样式 */
.test-section {
  background: linear-gradient(135deg, #f8fafc 0%, #e8f5f3 100%);
  border-radius: 14rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  border: 1rpx solid #3D8B7A20;
}

.test-input-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.test-input {
  flex: 1;
  height: 60rpx;
  background: #fff;
  border: 2rpx solid #3D8B7A30;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.test-input:focus {
  border-color: #3D8B7A;
  background: #fff;
}

.test-buttons {
  display: flex;
  gap: 6rpx;
}

.test-btn {
  height: 60rpx;
  padding: 0 22rpx;
  background: #fff;
  border: 2rpx solid #3D8B7A;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #3D8B7A;
  display: flex;
  align-items: center;
  justify-content: center;
}

.test-btn.primary {
  background: #3D8B7A;
  color: #fff;
}

.test-btn:active {
  opacity: 0.8;
}

.test-result {
  background: #fff;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-top: 10rpx;
  border-left: 4rpx solid #3D8B7A;
}

.test-result-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.test-result-value {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.result-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #0D1B2A;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.result-raw {
  font-size: 20rpx;
  color: #999;
}

.test-result-badge {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.test-error {
  background: #fff0f0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin-top: 10rpx;
  border-left: 4rpx solid #ff4d4f;
}

.test-error text {
  font-size: 22rpx;
  color: #cf1322;
}

/* 测试提示 */
.test-hint {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 16rpx;
  background: #f0f9f8;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.hint-icon {
  font-size: 22rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #3D8B7A;
}

/* 测试步骤 */
.test-steps {
  background: #fff;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e8f5f3;
}

.steps-title {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx dashed #e0e0e0;
}

.steps-icon {
  font-size: 24rpx;
}

.steps-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.step-item {
  padding: 12rpx;
  margin-bottom: 10rpx;
  background: #fafbfc;
  border-radius: 8rpx;
  border-left: 3rpx solid #ddd;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-item.success {
  border-left-color: #52c41a;
  background: #f6ffed;
}

.step-item.error {
  border-left-color: #ff4d4f;
  background: #fff2f0;
}

.step-item.pending {
  border-left-color: #faad14;
  background: #fffbe6;
}

.step-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.step-num {
  width: 30rpx;
  height: 30rpx;
  background: #3D8B7A;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.step-name {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.step-status-icon {
  font-size: 24rpx;
  font-weight: bold;
}

.step-item.success .step-status-icon {
  color: #52c41a;
}

.step-item.error .step-status-icon {
  color: #ff4d4f;
}

.step-item.pending .step-status-icon {
  color: #faad14;
}

.step-detail {
  display: flex;
  padding: 6rpx 0;
  font-size: 22rpx;
  line-height: 1.4;
}

.step-label {
  color: #666;
  min-width: 50rpx;
}

.step-value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

.step-value.highlight {
  color: #3D8B7A;
  font-weight: 600;
}

.step-error {
  font-size: 20rpx;
  color: #ff4d4f;
  padding-top: 6rpx;
}

/* 最终结果 */
.test-result {
  background: linear-gradient(135deg, #fff 0%, #f0fdfb 100%);
  border-radius: 14rpx;
  padding: 18rpx;
  border: 2rpx solid #3D8B7A30;
}

.result-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx dashed #3D8B7A40;
}

.result-icon {
  font-size: 28rpx;
}

.result-title {
  font-size: 26rpx;
  color: #3D8B7A;
  font-weight: 600;
}

.result-main-content {
  background: #fff;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(61, 139, 122, 0.1);
}

.result-label-row {
  margin-bottom: 10rpx;
}

.result-label-text {
  font-size: 22rpx;
  color: #666;
}

.result-value-row {
  margin-bottom: 6rpx;
}

.result-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #0D1B2A;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.result-raw {
  font-size: 20rpx;
  color: #999;
  padding-top: 6rpx;
  border-top: 1rpx dashed #eee;
}

.raw-label {
  color: #666;
}

.raw-value {
  font-family: 'Courier New', monospace;
}

.result-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.result-badge {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.success-badge {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.date-badge {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffd591;
}

.length-badge {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

/* 无匹配 */
.test-no-match {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx;
  background: #fff7e6;
  border-radius: 10rpx;
  border-left: 4rpx solid #fa8c16;
  margin-top: 10rpx;
}

.no-match-icon {
  font-size: 26rpx;
}

.no-match-text {
  font-size: 24rpx;
  color: #d46b08;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 1000;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-container {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 92%;
  max-height: 88vh;
  z-index: 1001;
  animation: modalSlideIn 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translate(-50%, -48%) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 88vh;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.18), 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.modal-header {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #3D8B7A 0%, #4a9e8e 50%, #5ab09e 100%);
  color: #fff;
  position: relative;
}

.modal-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 24rpx;
  right: 24rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.15);
}

.modal-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.modal-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  transition: all 0.2s ease;
}

.modal-close:active {
  opacity: 0.6;
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.25);
}

.modal-body {
  flex: 1;
  max-height: 62vh;
  padding: 0;
}

/* 优化表单样式 */
.modal-body .form-section {
  padding: 22rpx 24rpx;
  background: #fff;
  border-bottom: 12rpx solid #f8f9fa;
}

.modal-body .form-section:last-child {
  border-bottom: none;
}

.modal-body .form-section .section-title {
  font-size: 26rpx;
  color: #3D8B7A;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #3D8B7A;
}

.modal-body .form-item {
  margin-bottom: 18rpx;
}

.modal-body .form-item:last-child {
  margin-bottom: 0;
}

.modal-body .form-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.modal-body .form-input {
  height: 68rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.modal-body .form-input:focus {
  border-color: #3D8B7A;
  background: #fff;
}

.modal-body .form-hint {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  padding-left: 6rpx;
}

.modal-footer {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #eee;
  background: linear-gradient(180deg, #fafbfc 0%, #f5f6f8 100%);
  position: relative;
}

.modal-footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e5e5e5, transparent);
}

.modal-footer .cancel-btn,
.modal-footer .save-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.05);
}

.modal-footer .cancel-btn {
  background: #fff;
  color: #666;
  border: 2rpx solid #e5e5e5;
}

.modal-footer .cancel-btn:active {
  background: #f5f5f5;
  transform: scale(0.98);
}

.modal-footer .save-btn {
  background: linear-gradient(135deg, #3D8B7A 0%, #4a9e8e 100%);
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(61, 139, 122, 0.35);
}

.modal-footer .save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(61, 139, 122, 0.25);
}

.modal-footer .delete-rule-btn {
  flex: 0.6;
  background: linear-gradient(135deg, #fff1f0 0%, #ffe8e6 100%);
  color: #ff6b6b;
  border: none;
  box-shadow: 0 3rpx 10rpx rgba(255, 107, 107, 0.15);
}

.modal-footer .delete-rule-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #ffe0df 0%, #ffd4d2 100%);
}
