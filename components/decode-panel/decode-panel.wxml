<view class="decode-page">
  <!-- 统计看板 -->
  <view class="stats-section">
    <view class="stats-header" bindtap="toggleStats">
      <view class="stats-title-area">
        <view class="stats-dot"></view>
        <text class="stats-title">扫码统计</text>
        <text class="stats-sub">今日 {{statsToday}} 次</text>
      </view>
      <text class="stats-toggle">{{showStats ? '收起' : '展开'}}</text>
    </view>
    <view class="stats-body" wx:if="{{showStats}}">
      <!-- 数字卡片 -->
      <view class="stats-cards">
        <view class="stats-card">
          <text class="stats-card-num">{{statsToday}}</text>
          <text class="stats-card-label">今日扫码</text>
        </view>
        <view class="stats-card">
          <text class="stats-card-num">{{statsWeek}}</text>
          <text class="stats-card-label">本周扫码</text>
        </view>
      </view>
      <!-- TOP 类型 -->
      <view class="stats-types" wx:if="{{statsTopTypes.length > 0}}">
        <text class="stats-types-title">最常类型</text>
        <view class="stats-types-list">
          <view class="stats-type-tag" wx:for="{{statsTopTypes}}" wx:key="type">
            <text class="stats-type-name">{{item.type}}</text>
            <text class="stats-type-count">{{item.count}}</text>
          </view>
        </view>
      </view>
      <!-- 7日趋势图 -->
      <view class="stats-trend">
        <text class="stats-trend-title">7日趋势</text>
        <canvas type="2d" id="trendCanvas" class="stats-trend-canvas"></canvas>
      </view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-section">
    <view class="input-header">
      <text class="input-title">输入内容</text>
      <view class="input-actions">
        <text class="input-action" bindtap="pasteFromClipboard">粘贴</text>
        <text class="input-action" wx:if="{{inputCode}}" bindtap="clearInput">清空</text>
      </view>
    </view>
    <view class="input-box">
      <textarea
        class="code-textarea"
        placeholder="输入条码、网址、WiFi信息、vCard等内容"
        value="{{inputCode}}"
        bindinput="onInput"
        maxlength="-1"
        auto-height
      />
      <view class="type-badge" wx:if="{{detectType}}">
        <text class="type-badge-text">{{detectType}}</text>
      </view>
    </view>
    <view class="decode-btn-area">
      <view class="decode-btn" bindtap="decode">
        <image class="decode-btn-icon" src="/images/icon_scan.png" mode="aspectFit"/>
        <text class="decode-btn-text">解码分析</text>
      </view>
    </view>
  </view>

  <!-- 解码结果 -->
  <view class="result-section" wx:if="{{decodedResult}}">
    <!-- 类型识别卡 -->
    <view class="type-card">
      <view class="type-card-left">
        <view class="type-icon-box {{typeIconClass}}">
          <text class="type-icon-text">{{typeIconLabel}}</text>
        </view>
        <view class="type-info">
          <text class="type-name">{{decodedResult.type}}</text>
          <text class="type-data" selectable>{{decodedResult.data}}</text>
        </view>
      </view>
      <view class="type-status" wx:if="{{decodedResult.valid !== undefined}}">
        <text class="status-{{decodedResult.valid ? 'valid' : 'invalid'}}">{{decodedResult.valid ? '有效' : '无效'}}</text>
      </view>
    </view>

    <!-- 解码详情 -->
    <view class="detail-card" wx:if="{{hasDetails}}">
      <text class="detail-card-title">解析详情</text>

      <!-- EAN/ISBN -->
      <block wx:if="{{decodedResult.country}}">
        <view class="detail-row">
          <text class="detail-label">国家/地区</text>
          <text class="detail-value">{{decodedResult.country}}</text>
        </view>
      </block>
      <block wx:if="{{decodedResult.isbn}}">
        <view class="detail-row">
          <text class="detail-label">ISBN</text>
          <text class="detail-value">{{decodedResult.isbn}}</text>
        </view>
      </block>
      <block wx:if="{{decodedResult.manufacturerCode}}">
        <view class="detail-row">
          <text class="detail-label">厂商代码</text>
          <text class="detail-value">{{decodedResult.manufacturerCode}}</text>
        </view>
      </block>
      <block wx:if="{{decodedResult.productCode}}">
        <view class="detail-row">
          <text class="detail-label">产品代码</text>
          <text class="detail-value">{{decodedResult.productCode}}</text>
        </view>
      </block>
      <block wx:if="{{decodedResult.checkDigit}}">
        <view class="detail-row">
          <text class="detail-label">校验位</text>
          <text class="detail-value">{{decodedResult.checkDigit}}</text>
        </view>
      </block>

      <!-- URL -->
      <block wx:if="{{decodedResult.domain}}">
        <view class="detail-row">
          <text class="detail-label">域名</text>
          <text class="detail-value detail-link" bindtap="openUrl">{{decodedResult.domain}}</text>
        </view>
      </block>

      <!-- WiFi -->
      <block wx:if="{{decodedResult.ssid}}">
        <view class="detail-row">
          <text class="detail-label">网络名称</text>
          <text class="detail-value">{{decodedResult.ssid}}</text>
        </view>
        <view class="detail-row" wx:if="{{decodedResult.encryption}}">
          <text class="detail-label">加密方式</text>
          <text class="detail-value">{{decodedResult.encryption}}</text>
        </view>
        <view class="detail-row" wx:if="{{decodedResult.password}}">
          <text class="detail-label">密码</text>
          <text class="detail-value">{{decodedResult.password}}</text>
          <text class="detail-copy-btn" bindtap="copyWifiPassword">复制</text>
        </view>
      </block>

      <!-- vCard -->
      <block wx:if="{{decodedResult.vcardName}}">
        <view class="detail-row">
          <text class="detail-label">姓名</text>
          <text class="detail-value">{{decodedResult.vcardName}}</text>
        </view>
      </block>
      <block wx:if="{{decodedResult.vcardPhone}}">
        <view class="detail-row">
          <text class="detail-label">电话</text>
          <text class="detail-value">{{decodedResult.vcardPhone}}</text>
        </view>
      </block>
      <block wx:if="{{decodedResult.vcardEmail}}">
        <view class="detail-row">
          <text class="detail-label">邮箱</text>
          <text class="detail-value">{{decodedResult.vcardEmail}}</text>
        </view>
      </block>
      <block wx:if="{{decodedResult.vcardOrg}}">
        <view class="detail-row">
          <text class="detail-label">公司</text>
          <text class="detail-value">{{decodedResult.vcardOrg}}</text>
        </view>
      </block>

      <!-- 邮箱 -->
      <block wx:if="{{decodedResult.email}}">
        <view class="detail-row">
          <text class="detail-label">邮箱地址</text>
          <text class="detail-value">{{decodedResult.email}}</text>
        </view>
      </block>

      <!-- 电话 -->
      <block wx:if="{{decodedResult.phone}}">
        <view class="detail-row">
          <text class="detail-label">电话号码</text>
          <text class="detail-value">{{decodedResult.phone}}</text>
        </view>
      </block>

      <!-- 短信 -->
      <block wx:if="{{decodedResult.smsPhone}}">
        <view class="detail-row">
          <text class="detail-label">收信号码</text>
          <text class="detail-value">{{decodedResult.smsPhone}}</text>
        </view>
        <view class="detail-row" wx:if="{{decodedResult.smsBody}}">
          <text class="detail-label">短信内容</text>
          <text class="detail-value">{{decodedResult.smsBody}}</text>
        </view>
      </block>
    </view>

    <!-- 编码转换 -->
    <view class="encode-card">
      <view class="encode-header" bindtap="toggleEncodeTools">
        <text class="encode-title">编码转换</text>
        <text class="encode-toggle">{{showEncodeTools ? '收起' : '展开'}}</text>
      </view>
      <view class="encode-body" wx:if="{{showEncodeTools}}">
        <block wx:for="{{encodeList}}" wx:key="key">
          <view class="encode-row" wx:if="{{item.value}}">
            <text class="encode-label">{{item.label}}</text>
            <text class="encode-value" selectable>{{item.value}}</text>
            <text class="encode-copy" bindtap="copyEncodeResult" data-key="{{item.key}}">复制</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="action-section">
      <text class="action-title">快捷操作</text>
      <view class="action-grid">
        <view class="action-btn" bindtap="copyResult">
          <image class="action-icon" src="/images/icon_album_white.png" mode="aspectFit"/>
          <text>复制</text>
        </view>
        <view class="action-btn" wx:if="{{decodedResult.domain}}" bindtap="openUrl">
          <image class="action-icon" src="/images/icon_info.png" mode="aspectFit"/>
          <text>打开</text>
        </view>
        <view class="action-btn" wx:if="{{decodedResult.password}}" bindtap="copyWifiPassword">
          <image class="action-icon" src="/images/icon_edit_white.png" mode="aspectFit"/>
          <text>复制密码</text>
        </view>
        <view class="action-btn" wx:if="{{decodedResult.phone || detectType === '电话'}}" bindtap="callPhone">
          <image class="action-icon" src="/images/icon_device.png" mode="aspectFit"/>
          <text>拨打</text>
        </view>
        <view class="action-btn" wx:if="{{decodedResult.email}}" bindtap="copyEmail">
          <image class="action-icon" src="/images/icon_info.png" mode="aspectFit"/>
          <text>复制邮箱</text>
        </view>
        <view class="action-btn" wx:if="{{decodedResult.vcardName}}" bindtap="saveContact">
          <image class="action-icon" src="/images/icon_user_white.png" mode="aspectFit"/>
          <text>保存联系人</text>
        </view>
        <view class="action-btn" bindtap="generateQrCode">
          <image class="action-icon" src="/images/icon_scan_white.png" mode="aspectFit"/>
          <text>生成二维码</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 二维码弹窗 -->
  <view class="qr-modal" wx:if="{{showQrCode}}" bindtap="closeQrCode">
    <view class="qr-modal-content" catchtap="">
      <text class="qr-modal-title">二维码已生成</text>
      <image class="qr-modal-image" src="{{qrImagePath}}" mode="widthFix"/>
      <text class="qr-modal-hint">长按图片可保存，或点击下方按钮</text>
      <view class="qr-modal-actions">
        <view class="qr-modal-btn" bindtap="saveQrCode">保存到相册</view>
        <view class="qr-modal-btn qr-modal-btn-outline" bindtap="closeQrCode">关闭</view>
      </view>
    </view>
  </view>

  <!-- 隐藏的 Canvas -->
  <canvas type="2d" id="qrCanvas" style="width:200px;height:200px;position:fixed;left:-9999px;top:-9999px;"></canvas>


  <!-- 资料设置弹窗 -->
  <view class="modal-mask" wx:if="{{showProfileModal}}" catchtap="skipProfile">
    <view class="modal-box" catchtap="stopTap">
      <view class="modal-header">
        <view class="modal-accent-bar"></view>
        <text class="modal-title">{{isFirstLogin ? '设置头像昵称' : '编辑资料'}}</text>
      </view>
      <view class="profile-edit-tip" wx:if="{{isFirstLogin}}">
        <text class="profile-tip-text">获取微信头像和昵称，提升个性化体验</text>
      </view>
      <view class="profile-edit-row">
        <text class="profile-edit-label">头像</text>
        <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onEditChooseAvatar">
          <image class="profile-avatar-preview" src="{{editAvatarUrl || '/images/icon_user_white.png'}}" mode="aspectFill"/>
          <text class="profile-avatar-hint">{{editAvatarUrl ? '更换' : '选择头像'}}</text>
        </button>
      </view>
      <view class="profile-edit-row">
        <text class="profile-edit-label">昵称</text>
        <input class="profile-nick-input" type="nickname" value="{{editNickName}}" placeholder="点击此处获取微信昵称" bindinput="onEditNickInput"/>
      </view>
      <view class="modal-btns">
        <view class="modal-btn modal-cancel" bindtap="skipProfile">跳过</view>
        <view class="modal-btn modal-confirm" bindtap="confirmProfile">保存</view>
      </view>
    </view>
  </view>
</view>
